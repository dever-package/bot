{
  "name": "@zufang/bot-front",
  "private": true,
  "type": "module",
  "dever": {
    "bundle": "split",
    "bundleBudget": {
      "maxJs": 80,
      "maxCss": 22,
      "maxDynamicEntries": 45,
      "tinyJsBytes": 2048,
      "maxTinyJs": 12,
      "allowTinyEntryNames": [
        "runtime-entry"
      ],
      "roots": {
        "space-page": {
          "facadeSuffix": "/nodes/body-work/space/space-page.tsx",
          "maxJs": 20,
          "maxCss": 4,
          "maxBytes": 1153434,
          "forbid": [
            "markdown-live-editor",
            "code-editor",
            "knowledge-file-manager",
            "agent-chat"
          ]
        }
      }
    }
  },
  "dependencies": {
    "@assistant-ui/react": "0.14.26",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@uiw/react-codemirror": "^4.25.10",
    "@xyflow/react": "^12.8.4",
    "react-complex-tree": "^2.6.1",
    "vditor": "^3.11.2"
  }
}
