{
  "page": {
    "name": "智能体分类",
    "parent": "bot/agent/agent/list",
    "type": 2,
    "sort": 9
  },
  "layout": {
    "type": "container",
    "children": {
      "page-main": {
        "type": "main",
        "className": "p-0",
        "children": {
          "dialog-shell": {
            "type": "container",
            "className": "w-full"
          }
        }
      }
    }
  },
  "nodes": {
    "dialog-shell": [
      {
        "type": "form-input",
        "placeholder": "例如：小说智能体",
        "value": "form.name",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "分类名称不能为空。"
          }
        ]
      },
      {
        "type": "form-textarea",
        "name": "公共提示词",
        "placeholder": "可留空。填写该分类下所有智能体共同遵守的提示词。",
        "value": "form.prompt",
        "mode": "form",
        "info": "运行时直接读取当前内容，修改后会立即影响该分类下的智能体，不会复制到智能体记录。",
        "meta": {
          "rows": 10
        }
      }
    ]
  },
  "data": {
    "form": {
      "id": 0,
      "name": "",
      "prompt": ""
    }
  },
  "state": {},
  "action": {
    "submit": {
      "type": "save",
      "params": "form",
      "before": {
        "service": "bot.agent.setting.AgentHook.BeforeSaveAgentCate"
      }
    }
  }
}
