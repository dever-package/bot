{
  "page": {
    "name": "编辑技能",
    "parent": "bot/agent/skill_pack/list",
    "type": 2,
    "sort": 10,
    "auth": [
      {
        "key": "bot/agent/skill/update",
        "name": "编辑技能",
        "query": {
          "id": "required"
        }
      }
    ]
  },
  "layout": {
    "type": "container",
    "children": {
      "page-main": {
        "type": "main",
        "className": "p-0",
        "children": {
          "dialog-shell": {
            "type": "container",
            "className": "w-full"
          }
        }
      }
    }
  },
  "nodes": {
    "dialog-shell": [
      {
        "type": "form-select",
        "name": "技能分类",
        "value": "form.cate_id",
        "mode": "form",
        "option": {
          "model": "bot.agent.NewSkillCateModel",
          "filters": {
            "status": 1
          },
          "order": "sort asc,id asc"
        },
        "validate": [
          {
            "type": "required",
            "message": "技能分类不能为空。"
          }
        ],
        "meta": {
          "formLayout": "horizontal",
          "controlClassName": "max-w-[260px]",
          "assistant": false,
          "createOption": {
            "name": "新增分类",
            "pageRoute": "/bot/agent/skill_cate/update",
            "description": "新增后可直接作为当前技能的分类。",
            "size": "sm",
            "bodyClassName": "py-2",
            "selectCreated": true
          }
        }
      },
      {
        "type": "form-input",
        "name": "展示标题",
        "value": "form.display_name",
        "mode": "form",
        "placeholder": "留空时使用技能名称",
        "meta": {
          "formLayout": "horizontal"
        }
      },
      {
        "type": "form-icon",
        "name": "展示图标",
        "value": "form.display_icon",
        "mode": "form",
        "placeholder": "请选择图标，可留空",
        "meta": {
          "formLayout": "horizontal"
        }
      },
      {
        "type": "form-textarea",
        "name": "展示描述",
        "value": "form.display_description",
        "mode": "form",
        "placeholder": "用于界面展示，可留空；留空时不显示描述",
        "info": "仅用于界面展示；留空时保持为空，不使用技能原描述。",
        "meta": {
          "formLayout": "horizontal",
          "rows": 4
        }
      }
    ]
  },
  "data": {
    "form": {
      "id": 0,
      "_partial": true,
      "cate_id": 1,
      "display_name": "",
      "display_icon": "",
      "display_description": ""
    }
  },
  "state": {},
  "action": {
    "submit": {
      "type": "save",
      "params": "form",
      "data": {
        "id": "$form.id",
        "_partial": true,
        "cate_id": "$form.cate_id",
        "display_name": "$form.display_name",
        "display_icon": "$form.display_icon",
        "display_description": "$form.display_description"
      },
      "before": {
        "service": "bot.agent.setting.AgentHook.BeforeSaveSkillDisplay"
      }
    }
  }
}
