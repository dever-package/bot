{
  "page": {
    "name": "来源编辑",
    "parent": "bot/energon/provider/list",
    "sort": 10
  },
  "layout": {
    "type": "container",
    "children": {
      "page-main": {
        "type": "main",
        "className": "p-0",
        "children": {
          "dialog-shell": {
            "type": "container",
            "className": "w-full",
            "children": {
              "provider-account-page": {
                "type": "container",
                "path": "/bot/energon/account/list",
                "className": "mt-5"
              }
            }
          }
        }
      }
    }
  },
  "nodes": {
    "dialog-shell": [
      {
        "type": "form-select",
        "value": "form.cate_id",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "来源分类不能为空。"
          }
        ]
      },
      {
        "type": "form-input",
        "value": "form.name",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "名称不能为空。"
          }
        ]
      },
      {
        "id": "provider-protocol",
        "type": "form-radio",
        "value": "form.protocol",
        "mode": "form",
        "meta": {
          "clearOnChange": ["form.protocol_option"]
        }
      },
      {
        "id": "provider-protocol-option",
        "type": "form-select",
        "name": "本地处理器",
        "placeholder": "请选择本地处理器",
        "value": "form.protocol_option",
        "mode": "form",
        "option": {
          "service": "bot.energon.LocalProcessorService.LoadOptions"
        },
        "validate": [
          {
            "type": "required",
            "message": "本地来源必须选择处理器。",
            "when": [
              {
                "path": "form.protocol",
                "operator": "equals",
                "value": "local"
              }
            ]
          }
        ],
        "info": "服务、接口和参数由处理器自动提供，无需手工维护。",
        "meta": {
          "hiddenWhen": [
            {
              "path": "form.protocol",
              "operator": "notEquals",
              "value": "local"
            }
          ]
        }
      },
      {
        "id": "provider-webcontent-platform",
        "type": "form-select",
        "name": "自媒体平台",
        "placeholder": "请选择自媒体平台",
        "value": "form.protocol_option",
        "mode": "form",
        "option": [
          {
            "id": "wechat",
            "value": "微信公众号"
          },
          {
            "id": "douyin",
            "value": "抖音"
          }
        ],
        "validate": [
          {
            "type": "required",
            "message": "自媒体来源必须选择平台。",
            "when": [
              {
                "path": "form.protocol",
                "operator": "equals",
                "value": "webcontent"
              }
            ]
          }
        ],
        "info": "服务和解析参数由内置解析器自动维护。",
        "meta": {
          "hiddenWhen": [
            {
              "path": "form.protocol",
              "operator": "notEquals",
              "value": "webcontent"
            }
          ]
        }
      },
      {
        "id": "provider-host",
        "type": "form-input",
        "value": "form.host",
        "mode": "form",
        "meta": {
          "showWhen": [
            {
              "path": "form.protocol",
              "operator": "notEquals",
              "value": "local"
            },
            {
              "path": "form.protocol",
              "operator": "notEquals",
              "value": "webcontent"
            }
          ]
        }
      }
    ]
  },
  "data": {
    "form": {
      "_fields": [
        "cate_id",
        "name",
        "protocol",
        "protocol_option",
        "host",
        "accounts"
      ],
      "cate_id": 1,
      "protocol": "openai",
      "protocol_option": "",
      "accounts": []
    }
  },
  "state": {},
  "action": {
    "submit": {
      "type": "save",
      "params": "form",
      "before": {
        "service": "bot.energon.hook.ProviderHook.BeforeSaveProvider"
      },
      "after": {
        "service": "bot.energon.hook.ProviderHook.AfterSaveProvider"
      }
    }
  }
}
