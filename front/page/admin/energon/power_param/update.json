{
  "page": {
    "name": "能力参数编辑",
    "parent": "bot/energon/power/list",
    "type": 2,
    "sort": 10
  },
  "layout": {
    "type": "container",
    "children": {
      "page-main": {
        "type": "main",
        "className": "p-0",
        "children": {
          "dialog-shell": {
            "type": "container",
            "className": "w-full"
          }
        }
      }
    }
  },
  "nodes": {
    "dialog-shell": [
      {
        "type": "form-cascader",
        "value": "form.param_id",
        "mode": "form",
        "placeholder": "请选择参数",
        "validate": [
          {
            "type": "required",
            "message": "内部参数不能为空。"
          }
        ],
        "meta": {
          "childParentField": "cate_id",
          "valueMode": "leaf",
          "placeholder": [
            "选择参数分类",
            "选择参数"
          ],
          "childExtraFields": "type,key",
          "model": "bot.energon.NewParamCateModel",
          "childModel": "bot.energon.NewParamModel"
        }
      },
      {
        "type": "form-switch",
        "name": "展示",
        "value": "form.show",
        "mode": "form",
        "info": "配置了服务参数时，仅展示该来源映射或用作条件控制的参数，不受必填开关影响。未配置服务参数时，开启展示通用参数，关闭按来源展示。",
        "meta": {
          "trueValue": 1,
          "falseValue": 2
        }
      },
      {
        "type": "form-switch",
        "name": "必填",
        "value": "form.status",
        "mode": "form",
        "info": "仅对当前来源支持的参数生效；开启时必须填写或使用默认值，关闭时允许不填。",
        "meta": {
          "trueValue": 1,
          "falseValue": 2
        }
      }
    ]
  },
  "data": {
    "form": {
      "show": 1,
      "status": 1
    }
  },
  "state": {},
  "action": {
    "submit": {
      "type": "save",
      "params": "form"
    }
  }
}
