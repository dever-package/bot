{
  "page": {
    "name": "调用记录",
    "icon": "list-checks",
    "parent": "bot-energon",
    "sort": 4
  },
  "layout": {
    "type": "container",
    "children": {
      "page-header": {
        "type": "header"
      },
      "page-main": {
        "type": "main",
        "className": "flex flex-1 flex-col gap-5 sm:gap-6",
        "children": {
          "record-tabs": {
            "type": "container"
          },
          "record-page": {
            "type": "container",
            "path": "state.recordPage",
            "meta": {
              "updateDocumentTitle": false
            }
          }
        }
      }
    }
  },
  "nodes": {
    "page-header": [
      {
        "type": "show-title",
        "value": "page",
        "className": "min-w-0 flex-1"
      }
    ],
    "record-tabs": [
      {
        "type": "nav-tab",
        "meta": {
          "target": "state.recordPage",
          "variant": "line",
          "tabs": [
            {
              "label": "运行日志",
              "value": "runtime",
              "targetValue": "/bot/energon/log/runtime_list",
              "action": "showRuntime"
            },
            {
              "label": "成本明细",
              "value": "cost",
              "targetValue": "/bot/energon/cost/list",
              "action": "showCost"
            }
          ]
        }
      }
    ]
  },
  "data": {
    "page": {
      "description": "统一查看能力调用的运行过程与供应商成本；用户扣费仍在计费记录中独立核算。"
    }
  },
  "state": {
    "recordPage": "/bot/energon/log/runtime_list"
  },
  "action": {
    "showRuntime": {
      "type": "page",
      "target": "state.recordPage",
      "value": "/bot/energon/log/runtime_list"
    },
    "showCost": {
      "type": "page",
      "target": "state.recordPage",
      "value": "/bot/energon/cost/list"
    }
  }
}
