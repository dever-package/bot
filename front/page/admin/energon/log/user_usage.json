{
  "page": {
    "name": "用户统计",
    "parent": "bot/energon/log/list",
    "type": 2,
    "sort": 3
  },
  "layout": {
    "type": "container",
    "children": {
      "page-main": {
        "type": "main",
        "className": "flex flex-1 flex-col gap-5 p-0 sm:gap-6",
        "children": {
          "toolbar-row": {
            "type": "row",
            "className": "flex-wrap items-center gap-3"
          },
          "table-row": {
            "type": "container",
            "className": "overflow-hidden rounded-md border bg-background"
          }
        }
      }
    }
  },
  "nodes": {
    "toolbar-row": [
      {
        "type": "form-input",
        "placeholder": "搜索用户名称或账号...",
        "value": "search.keyword",
        "mode": "search"
      },
      {
        "type": "form-select",
        "placeholder": "使用人",
        "value": "search.user_id",
        "mode": "search",
        "option": {
          "service": "user.UserOptionService.LoadUsers",
          "pageSize": 20
        },
        "meta": {
          "searchPlaceholder": "输入用户名称或账号搜索..."
        }
      },
      {
        "type": "form-select",
        "placeholder": "能力",
        "value": "search.power_id",
        "mode": "search",
        "option": {
          "model": "bot.energon.NewPowerModel",
          "labelField": "name",
          "searchFields": [
            "name",
            "key"
          ],
          "pageSize": 20
        },
        "meta": {
          "searchPlaceholder": "输入能力名称或标识搜索..."
        }
      },
      {
        "type": "form-select",
        "placeholder": "调用场景",
        "value": "search.scene",
        "mode": "search",
        "option": {
          "service": "bot.energon.UserUsageService.LoadScenes"
        }
      },
      {
        "type": "form-date",
        "placeholder": "统计时间",
        "value": "search.created_at_start",
        "mode": "search",
        "meta": {
          "searchWidth": "select",
          "range": true,
          "endValue": "search.created_at_end",
          "inputType": "datetime-local"
        }
      },
      {
        "type": "show-button",
        "name": "搜索",
        "meta": {
          "variant": "default",
          "size": "sm",
          "searchSubmit": true,
          "loadingText": "搜索中..."
        }
      },
      {
        "type": "show-button",
        "name": "重置",
        "meta": {
          "variant": "outline",
          "size": "sm",
          "to": "/bot/energon/log/list"
        }
      }
    ],
    "table-row": [
      {
        "type": "show-table",
        "value": "table.list",
        "meta": {
          "pagePath": "data.table.page",
          "pageSizePath": "data.table.pageSize",
          "totalPath": "data.table.total",
          "remote": true,
          "externalPagination": true,
          "rowKey": "id",
          "columns": [
            {
              "name": "使用人",
              "value": "user_name",
              "type": "show-base"
            },
            {
              "name": "用户账号",
              "value": "user_account",
              "type": "show-base"
            },
            {
              "name": "逻辑调用",
              "value": "logical_calls",
              "type": "show-base"
            },
            {
              "name": "成功",
              "value": "success_calls",
              "type": "show-base"
            },
            {
              "name": "失败",
              "value": "failed_calls",
              "type": "show-base"
            },
            {
              "name": "成功率",
              "value": "success_rate",
              "type": "show-base"
            },
            {
              "name": "供应商尝试",
              "value": "provider_attempts",
              "type": "show-base"
            },
            {
              "name": "输入Token",
              "value": "prompt_tokens",
              "type": "show-base"
            },
            {
              "name": "输出Token",
              "value": "completion_tokens",
              "type": "show-base"
            },
            {
              "name": "总Token",
              "value": "total_tokens",
              "type": "show-base"
            },
            {
              "name": "缓存Token",
              "value": "cached_tokens",
              "type": "show-base"
            },
            {
              "name": "供应商成本(CNY)",
              "value": "cost_cny",
              "type": "show-base"
            },
            {
              "name": "实扣积分",
              "value": "settled_points",
              "type": "show-base"
            },
            {
              "name": "最后使用时间",
              "value": "last_used_at",
              "type": "show-date"
            }
          ]
        }
      },
      {
        "type": "show-page"
      }
    ]
  },
  "data": {
    "search": {
      "keyword": "",
      "user_id": "",
      "power_id": "",
      "scene": "",
      "created_at_start": "",
      "created_at_end": ""
    },
    "table": {
      "service": "bot.energon.UserUsageService.LoadUserUsage"
    }
  },
  "state": {},
  "action": {}
}
