{
  "page": {
    "name": "用户",
    "parent": "bot/body/statistics/list",
    "type": 2,
    "sort": 1
  },
  "layout": {
    "type": "container",
    "children": {
      "page-main": {
        "type": "main",
        "className": "flex flex-1 flex-col gap-5 p-0 sm:gap-6",
        "children": {
          "toolbar-row": {
            "type": "row",
            "className": "flex-wrap items-center gap-3"
          },
          "table-row": {
            "type": "container",
            "className": "overflow-hidden rounded-md border bg-background"
          }
        }
      }
    }
  },
  "nodes": {
    "toolbar-row": [
      {
        "type": "form-input",
        "placeholder": "搜索用户名称或账号...",
        "value": "search.keyword",
        "mode": "search"
      },
      {
        "type": "form-select",
        "placeholder": "使用人",
        "value": "search.user_id",
        "mode": "search",
        "option": {
          "service": "user.UserOptionService.LoadUsers",
          "pageSize": 20
        },
        "meta": {
          "searchPlaceholder": "输入用户名称或账号搜索..."
        }
      },
      {
        "type": "form-select",
        "placeholder": "能力",
        "value": "search.power_id",
        "mode": "search",
        "option": {
          "model": "bot.energon.NewPowerModel",
          "labelField": "name",
          "searchFields": ["name", "key"],
          "pageSize": 20
        },
        "meta": {
          "searchPlaceholder": "输入能力名称或标识搜索..."
        }
      },
      {
        "type": "form-select",
        "placeholder": "业务入口",
        "value": "search.body_function_code",
        "mode": "search",
        "option": {
          "service": "bot.energon.UserUsageService.LoadBodyFunctionOptions",
          "valueField": "code",
          "labelField": "name",
          "pageSize": 10
        }
      },
      {
        "type": "form-select",
        "name": "时间范围",
        "placeholder": "统计时间",
        "value": "search.period",
        "mode": "search",
        "option": "option.period",
        "meta": {
          "clearable": false,
          "searchable": false,
          "searchWidth": "select"
        }
      },
      {
        "type": "form-date",
        "placeholder": "自定义时间",
        "value": "search.created_at_start",
        "mode": "search",
        "meta": {
          "searchWidth": "select",
          "range": true,
          "endValue": "search.created_at_end",
          "inputType": "datetime-local",
          "showWhen": [
            {
              "path": "search.period",
              "operator": "equals",
              "value": "custom"
            }
          ]
        }
      },
      {
        "type": "show-button",
        "name": "搜索",
        "meta": {
          "variant": "default",
          "size": "sm",
          "searchSubmit": true,
          "loadingText": "搜索中..."
        }
      },
      {
        "type": "show-button",
        "name": "重置",
        "meta": {
          "variant": "outline",
          "size": "sm",
          "to": "/bot/body/statistics/list"
        }
      },
      {
        "type": "show-text",
        "value": "table.range_label",
        "className": "w-full text-xs sm:ml-auto sm:w-auto sm:whitespace-nowrap"
      }
    ],
    "table-row": [
      {
        "type": "show-table",
        "value": "table.list",
        "meta": {
          "pagePath": "data.table.page",
          "pageSizePath": "data.table.pageSize",
          "totalPath": "data.table.total",
          "remote": true,
          "externalPagination": true,
          "rowKey": "id",
          "columns": [
            {
              "name": "使用人",
              "value": "user_name",
              "type": "show-base"
            },
            {
              "name": "用户账号",
              "value": "user_account",
              "type": "show-base"
            },
            {
              "name": "服务调用次数",
              "value": "logical_calls",
              "type": "show-base"
            },
            {
              "name": "服务成功率",
              "value": "success_rate",
              "type": "show-base"
            },
            {
              "name": "供应商 Token 用量",
              "value": "total_tokens",
              "type": "show-base"
            },
            {
              "name": "供应商成本（CNY）",
              "value": "cost_cny",
              "type": "show-base"
            },
            {
              "name": "实扣积分",
              "value": "settled_points",
              "type": "show-base"
            },
            {
              "name": "最后使用时间",
              "value": "last_used_at",
              "type": "show-date"
            },
            {
              "name": "操作",
              "type": "show-button",
              "className": "w-[1%] whitespace-nowrap px-3 text-center",
              "meta": {
                "align": "right",
                "buttons": [
                  {
                    "name": "作品",
                    "icon": "file-stack",
                    "variant": "outline",
                    "size": "sm",
                    "description": "查看用户作品",
                    "to": "/bot/body/statistics/user_work",
                    "searchParams": {
                      "user_id": "user_id",
                      "user_name": "user_name",
                      "user_account": "user_account",
                      "power_id": "detail_power_id",
                      "created_at_start": "detail_started_at",
                      "created_at_end": "detail_ended_at"
                    },
                    "showWhen": [
                      {
                        "path": "body_function_enabled.works",
                        "operator": "equals",
                        "value": true
                      }
                    ],
                    "withBack": true
                  },
                  {
                    "name": "对话",
                    "icon": "messages-square",
                    "variant": "outline",
                    "size": "sm",
                    "description": "查看智能体对话",
                    "to": "/bot/body/statistics/user_dialogue",
                    "searchParams": {
                      "user_id": "user_id",
                      "user_name": "user_name",
                      "user_account": "user_account",
                      "power_id": "detail_power_id",
                      "created_at_start": "detail_started_at",
                      "created_at_end": "detail_ended_at"
                    },
                    "showWhen": [
                      {
                        "path": "body_function_enabled.dialogue",
                        "operator": "equals",
                        "value": true
                      }
                    ],
                    "withBack": true
                  },
                  {
                    "name": "工具",
                    "icon": "zap",
                    "variant": "outline",
                    "size": "sm",
                    "description": "查看工具历史",
                    "to": "/bot/body/statistics/user_tool",
                    "searchParams": {
                      "user_id": "user_id",
                      "user_name": "user_name",
                      "user_account": "user_account",
                      "power_id": "detail_power_id",
                      "created_at_start": "detail_started_at",
                      "created_at_end": "detail_ended_at"
                    },
                    "showWhen": [
                      {
                        "path": "body_function_enabled.function",
                        "operator": "equals",
                        "value": true
                      }
                    ],
                    "withBack": true
                  },
                  {
                    "name": "资产",
                    "icon": "archive",
                    "variant": "outline",
                    "size": "sm",
                    "description": "查看用户资产",
                    "to": "/bot/body/statistics/user_asset",
                    "searchParams": {
                      "user_id": "user_id",
                      "user_name": "user_name",
                      "user_account": "user_account"
                    },
                    "showWhen": [
                      {
                        "path": "body_function_enabled.assets",
                        "operator": "equals",
                        "value": true
                      }
                    ],
                    "withBack": true
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "type": "show-page"
      }
    ]
  },
  "data": {
    "search": {
      "keyword": "",
      "user_id": "",
      "power_id": "",
      "body_function_code": "",
      "period": "this_month",
      "created_at_start": "",
      "created_at_end": ""
    },
    "option": {
      "period": [
        {
          "id": "today",
          "value": "今日"
        },
        {
          "id": "yesterday",
          "value": "昨日"
        },
        {
          "id": "this_week",
          "value": "本周"
        },
        {
          "id": "last_week",
          "value": "上周"
        },
        {
          "id": "this_month",
          "value": "本月"
        },
        {
          "id": "last_month",
          "value": "上月"
        },
        {
          "id": "this_year",
          "value": "全年"
        },
        {
          "id": "custom",
          "value": "自定义"
        }
      ]
    },
    "table": {
      "service": "bot.energon.UserUsageService.LoadFrontendUserUsage"
    }
  },
  "state": {},
  "action": {}
}
