{
  "page": {
    "name": "日志详情",
    "parent": "bot/energon/log/list",
    "type": 2,
    "sort": 10
  },
  "layout": {
    "type": "container",
    "children": {
      "page-main": {
        "type": "main",
        "className": "flex flex-col gap-4 p-0",
        "children": {
          "basic-card": {
            "type": "container",
            "className": "rounded-lg border bg-background p-4"
          },
          "target-card": {
            "type": "container",
            "className": "rounded-lg border bg-background p-4"
          },
          "attempt-card": {
            "type": "container",
            "className": "rounded-lg border bg-background p-4"
          },
          "detail-card": {
            "type": "container",
            "className": "rounded-lg border bg-background p-4",
            "children": {
              "detail-actions": {
                "type": "row",
                "className": "flex-wrap items-center gap-2"
              }
            }
          },
          "feedback-shell": {
            "type": "container"
          }
        }
      }
    }
  },
  "nodes": {
    "basic-card": [
      {
        "type": "show-title",
        "value": "page.basicTitle",
        "meta": {
          "variant": "section"
        }
      },
      {
        "type": "show-base",
        "value": "form.request_id",
        "mode": "form",
        "meta": {
          "formLayout": "horizontal"
        }
      },
      {
        "type": "show-tag",
        "value": "form.mode",
        "mode": "form",
        "meta": {
          "formLayout": "horizontal"
        }
      },
      {
        "type": "show-tag",
        "value": "form.protocol",
        "mode": "form",
        "meta": {
          "formLayout": "horizontal"
        }
      },
      {
        "type": "show-tag",
        "value": "form.status",
        "mode": "form",
        "meta": {
          "formLayout": "horizontal"
        }
      },
      {
        "type": "show-base",
        "value": "form.latency",
        "mode": "form",
        "meta": {
          "formLayout": "horizontal",
          "format": "duration-ms"
        }
      },
      {
        "type": "show-base",
        "name": "输入Token",
        "value": "form.prompt_tokens",
        "mode": "form",
        "meta": {
          "formLayout": "horizontal"
        }
      },
      {
        "type": "show-base",
        "name": "输出Token",
        "value": "form.completion_tokens",
        "mode": "form",
        "meta": {
          "formLayout": "horizontal"
        }
      },
      {
        "type": "show-base",
        "name": "总Token",
        "value": "form.total_tokens",
        "mode": "form",
        "meta": {
          "formLayout": "horizontal"
        }
      },
      {
        "type": "show-base",
        "name": "缓存Token",
        "value": "form.cached_tokens",
        "mode": "form",
        "meta": {
          "formLayout": "horizontal"
        }
      },
      {
        "type": "show-date",
        "value": "form.created_at",
        "mode": "form",
        "meta": {
          "formLayout": "horizontal",
          "format": "datetime-second"
        }
      }
    ],
    "target-card": [
      {
        "type": "show-title",
        "value": "page.targetTitle",
        "meta": {
          "variant": "section"
        }
      },
      {
        "type": "show-base",
        "value": "form.power_name",
        "name": "能力",
        "mode": "form",
        "meta": {
          "formLayout": "horizontal",
          "template": "{form.power_name}（ID：{form.power_id}）"
        }
      },
      {
        "type": "show-base",
        "value": "form.power_key",
        "mode": "form",
        "meta": {
          "formLayout": "horizontal"
        }
      },
      {
        "type": "show-base",
        "value": "form.provider_name",
        "name": "来源",
        "mode": "form",
        "meta": {
          "formLayout": "horizontal",
          "template": "{form.provider_name}（ID：{form.provider_id}）"
        }
      },
      {
        "type": "show-base",
        "value": "form.service_name",
        "name": "能力来源",
        "mode": "form",
        "meta": {
          "formLayout": "horizontal",
          "template": "{form.service_name}（ID：{form.power_target_id}）"
        }
      },
      {
        "type": "show-base",
        "value": "form.account_name",
        "name": "账号",
        "mode": "form",
        "meta": {
          "formLayout": "horizontal",
          "template": "{form.account_name}（ID：{form.account_id}）"
        }
      },
      {
        "type": "show-base",
        "value": "form.service_api",
        "mode": "form",
        "meta": {
          "formLayout": "horizontal"
        }
      }
    ],
    "attempt-card": [
      {
        "type": "show-title",
        "value": "page.attemptTitle",
        "meta": {
          "variant": "section"
        }
      },
      {
        "type": "show-table",
        "value": "attempts",
        "meta": {
          "rowKey": "id",
          "columns": [
            {
              "name": "顺序",
              "value": "attempt_no",
              "type": "show-base"
            },
            {
              "name": "来源",
              "value": "provider_name",
              "type": "show-base"
            },
            {
              "name": "能力来源",
              "value": "service_name",
              "type": "show-base"
            },
            {
              "name": "账号",
              "value": "account_name",
              "type": "show-base"
            },
            {
              "value": "status",
              "type": "show-tag"
            },
            {
              "value": "latency",
              "type": "show-base",
              "meta": {
                "format": "duration-ms"
              }
            },
            {
              "name": "总Token",
              "value": "total_tokens",
              "type": "show-base"
            },
            {
              "name": "缓存Token",
              "value": "cached_tokens",
              "type": "show-base"
            },
            {
              "name": "错误详情",
              "type": "show-button",
              "meta": {
                "variant": "outline",
                "size": "xs",
                "label": "查看详情",
                "description": "查看本次尝试的错误详情"
              },
              "action": {
                "click": [
                  {
                    "type": "data",
                    "key": "actionTarget.attemptError",
                    "value": "$row.error_detail"
                  },
                  {
                    "type": "modal",
                    "key": "dialog.attemptError",
                    "value": true
                  }
                ]
              }
            },
            {
              "value": "created_at",
              "type": "show-date"
            }
          ]
        }
      }
    ],
    "detail-card": [
      {
        "type": "show-title",
        "value": "page.detailTitle",
        "meta": {
          "variant": "section"
        }
      }
    ],
    "detail-actions": [
      {
        "type": "show-button",
        "name": "能力请求参数",
        "icon": "braces",
        "meta": {
          "variant": "outline",
          "size": "sm",
          "description": "查看调用能力时传入的完整参数"
        },
        "action": {
          "click": [
            {
              "type": "modal",
              "key": "dialog.requestParams",
              "value": true
            }
          ]
        }
      },
      {
        "type": "show-button",
        "name": "渠道请求参数",
        "icon": "send",
        "meta": {
          "variant": "outline",
          "size": "sm",
          "description": "查看实际发送给来源渠道的完整请求"
        },
        "action": {
          "click": [
            {
              "type": "modal",
              "key": "dialog.channelRequest",
              "value": true
            }
          ]
        }
      },
      {
        "type": "show-button",
        "name": "响应数据",
        "icon": "file-json",
        "meta": {
          "variant": "outline",
          "size": "sm",
          "description": "查看完整响应或失败信息"
        },
        "action": {
          "click": [
            {
              "type": "modal",
              "key": "dialog.result",
              "value": true
            }
          ]
        }
      }
    ],
    "feedback-shell": [
      {
        "type": "feedback-modal",
        "meta": {
          "stateKey": "dialog.attemptError",
          "title": "错误详情",
          "size": "lg",
          "formSection": "attempt-error-content",
          "bodyClassName": "max-h-[55vh] overflow-y-auto px-6 py-2",
          "footer": {
            "close": true,
            "confirm": false
          }
        }
      },
      {
        "type": "feedback-modal",
        "meta": {
          "stateKey": "dialog.requestParams",
          "title": "能力请求参数",
          "description": "调用 Energon 时传入的 set、input、history 和 options。",
          "size": "xl",
          "formSection": "request-param-content",
          "bodyClassName": "max-h-[65vh] overflow-y-auto px-6 py-2",
          "assistant": false,
          "footer": {
            "close": true,
            "confirm": false
          }
        }
      },
      {
        "type": "feedback-modal",
        "meta": {
          "stateKey": "dialog.channelRequest",
          "title": "渠道请求参数",
          "description": "转换后实际发送给来源渠道的 url、method、headers 和 body。",
          "size": "xl",
          "formSection": "channel-request-content",
          "bodyClassName": "max-h-[65vh] overflow-y-auto px-6 py-2",
          "assistant": false,
          "footer": {
            "close": true,
            "confirm": false
          }
        }
      },
      {
        "type": "feedback-modal",
        "meta": {
          "stateKey": "dialog.result",
          "title": "响应数据",
          "description": "本次调用的完整响应或失败信息。",
          "size": "xl",
          "formSection": "result-content",
          "bodyClassName": "max-h-[65vh] overflow-y-auto px-6 py-2",
          "assistant": false,
          "footer": {
            "close": true,
            "confirm": false
          }
        }
      }
    ],
    "attempt-error-content": [
      {
        "type": "show-base",
        "value": "actionTarget.attemptError",
        "className": "rounded-md bg-muted/30 p-4 font-mono text-xs leading-6 whitespace-pre-wrap break-all"
      }
    ],
    "request-param-content": [
      {
        "type": "show-base",
        "value": "requestParams",
        "className": "rounded-md bg-muted/30 p-4 font-mono text-xs leading-6 whitespace-pre-wrap break-all"
      }
    ],
    "channel-request-content": [
      {
        "type": "show-base",
        "value": "channelRequest",
        "className": "rounded-md bg-muted/30 p-4 font-mono text-xs leading-6 whitespace-pre-wrap break-all"
      }
    ],
    "result-content": [
      {
        "type": "show-base",
        "value": "form.result",
        "className": "rounded-md bg-muted/30 p-4 font-mono text-xs leading-6 whitespace-pre-wrap break-all"
      }
    ]
  },
  "data": {
    "page": {
      "basicTitle": {
        "title": "调用信息",
        "description": "展示本次请求的协议、状态与耗时。"
      },
      "targetTitle": {
        "title": "能力与来源",
        "description": "展示本次调用命中的能力、来源、能力来源与账号。"
      },
      "attemptTitle": {
        "title": "调用尝试",
        "description": "同一个 RequestID 下按实际调用顺序展示所有能力来源，前一个失败后才会尝试后一个。"
      },
      "detailTitle": {
        "title": "完整内容",
        "description": "长参数和响应按需打开，页面只保留便于排查的摘要。"
      }
    },
    "attempts": {
      "service": "bot.energon.log.LogViewService.LoadAttempts"
    },
    "requestParams": {
      "service": "bot.energon.log.LogViewService.LoadRequestParams"
    },
    "channelRequest": {
      "service": "bot.energon.log.LogViewService.LoadChannelRequest"
    },
    "form": {},
    "actionTarget": {
      "attemptError": ""
    }
  },
  "state": {
    "dialog": {
      "attemptError": false,
      "requestParams": false,
      "channelRequest": false,
      "result": false
    }
  },
  "action": {}
}
