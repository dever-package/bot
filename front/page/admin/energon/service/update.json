{
  "page": {
    "name": "服务编辑",
    "parent": "bot/energon/service/list",
    "sort": 10
  },
  "layout": {
    "type": "container",
    "children": {
      "page-main": {
        "type": "main",
        "className": "p-0",
        "children": {
          "dialog-shell": {
            "type": "container",
            "className": "w-full",
            "children": {
              "service-endpoint-page": {
                "type": "container",
                "path": "/bot/energon/service_endpoint/list",
                "className": "mt-5"
              },
              "service-param-page": {
                "type": "container",
                "path": "/bot/energon/service_param/list",
                "className": "mt-5"
              }
            }
          }
        }
      }
    }
  },
  "nodes": {
    "dialog-shell": [
      {
        "type": "form-select",
        "value": "form.provider_id",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "来源不能为空。"
          }
        ],
        "meta": {
          "controlClassName": "max-w-[260px]"
        }
      },
      {
        "id": "service-account",
        "type": "form-select",
        "name": "鉴权账号",
        "value": "form.account_id",
        "mode": "form",
        "placeholder": "使用来源通用账号",
        "option": {
          "model": "bot.energon.NewAccountModel",
          "parentField": "provider_id",
          "valueField": "id",
          "labelField": "name",
          "extraFields": [
            "scope",
            "status",
            "host"
          ],
          "filters": {
            "status": "1"
          },
          "order": "scope asc,sort asc,id asc",
          "pageSize": 200
        },
        "info": "留空时按排序使用当前来源的启用通用账号；选择后固定使用该账号。",
        "meta": {
          "optionParams": {
            "parentId": "form.provider_id"
          },
          "emptyValues": [
            0,
            "0",
            ""
          ],
          "controlClassName": "max-w-[320px]"
        }
      },
      {
        "type": "form-input",
        "value": "form.name",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "服务名称不能为空。"
          }
        ]
      },
      {
        "type": "form-radio",
        "value": "form.type",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "服务类型不能为空。"
          }
        ],
        "meta": {
          "controlClassName": "max-w-[220px]"
        }
      },
      {
        "type": "form-input",
        "value": "form.path",
        "mode": "form",
        "placeholder": "例如：/chat/completions、images/generations；留空使用协议默认路径",
        "info": "支持相对路径或完整 HTTP(S) 地址。相对路径会与账号主机组合，账号未配置主机时使用来源主机；完整地址直接使用；留空使用协议默认路径。"
      }
    ]
  },
  "data": {
    "form": {
      "service": "bot.energon.hook.ServiceHook.AttachServicePricingForm",
      "_fields": [
        "provider_id",
        "account_id",
        "name",
        "type",
        "path",
        "sort",
        "status",
        "endpoints",
        "params"
      ],
      "provider_id": "",
      "account_id": 0,
      "type": "text",
      "path": "",
      "sort": 100,
      "status": 1,
      "endpoints": [],
      "params": []
    }
  },
  "state": {},
  "action": {
    "submit": {
      "type": "save",
      "params": "form",
      "before": {
        "service": "bot.energon.hook.ServiceHook.BeforeSaveService"
      }
    }
  }
}
