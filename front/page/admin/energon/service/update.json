{
  "page": {
    "name": "服务编辑",
    "parent": "bot/energon/service/list",
    "sort": 10
  },
  "layout": {
    "type": "container",
    "children": {
      "page-main": {
        "type": "main",
        "className": "p-0",
        "children": {
          "dialog-shell": {
            "type": "container",
            "className": "w-full",
            "children": {
              "service-endpoint-page": {
                "type": "container",
                "path": "/bot/energon/service_endpoint/list",
                "className": "mt-5"
              },
              "service-param-page": {
                "type": "container",
                "path": "/bot/energon/service_param/list",
                "className": "mt-5"
              }
            }
          }
        }
      }
    }
  },
  "nodes": {
    "dialog-shell": [
      {
        "type": "form-select",
        "value": "form.provider_id",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "来源不能为空。"
          }
        ],
        "meta": {
          "controlClassName": "max-w-[260px]"
        }
      },
      {
        "id": "service-account",
        "type": "form-select",
        "name": "鉴权账号",
        "value": "form.account_id",
        "mode": "form",
        "placeholder": "使用来源通用账号",
        "option": {
          "model": "bot.energon.NewAccountModel",
          "parentField": "provider_id",
          "valueField": "id",
          "labelField": "name",
          "extraFields": [
            "scope",
            "status",
            "host"
          ],
          "filters": {
            "status": "1"
          },
          "order": "scope asc,sort asc,id asc",
          "pageSize": 200
        },
        "info": "留空时按排序使用当前来源的启用通用账号；选择后固定使用该账号。",
        "meta": {
          "optionParams": {
            "parentId": "form.provider_id"
          },
          "emptyValues": [
            0,
            "0",
            ""
          ],
          "controlClassName": "max-w-[320px]"
        }
      },
      {
        "type": "form-input",
        "value": "form.name",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "服务名称不能为空。"
          }
        ]
      },
      {
        "type": "form-radio",
        "value": "form.type",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "服务类型不能为空。"
          }
        ],
        "meta": {
          "controlClassName": "max-w-[220px]"
        }
      },
      {
        "id": "service-image-output-mode",
        "type": "form-radio",
        "name": "图片输出模式",
        "value": "form.image_output_mode",
        "mode": "form",
        "info": "单图服务每次返回一张图片；组图服务可在一次请求中返回多张有序图片。仅声明来源能力，不要求用户填写生成张数。",
        "meta": {
          "controlClassName": "max-w-[220px]",
          "showWhen": [
            {
              "path": "form.type",
              "operator": "equals",
              "value": "image"
            }
          ]
        }
      },
      {
        "id": "service-max-images-per-request",
        "type": "form-input",
        "name": "单次最多图片数",
        "placeholder": "0 表示使用协议上限",
        "value": "form.max_images_per_request",
        "mode": "form",
        "info": "仅组图服务使用；0 表示按系统宫格上限 9 张处理。",
        "meta": {
          "formLayout": "horizontal",
          "controlClassName": "max-w-[220px]",
          "showWhen": [
            {
              "path": "form.type",
              "operator": "equals",
              "value": "image"
            },
            {
              "path": "form.image_output_mode",
              "operator": "equals",
              "value": "group"
            }
          ]
        }
      },
      {
        "id": "service-context-window-tokens",
        "type": "form-input",
        "name": "上下文窗口",
        "placeholder": "例如：64K、128K、1.05M",
        "value": "form.context_window_tokens",
        "mode": "form",
        "info": "当前渠道和模型实际可用的输入与输出总窗口；0 表示使用 runtime 的 64K 安全默认值。支持 K、M 简写。",
        "meta": {
          "formLayout": "horizontal",
          "controlClassName": "max-w-[220px]",
          "showWhen": [
            {
              "path": "form.type",
              "operator": "equals",
              "value": "text"
            }
          ]
        }
      },
      {
        "id": "service-max-output-tokens",
        "type": "form-input",
        "name": "单次最大输出",
        "placeholder": "例如：8K、16K、128K",
        "value": "form.max_output_tokens",
        "mode": "form",
        "info": "当前渠道和模型一次响应允许的硬上限；0 表示使用 runtime 的 16K 安全默认值。必须小于上下文窗口。",
        "meta": {
          "formLayout": "horizontal",
          "controlClassName": "max-w-[220px]",
          "showWhen": [
            {
              "path": "form.type",
              "operator": "equals",
              "value": "text"
            }
          ]
        }
      },
      {
        "type": "form-input",
        "value": "form.path",
        "mode": "form",
        "placeholder": "例如：/chat/completions、images/generations；留空使用协议默认路径",
        "info": "支持相对路径或完整 HTTP(S) 地址。相对路径会与账号主机组合，账号未配置主机时使用来源主机；完整地址直接使用；留空使用协议默认路径。"
      }
    ]
  },
  "data": {
    "form": {
      "service": "bot.energon.hook.ServiceHook.AttachServicePricingForm",
      "_fields": [
        "provider_id",
        "account_id",
        "name",
        "type",
        "image_output_mode",
        "max_images_per_request",
        "context_window_tokens",
        "max_output_tokens",
        "path",
        "sort",
        "status",
        "endpoints",
        "params"
      ],
      "provider_id": "",
      "account_id": 0,
      "type": "text",
      "image_output_mode": "single",
      "max_images_per_request": 0,
      "context_window_tokens": "0",
      "max_output_tokens": "0",
      "path": "",
      "sort": 100,
      "status": 1,
      "endpoints": [],
      "params": []
    }
  },
  "state": {},
  "action": {
    "submit": {
      "type": "save",
      "params": "form",
      "before": {
        "service": "bot.energon.hook.ServiceHook.BeforeSaveService"
      }
    }
  }
}
