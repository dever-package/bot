{
  "page": {
    "name": "服务",
    "icon": "server-cog",
    "parent": "bot/energon/provider/list",
    "type": 2,
    "sort": 12
  },
  "layout": {
    "type": "container",
    "children": {
      "page-header": {
        "type": "header",
        "className": "gap-4",
        "children": {
          "header-actions": {
            "type": "row",
            "className": "ms-auto shrink-0 flex-nowrap items-center gap-2"
          }
        }
      },
      "page-main": {
        "type": "main",
        "className": "flex flex-1 flex-col gap-5 sm:gap-6",
        "children": {
          "table-row": {
            "type": "container",
            "className": "overflow-hidden rounded-md border bg-background"
          }
        }
      }
    }
  },
  "nodes": {
    "page-header": [
      {
        "type": "show-title",
        "value": "page",
        "className": "min-w-0 flex-1"
      }
    ],
    "header-actions": [
      {
        "type": "show-button",
        "name": "返回上一页",
        "meta": {
          "variant": "outline",
          "size": "sm",
          "back": true,
          "fallback": "/bot/energon/provider/list"
        }
      },
      {
        "type": "show-button",
        "meta": {
          "variant": "default",
          "size": "sm",
          "hiddenWhen": [
            {
              "path": "search.provider_protocol",
              "operator": "equals",
              "value": "local"
            }
          ]
        },
        "action": {
          "click": {
            "type": "modal",
            "key": "dialog.create",
            "value": true
          }
        }
      }
    ],
    "table-row": [
      {
        "type": "show-table",
        "value": "table.list",
        "meta": {
          "pagePath": "data.table.page",
          "pageSizePath": "data.table.pageSize",
          "totalPath": "data.table.total",
          "remote": true,
          "externalPagination": true,
          "savePath": "bot/energon/service/update",
          "rowKey": "id",
          "readOnlyWhen": [
            {
              "path": "search.provider_protocol",
              "operator": "equals",
              "value": "local"
            }
          ],
          "columns": [
            {
              "value": "id",
              "type": "show-base"
            },
            {
              "value": "provider.name",
              "type": "show-base"
            },
            {
              "value": "name",
              "type": "show-base"
            },
            {
              "value": "type",
              "type": "show-tag"
            },
            {
              "name": "平均响应时间",
              "value": "runtime_stats.0.avg",
              "type": "show-base",
              "meta": {
                "format": "duration-ms"
              }
            },
            {
              "value": "sort",
              "type": "show-base",
              "editor": "form-number",
              "trigger": "doubleClick",
              "tip": "正序排序，数值越大越靠后。双击可修改。"
            },
            {
              "value": "status",
              "type": "form-switch",
              "meta": {
                "trueValue": 1,
                "falseValue": 2
              }
            },
            {
              "name": "操作",
              "type": "show-button",
              "className": "w-[1%] whitespace-nowrap px-3 text-center",
              "meta": {
                "buttons": [
                  {
                    "icon": "eye",
                    "variant": "outline",
                    "size": "sm",
                    "description": "查看详情",
                    "action": {
                      "click": [
                        {
                          "type": "data",
                          "key": "actionTarget.id",
                          "value": "$row.id"
                        },
                        {
                          "type": "modal",
                          "key": "dialog.view",
                          "value": true
                        }
                      ]
                    }
                  },
                  {
                    "icon": "square-pen",
                    "variant": "outline",
                    "size": "sm",
                    "description": "编辑服务",
                    "hiddenWhen": [
                      {
                        "path": "provider.protocol",
                        "operator": "equals",
                        "value": "local"
                      }
                    ],
                    "action": {
                      "click": [
                        {
                          "type": "data",
                          "key": "actionTarget.id",
                          "value": "$row.id"
                        },
                        {
                          "type": "modal",
                          "key": "dialog.edit",
                          "value": true
                        }
                      ]
                    }
                  },
                  {
                    "icon": "copy",
                    "variant": "outline",
                    "size": "sm",
                    "description": "复制服务",
                    "hiddenWhen": [
                      {
                        "path": "provider.protocol",
                        "operator": "equals",
                        "value": "local"
                      }
                    ],
                    "action": {
                      "click": [
                        {
                          "type": "data",
                          "key": "actionTarget.copyService.id",
                          "value": "$row.id"
                        },
                        {
                          "type": "modal",
                          "key": "confirm.copy",
                          "value": true
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "type": "show-page"
      }
    ],
    "page-main": [
      {
        "type": "feedback-modal",
        "meta": {
          "stateKey": "dialog.view",
          "pageRoute": "/bot/energon/service/view",
          "description": "查看服务接口和全部参数配置。",
          "size": "xl",
          "bodyClassName": "max-h-[70vh] overflow-y-auto px-6 py-2",
          "pageRouteQuery": {
            "id": "data.actionTarget.id"
          }
        }
      },
      {
        "type": "feedback-modal",
        "meta": {
          "stateKey": "dialog.edit",
          "pageRoute": "/bot/energon/service/update",
          "description": "服务参数会随服务一起保存。",
          "size": "xl",
          "footer": {
            "confirm": true,
            "confirmText": "保存"
          },
          "pageRouteQuery": {
            "id": "data.actionTarget.id"
          }
        }
      },
      {
        "type": "feedback-modal",
        "meta": {
          "stateKey": "dialog.create",
          "pageRoute": "/bot/energon/service/update",
          "description": "新增时会默认带入当前来源。",
          "size": "xl",
          "footer": {
            "confirm": true,
            "confirmText": "保存"
          },
          "pageRouteQuery": {
            "provider_id": "data.search.provider_id"
          }
        }
      },
      {
        "type": "feedback-confirm",
        "name": "复制服务",
        "info": "确认复制当前服务吗？服务接口、成本价格和服务参数都会生成独立副本，名称自动增加“-复制”。",
        "meta": {
          "stateKey": "confirm.copy",
          "successMessage": "服务已复制",
          "errorMessage": "复制服务失败。"
        },
        "action": {
          "confirm": {
            "type": "request",
            "api": "/bot/admin/energon/copy_service",
            "method": "post",
            "params": "actionTarget.copyService"
          }
        }
      }
    ]
  },
  "data": {
    "page": {
      "description": "定义来源可提供的模型、工作流等服务入口。"
    },
    "search": {
      "provider_id": "",
      "provider_protocol": ""
    },
    "table": {
      "filterFields": [
        "provider_id"
      ]
    },
    "actionTarget": {
      "id": "",
      "copyService": {}
    }
  },
  "state": {
    "dialog": {
      "view": false,
      "edit": false,
      "create": false
    },
    "confirm": {
      "copy": false
    }
  },
  "action": {}
}
