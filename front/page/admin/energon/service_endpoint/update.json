{
  "page": {
    "name": "服务接口编辑",
    "parent": "bot/energon/service_endpoint/list",
    "type": 2,
    "sort": 11
  },
  "layout": {
    "type": "container",
    "children": {
      "page-main": {
        "type": "main",
        "className": "p-0",
        "children": {
          "dialog-shell": {
            "type": "container",
            "className": "w-full",
            "children": {
              "service-price-page": {
                "type": "container",
                "path": "/bot/energon/service_price/list",
                "className": "mt-5"
              }
            }
          }
        }
      }
    }
  },
  "nodes": {
    "dialog-shell": [
      {
        "type": "form-radio",
        "value": "form.interface_type",
        "mode": "form"
      },
      {
        "type": "form-input",
        "value": "form.api",
        "mode": "form",
        "placeholder": "例如：gpt-4o、人物生成、商品换背景",
        "info": "模型标识类型填写模型名、工作流 ID 或协议需要的接口标识；工作流 JSON 类型填写自定义易读标识，用于在列表中区分工作流，不是工作流节点或输入字段。服务路径在来源服务中配置。",
        "validate": [
          {
            "type": "required",
            "message": "接口标识不能为空。"
          }
        ]
      },
      {
        "type": "form-textarea",
        "value": "form.workflow_json",
        "mode": "form",
        "placeholder": "粘贴 ComfyUI 导出的 API 格式工作流 JSON",
        "info": "请粘贴 API 格式节点对象，不是含 nodes/links 的画布 JSON。工作流保存在当前服务接口；服务参数的字段标识填写 节点ID.输入名，例如 10.text、3.seed、14.image，不加 prompt 或 inputs 前缀。参考图片会自动上传到 ComfyUI；一个图片输入映射一张图，多图用文件索引分别映射到各节点。工作流须包含与服务类型匹配的文件输出节点，来源须选择 ComfyUI。",
        "validate": [
          {
            "type": "required",
            "message": "请粘贴工作流 JSON。",
            "when": [
              {
                "path": "form.interface_type",
                "operator": "equals",
                "value": "workflow_json"
              }
            ]
          }
        ],
        "meta": {
          "rows": 14,
          "showWhen": [
            {
              "path": "form.interface_type",
              "operator": "equals",
              "value": "workflow_json"
            }
          ]
        }
      },
      {
        "type": "form-radio",
        "value": "form.param_mode",
        "mode": "form",
        "info": "关联参数为空时作为默认接口；有关联参数时按这里选择全部满足或任一满足。",
        "meta": {
          "controlClassName": "min-w-[12rem]"
        }
      },
      {
        "type": "form-array",
        "name": "关联参数",
        "value": "form.param_ids",
        "mode": "form",
        "info": "参数直接来自内部参数表。每行先选参数分类，再选参数。",
        "meta": {
          "pageRoute": "/bot/energon/service_endpoint/param",
          "addText": "添加关联参数",
          "drag": "sort",
          "itemName": "关联参数",
          "valueFormat": "json"
        }
      }
    ]
  },
  "data": {
    "form": {
      "interface_type": "model",
      "workflow_json": "",
      "param_mode": "all",
      "param_ids": [],
      "prices": [],
      "status": 1,
      "sort": 100
    },
    "option": {
      "param_mode": {
        "service": "bot.energon.ParamOptionService.LoadServiceEndpointParamModeOptions"
      }
    }
  },
  "state": {},
  "action": {
    "submit": {
      "type": "save",
      "params": "form"
    }
  }
}
