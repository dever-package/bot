{
  "page": {
    "name": "来源账号编辑",
    "parent": "bot/energon/account/list",
    "type": 2,
    "sort": 10
  },
  "layout": {
    "type": "container",
    "children": {
      "page-main": {
        "type": "main",
        "className": "p-0",
        "children": {
          "dialog-shell": {
            "type": "container",
            "className": "w-full"
          }
        }
      }
    }
  },
  "nodes": {
    "dialog-shell": [
      {
        "type": "form-input",
        "value": "form.name",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "账号名称不能为空。"
          }
        ]
      },
      {
        "type": "form-radio",
        "value": "form.scope",
        "mode": "form",
        "info": "通用账号会被未指定账号的服务自动使用；专用账号只供明确绑定它的服务调用。",
        "meta": {
          "controlClassName": "max-w-[220px]"
        }
      },
      {
        "type": "form-input",
        "value": "form.host",
        "mode": "form",
        "placeholder": "留空继承来源主机，例如：https://openspeech.bytedance.com",
        "info": "填写后，该账号被服务选中时会优先使用此主机；服务填写完整 HTTP(S) 地址时仍以服务地址为准。"
      },
      {
        "type": "form-textarea",
        "value": "form.key",
        "mode": "form",
        "placeholder": "请输入 API Key",
        "validate": [
          {
            "type": "required",
            "message": "密钥不能为空。"
          }
        ],
        "meta": {
          "rows": 4
        }
      }
    ]
  },
  "data": {
    "form": {
      "scope": 1,
      "host": "",
      "key": "",
      "status": 1,
      "sort": 100
    }
  },
  "state": {},
  "action": {
    "submit": {
      "type": "save",
      "params": "form"
    }
  }
}
