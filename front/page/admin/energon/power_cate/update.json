{
  "page": {
    "name": "能力分类编辑",
    "parent": "bot/energon/power/list",
    "type": 2,
    "sort": 9
  },
  "layout": {
    "type": "container",
    "children": {
      "page-main": {
        "type": "main",
        "className": "p-0",
        "children": {
          "dialog-shell": {
            "type": "container",
            "className": "w-full"
          }
        }
      }
    }
  },
  "nodes": {
    "dialog-shell": [
      {
        "type": "form-input",
        "placeholder": "例如：生成能力",
        "value": "form.name",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "分类名称不能为空。"
          }
        ]
      },
      {
        "type": "form-radio",
        "value": "form.type",
        "mode": "form",
        "info": "基础能力会直接展示；分组能力会先展示分类，再通过二级菜单选择具体能力。",
        "validate": [
          {
            "type": "required",
            "message": "类型不能为空。"
          }
        ],
        "meta": {
          "formLayout": "horizontal"
        }
      }
    ]
  },
  "data": {
    "form": {
      "type": 1
    }
  },
  "state": {},
  "action": {
    "submit": {
      "type": "save",
      "params": "form"
    }
  }
}
