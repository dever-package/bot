{
  "page": {
    "name": "素材方案编辑",
    "parent": "bot/team/material_pack/list",
    "type": 2,
    "sort": 10,
    "auth": [
      {
        "key": "bot/team/material_pack/create",
        "name": "素材方案新增",
        "query": {
          "id": "empty"
        }
      },
      {
        "key": "bot/team/material_pack/update",
        "name": "素材方案编辑",
        "query": {
          "id": "required"
        }
      }
    ]
  },
  "layout": {
    "type": "container",
    "children": {
      "page-main": {
        "type": "main",
        "className": "p-0",
        "children": {
          "dialog-shell": {
            "type": "container",
            "className": "w-full"
          }
        }
      }
    }
  },
  "nodes": {
    "dialog-shell": [
      {
        "type": "form-input",
        "placeholder": "例如：短视频创作素材",
        "value": "form.name",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "素材方案名称不能为空。"
          }
        ],
        "meta": {
          "formLayout": "horizontal"
        }
      },
      {
        "type": "form-textarea",
        "placeholder": "描述这个素材方案适合哪些团队或创作场景。",
        "value": "form.description",
        "mode": "form",
        "meta": {
          "formLayout": "horizontal",
          "rows": 3
        }
      },
      {
        "type": "form-array",
        "name": "素材",
        "value": "form.items",
        "mode": "form",
        "info": "选择素材库中的官方素材组成当前方案；同一素材只能加入一次。",
        "meta": {
          "formLayout": "horizontal",
          "pageRoute": "/bot/team/material_pack_item/update",
          "addText": "添加素材",
          "drag": "sort"
        }
      }
    ]
  },
  "data": {
    "form": {
      "_fields": [
        "name",
        "description",
        "status",
        "sort",
        "items"
      ],
      "id": 0,
      "name": "",
      "description": "",
      "status": 1,
      "sort": 100,
      "items": []
    }
  },
  "state": {},
  "action": {
    "submit": {
      "type": "save",
      "params": "form",
      "before": {
        "service": "bot.team.MaterialHook.BeforeSaveMaterialPack"
      }
    }
  }
}
