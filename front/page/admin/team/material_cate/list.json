{
  "page": {
    "name": "素材分类",
    "parent": "bot/team/material_pack/list",
    "type": 2,
    "sort": 1
  },
  "layout": {
    "type": "container",
    "children": {
      "category-shell": {
        "type": "main",
        "className": "space-y-3 p-0",
        "children": {
          "category-actions": {
            "type": "row",
            "className": "justify-end"
          },
          "category-table": {
            "type": "container",
            "className": "overflow-hidden rounded-md border bg-background"
          }
        }
      },
      "feedback-shell": {
        "type": "container"
      }
    }
  },
  "nodes": {
    "category-actions": [
      {
        "type": "show-button",
        "name": "新增分类",
        "meta": {
          "icon": "plus",
          "variant": "default",
          "size": "sm"
        },
        "action": {
          "click": {
            "type": "modal",
            "key": "dialog.create",
            "value": true
          }
        }
      }
    ],
    "category-table": [
      {
        "type": "show-table",
        "value": "table.list",
        "meta": {
          "pagePath": "data.table.page",
          "pageSizePath": "data.table.pageSize",
          "totalPath": "data.table.total",
          "remote": true,
          "externalPagination": true,
          "savePath": "bot/team/material_cate/update",
          "rowKey": "id",
          "columns": [
            {
              "value": "name",
              "name": "分类名称",
              "type": "show-base"
            },
            {
              "value": "kind",
              "name": "素材类型",
              "type": "show-tag"
            },
            {
              "value": "sort",
              "name": "排序",
              "type": "show-base",
              "editor": "form-number",
              "trigger": "doubleClick",
              "tip": "数值越小越靠前，双击可修改。"
            },
            {
              "value": "status",
              "name": "状态",
              "type": "form-switch",
              "meta": {
                "trueValue": 1,
                "falseValue": 2
              }
            },
            {
              "name": "操作",
              "type": "show-button",
              "className": "w-[1%] whitespace-nowrap px-3 text-center",
              "meta": {
                "buttons": [
                  {
                    "icon": "square-pen",
                    "variant": "outline",
                    "size": "sm",
                    "description": "编辑素材分类",
                    "action": {
                      "click": [
                        {
                          "type": "data",
                          "key": "actionTarget.id",
                          "value": "$row.id"
                        },
                        {
                          "type": "modal",
                          "key": "dialog.edit",
                          "value": true
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "type": "show-page"
      }
    ],
    "feedback-shell": [
      {
        "type": "feedback-modal",
        "meta": {
          "stateKey": "dialog.create",
          "pageRoute": "/bot/team/material_cate/update",
          "description": "分类隶属于一个素材类型，新增素材时会按类型筛选。",
          "assistant": false,
          "footer": {
            "confirm": true,
            "confirmText": "保存"
          },
          "size": "sm",
          "bodyClassName": "py-2"
        }
      },
      {
        "type": "feedback-modal",
        "meta": {
          "stateKey": "dialog.edit",
          "pageRoute": "/bot/team/material_cate/update",
          "description": "修改分类后，素材列表会同步显示新名称。",
          "assistant": false,
          "footer": {
            "confirm": true,
            "confirmText": "保存"
          },
          "pageRouteQuery": {
            "id": "data.actionTarget.id"
          },
          "size": "sm",
          "bodyClassName": "py-2"
        }
      }
    ]
  },
  "data": {
    "table": {
      "model": "bot.team.NewMaterialCateModel"
    },
    "actionTarget": {
      "id": ""
    }
  },
  "state": {
    "dialog": {
      "create": false,
      "edit": false
    }
  },
  "action": {}
}
