{
  "page": {
    "name": "数据统计",
    "parent": "bot/body/statistics/list",
    "type": 2,
    "sort": 2
  },
  "layout": {
    "type": "container",
    "children": {
      "page-main": {
        "type": "main",
        "className": "flex flex-1 flex-col gap-5 p-0 sm:gap-6",
        "children": {
          "toolbar-row": {
            "type": "row",
            "className": "flex-wrap items-center gap-3"
          },
          "summary-row": {
            "type": "container",
            "className": "grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3"
          },
          "primary-chart-row": {
            "type": "container",
            "className": "grid grid-cols-1 gap-4 lg:grid-cols-3"
          },
          "secondary-chart-row": {
            "type": "container",
            "className": "grid grid-cols-1 gap-4"
          }
        }
      }
    }
  },
  "nodes": {
    "toolbar-row": [
      {
        "type": "form-input",
        "placeholder": "搜索用户名称或账号...",
        "value": "search.keyword",
        "mode": "search"
      },
      {
        "type": "form-select",
        "placeholder": "使用人",
        "value": "search.user_id",
        "mode": "search",
        "option": {
          "service": "user.UserOptionService.LoadUsers",
          "pageSize": 20
        },
        "meta": {
          "searchPlaceholder": "输入用户名称或账号搜索..."
        }
      },
      {
        "type": "form-select",
        "placeholder": "能力",
        "value": "search.power_id",
        "mode": "search",
        "option": {
          "model": "bot.energon.NewPowerModel",
          "labelField": "name",
          "searchFields": ["name", "key"],
          "pageSize": 20
        },
        "meta": {
          "searchPlaceholder": "输入能力名称或标识搜索..."
        }
      },
      {
        "type": "form-select",
        "placeholder": "业务入口",
        "value": "search.body_function_code",
        "mode": "search",
        "option": {
          "service": "bot.energon.UserUsageService.LoadBodyFunctionOptions",
          "valueField": "code",
          "labelField": "name",
          "pageSize": 10
        }
      },
      {
        "type": "form-select",
        "name": "时间范围",
        "placeholder": "统计时间",
        "value": "search.period",
        "mode": "search",
        "option": "option.period",
        "meta": {
          "clearable": false,
          "searchable": false,
          "searchWidth": "select"
        }
      },
      {
        "type": "form-date",
        "placeholder": "自定义时间",
        "value": "search.created_at_start",
        "mode": "search",
        "meta": {
          "searchWidth": "select",
          "range": true,
          "endValue": "search.created_at_end",
          "inputType": "datetime-local",
          "showWhen": [
            {
              "path": "search.period",
              "operator": "equals",
              "value": "custom"
            }
          ]
        }
      },
      {
        "type": "show-button",
        "name": "搜索",
        "icon": "search",
        "meta": {
          "variant": "default",
          "size": "sm",
          "searchSubmit": true,
          "reloadDataKey": "dashboard",
          "loadingText": "搜索中..."
        }
      },
      {
        "type": "show-button",
        "name": "重置",
        "meta": {
          "variant": "outline",
          "size": "sm",
          "to": "/bot/body/statistics/overview"
        }
      },
      {
        "type": "show-text",
        "value": "dashboard.range_label",
        "className": "w-full text-xs sm:ml-auto sm:w-auto sm:whitespace-nowrap"
      }
    ],
    "summary-row": [
      {
        "type": "show-stat-card",
        "name": "活跃用户",
        "value": "dashboard.summary.active_users",
        "className": "min-w-0",
        "meta": {
          "description": "统计时间内产生调用的前台用户",
          "icon": "users",
          "format": "number"
        }
      },
      {
        "type": "show-stat-card",
        "name": "服务调用次数",
        "value": "dashboard.summary.logical_calls",
        "className": "min-w-0",
        "meta": {
          "description": "一次用户服务请求计为一次，供应商重试不重复计算",
          "icon": "zap",
          "format": "number"
        }
      },
      {
        "type": "show-stat-card",
        "name": "服务成功率",
        "value": "dashboard.summary.success_rate",
        "className": "min-w-0",
        "meta": {
          "description": "成功服务占已结束服务调用的比例",
          "icon": "circle-check"
        }
      },
      {
        "type": "show-stat-card",
        "name": "供应商 Token 用量",
        "value": "dashboard.summary.total_tokens",
        "className": "min-w-0",
        "meta": {
          "description": "供应商输入与输出 Token 之和，供应商重试会累计",
          "icon": "braces",
          "format": "number"
        }
      },
      {
        "type": "show-stat-card",
        "name": "供应商成本（CNY）",
        "value": "dashboard.summary.cost_cny",
        "className": "min-w-0",
        "meta": {
          "description": "供应商计费成本，统一折算人民币",
          "icon": "badge-dollar-sign",
          "format": "number"
        }
      },
      {
        "type": "show-stat-card",
        "name": "实扣积分",
        "value": "dashboard.summary.settled_points",
        "className": "min-w-0",
        "meta": {
          "description": "用户最终实际扣除的积分",
          "icon": "coins",
          "format": "number"
        }
      }
    ],
    "primary-chart-row": [
      {
        "type": "show-chart",
        "value": "dashboard.logical_call_trend",
        "className": "min-w-0 lg:col-span-2",
        "meta": {
          "title": "服务调用趋势",
          "description": "按用户发起的服务请求统计，供应商重试不重复计算",
          "type": "area",
          "nameKey": "name",
          "dataKey": "value",
          "valueLabel": "服务调用次数",
          "height": 280
        }
      },
      {
        "type": "show-chart",
        "value": "dashboard.business_entry_distribution",
        "className": "min-w-0",
        "meta": {
          "title": "业务入口分布",
          "description": "按基础配置中已启用的前台业务入口统计服务调用",
          "type": "pie",
          "nameKey": "name",
          "dataKey": "value",
          "valueLabel": "服务调用次数",
          "height": 280
        }
      }
    ],
    "secondary-chart-row": [
      {
        "type": "show-chart",
        "value": "dashboard.cost_trend",
        "className": "min-w-0",
        "meta": {
          "title": "供应商成本趋势",
          "description": "供应商实际计费成本，单位 CNY",
          "type": "bar",
          "nameKey": "name",
          "dataKey": "value",
          "valueLabel": "供应商成本（CNY）",
          "height": 280
        }
      },
      {
        "type": "show-chart",
        "value": "dashboard.settled_point_trend",
        "className": "min-w-0",
        "meta": {
          "title": "用户消费趋势",
          "description": "按服务结算的用户实扣积分统计，单位为积分",
          "type": "area",
          "nameKey": "name",
          "dataKey": "value",
          "valueLabel": "实扣积分（积分）",
          "height": 280
        }
      }
    ]
  },
  "data": {
    "search": {
      "keyword": "",
      "user_id": "",
      "power_id": "",
      "body_function_code": "",
      "period": "this_month",
      "created_at_start": "",
      "created_at_end": ""
    },
    "option": {
      "period": [
        {
          "id": "today",
          "value": "今日"
        },
        {
          "id": "yesterday",
          "value": "昨日"
        },
        {
          "id": "this_week",
          "value": "本周"
        },
        {
          "id": "last_week",
          "value": "上周"
        },
        {
          "id": "this_month",
          "value": "本月"
        },
        {
          "id": "last_month",
          "value": "上月"
        },
        {
          "id": "this_year",
          "value": "全年"
        },
        {
          "id": "custom",
          "value": "自定义"
        }
      ]
    },
    "dashboard": {
      "service": "bot.energon.UserUsageService.LoadUsageDashboard"
    }
  },
  "state": {},
  "action": {}
}
