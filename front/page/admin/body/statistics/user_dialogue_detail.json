{
  "page": {
    "name": "对话详情",
    "parent": "bot/body/statistics/user_dialogue",
    "type": 2,
    "sort": 22
  },
  "layout": {
    "type": "container",
    "children": {
      "page-main": {
        "type": "main",
        "className": "flex flex-col gap-5 p-0",
        "children": {
          "basic-section": { "type": "container", "className": "border-b pb-4" },
          "message-section": { "type": "container", "className": "overflow-hidden rounded-md border bg-background" },
          "feedback-shell": { "type": "container" }
        }
      }
    }
  },
  "nodes": {
    "basic-section": [
      { "type": "show-title", "name": "对话信息", "meta": { "variant": "section" } },
      { "type": "show-base", "name": "对话标题", "value": "form.title", "mode": "form", "meta": { "formLayout": "horizontal" } },
      { "type": "show-base", "name": "智能体", "value": "form.agent_name", "mode": "form", "meta": { "formLayout": "horizontal" } },
      { "type": "show-base", "name": "消息数", "value": "form.message_count", "mode": "form", "meta": { "formLayout": "horizontal" } },
      { "type": "show-tag", "name": "状态", "value": "form.status", "mode": "form", "meta": { "formLayout": "horizontal", "option": [{ "id": 1, "value": "活跃" }, { "id": 2, "value": "归档" }] } },
      { "type": "show-date", "name": "最后对话时间", "value": "form.last_message_at", "mode": "form", "meta": { "formLayout": "horizontal", "format": "datetime-second" } }
    ],
    "message-section": [
      {
        "type": "show-table",
        "value": "table.list",
        "meta": {
          "pagePath": "data.table.page",
          "pageSizePath": "data.table.pageSize",
          "totalPath": "data.table.total",
          "remote": true,
          "externalPagination": true,
          "rowKey": "id",
          "columns": [
            { "name": "角色", "value": "role_name", "type": "show-tag" },
            { "name": "消息摘要", "value": "summary", "type": "show-base" },
            { "name": "状态", "value": "status", "type": "show-tag" },
            { "name": "时间", "value": "created_at", "type": "show-date" },
            {
              "name": "操作",
              "type": "show-button",
              "className": "w-[1%] whitespace-nowrap px-3 text-center",
              "meta": {
                "buttons": [
                  {
                    "icon": "eye",
                    "variant": "outline",
                    "size": "sm",
                    "description": "查看消息内容与结果",
                    "action": {
                      "click": [
                        { "type": "data", "key": "actionTarget.messageId", "value": "$row.id" },
                        { "type": "modal", "key": "dialog.message", "value": true }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      { "type": "show-page" }
    ],
    "feedback-shell": [
      {
        "type": "feedback-modal",
        "meta": {
          "stateKey": "dialog.message",
          "pageRoute": "/bot/body/statistics/user_dialogue_message_detail",
          "description": "查看单条消息对应的用户提示词和智能体结果。",
          "size": "xl",
          "bodyClassName": "max-h-[72vh] overflow-y-auto px-6 py-2",
          "pageRouteQuery": {
            "id": "data.form.id",
            "user_id": "data.form.user_id",
            "message_id": "data.actionTarget.messageId"
          }
        }
      }
    ]
  },
  "data": {
    "form": {
      "service": "bot.agent.runtime.chat.UserRecordService.LoadSessionDetail"
    },
    "table": {
      "service": "bot.agent.runtime.chat.UserRecordService.LoadSessionMessages"
    },
    "actionTarget": {
      "messageId": ""
    }
  },
  "state": {
    "dialog": {
      "message": false
    }
  },
  "action": {}
}
