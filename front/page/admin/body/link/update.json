{
  "page": {
    "name": "单页链接编辑",
    "parent": "bot/body/link/list",
    "type": 2,
    "auth": [
      {
        "key": "bot/body/link/create",
        "name": "单页链接新增",
        "query": {
          "id": "empty"
        }
      },
      {
        "key": "bot/body/link/update",
        "name": "单页链接编辑",
        "query": {
          "id": "required"
        }
      }
    ]
  },
  "layout": {
    "type": "container",
    "children": {
      "page-main": {
        "type": "main",
        "className": "p-0",
        "children": {
          "dialog-shell": {
            "type": "container",
            "className": "w-full"
          }
        }
      }
    }
  },
  "nodes": {
    "dialog-shell": [
      {
        "type": "form-input",
        "name": "唯一编码",
        "placeholder": "例如：help_center",
        "value": "form.code",
        "mode": "form",
        "info": "用于稳定读取链接。服务条款使用 terms_of_service，隐私政策使用 privacy_policy。",
        "validate": [
          {
            "type": "required",
            "message": "唯一编码不能为空。"
          },
          {
            "type": "pattern",
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "message": "只能以小写字母开头，并包含小写字母、数字或下划线。"
          }
        ],
        "meta": {
          "formLayout": "horizontal",
          "controlClassName": "max-w-md"
        }
      },
      {
        "type": "form-input",
        "name": "名称",
        "placeholder": "例如：帮助中心",
        "value": "form.name",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "名称不能为空。"
          }
        ],
        "meta": {
          "formLayout": "horizontal"
        }
      },
      {
        "type": "form-checkbox",
        "name": "使用场景",
        "value": "form.scene_ids",
        "mode": "form",
        "option": "option.scene",
        "info": "可多选，也可不选。协议条款由唯一编码识别，不需要选择场景。",
        "meta": {
          "formLayout": "horizontal",
          "orientation": "horizontal"
        }
      },
      {
        "type": "form-radio",
        "name": "链接类型",
        "value": "form.link_type",
        "mode": "form",
        "meta": {
          "formLayout": "horizontal",
          "controlClassName": "gap-x-5",
          "clearOnChange": [
            "form.article_id",
            "form.url"
          ]
        }
      },
      {
        "type": "form-cascader",
        "name": "内容",
        "placeholder": "请选择分类和内容",
        "value": "form.article_id",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "请选择分类和内容。",
            "when": [
              {
                "path": "form.link_type",
                "operator": "equals",
                "value": "article"
              }
            ]
          }
        ],
        "meta": {
          "childParentField": "category_id",
          "childLabelField": "title",
          "valueMode": "leaf",
          "placeholder": [
            "选择分类",
            "选择内容"
          ],
          "searchPlaceholder": [
            "搜索分类",
            "搜索内容"
          ],
          "childExtraFields": "title,category_id,status",
          "order": "sort asc,id asc",
          "childOrder": "sort asc,id desc",
          "formLayout": "horizontal",
          "controlClassName": "max-w-md",
          "model": "bot.body.NewContentCategoryModel",
          "childModel": "bot.body.NewContentArticleModel",
          "showWhen": [
            {
              "path": "form.link_type",
              "operator": "equals",
              "value": "article"
            }
          ]
        }
      },
      {
        "type": "form-input",
        "name": "链接地址",
        "placeholder": "https://example.com/docs",
        "value": "form.url",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "链接地址不能为空。",
            "when": [
              {
                "path": "form.link_type",
                "operator": "equals",
                "value": "url"
              }
            ]
          }
        ],
        "meta": {
          "formLayout": "horizontal",
          "showWhen": [
            {
              "path": "form.link_type",
              "operator": "equals",
              "value": "url"
            }
          ]
        }
      },
      {
        "type": "form-radio",
        "name": "打开方式",
        "value": "form.target",
        "mode": "form",
        "info": "内容文章选择当前窗口时，在工作台右侧打开；选择新窗口时，打开独立阅读页。",
        "meta": {
          "formLayout": "horizontal",
          "controlClassName": "gap-x-5"
        }
      }
    ]
  },
  "data": {
    "form": {
      "id": 0,
      "code": "",
      "name": "",
      "scene_ids": [],
      "link_type": "url",
      "article_id": 0,
      "url": "",
      "target": "_blank",
      "status": 1,
      "sort": 100
    }
  },
  "state": {},
  "action": {
    "submit": {
      "type": "save",
      "params": "form",
      "data": {
        "id": "$form.id",
        "code": "$form.code",
        "name": "$form.name",
        "scene_ids": "$form.scene_ids",
        "link_type": "$form.link_type",
        "article_id": "$form.article_id",
        "url": "$form.url",
        "target": "$form.target",
        "status": "$form.status",
        "sort": "$form.sort"
      },
      "before": {
        "service": "bot.body.LinkHook.BeforeSaveLink"
      }
    }
  }
}
