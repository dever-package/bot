{
  "page": {
    "name": "三方账号编辑",
    "parent": "bot/body/config/set",
    "type": 2,
    "auth": [
      {
        "key": "bot/body/account/create",
        "name": "三方账号新增",
        "query": {
          "id": "empty"
        }
      },
      {
        "key": "bot/body/account/update",
        "name": "三方账号编辑",
        "query": {
          "id": "required"
        }
      }
    ]
  },
  "layout": {
    "type": "container",
    "children": {
      "page-main": {
        "type": "main",
        "className": "p-0",
        "children": {
          "dialog-shell": {
            "type": "container",
            "className": "w-full"
          }
        }
      }
    }
  },
  "nodes": {
    "dialog-shell": [
      {
        "type": "form-radio",
        "name": "类型",
        "value": "form.provider",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "请选择账号类型。"
          }
        ],
        "meta": {
          "formLayout": "horizontal",
          "controlClassName": "max-w-[260px]"
        }
      },
      {
        "type": "form-input",
        "name": "按钮名称",
        "placeholder": "例如：使用飞书账户继续",
        "value": "form.name",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "按钮名称不能为空。"
          }
        ],
        "meta": {
          "formLayout": "horizontal"
        }
      },
      {
        "type": "form-array",
        "name": "账号配置",
        "value": "form.configs",
        "mode": "form",
        "info": "按 Key / Value 维护当前账号类型所需配置。App Secret 会加密保存，编辑时留空表示保留原值。",
        "meta": {
          "pageRoute": "/bot/body/account_config/update",
          "addText": "添加配置",
          "itemName": "配置项",
          "formLayout": "horizontal"
        }
      },
      {
        "type": "form-upload",
        "name": "按钮图标",
        "value": "form.icon",
        "mode": "form",
        "info": "不上传时登录页使用默认三方账号图标。",
        "meta": {
          "formLayout": "horizontal",
          "uploadType": "pic",
          "kind": "image",
          "saveMode": "url",
          "ruleId": 1,
          "bizKey": "body.account.icon",
          "bizName": "Body三方账号图标",
          "maxCount": 1
        }
      }
    ]
  },
  "data": {
    "form": {
      "model": "bot.body.NewAccountModel",
      "service": "bot.body.AccountHook.AttachAccountForm",
      "_fields": [
        "provider",
        "name",
        "icon",
        "configs"
      ],
      "id": 0,
      "provider": "feishu",
      "name": "",
      "icon": "",
      "configs": [
        {
          "id": 0,
          "account_id": 0,
          "key": "app_id",
          "value": ""
        },
        {
          "id": 0,
          "account_id": 0,
          "key": "app_secret",
          "value": ""
        }
      ]
    }
  },
  "state": {},
  "action": {
    "submit": {
      "type": "save",
      "params": "form",
      "before": {
        "service": "bot.body.AccountHook.BeforeSaveAccount"
      }
    }
  }
}
