{
  "page": {
    "name": "基础配置",
    "icon": "globe",
    "parent": "bot-body",
    "type": 1,
    "sort": 1
  },
  "layout": {
    "type": "container",
    "children": {
      "page-header": {
        "type": "header",
        "className": "gap-4",
        "children": {
          "header-actions": {
            "type": "row",
            "className": "ms-auto shrink-0 flex-nowrap items-center gap-2"
          }
        }
      },
      "page-main": {
        "type": "main",
        "className": "flex flex-1 flex-col gap-5 sm:gap-6",
        "children": {
          "config-shell": {
            "type": "container",
            "className": "flex min-w-0 flex-col items-stretch gap-6 lg:flex-row",
            "children": {
              "tabs-column": {
                "type": "container",
                "className": "w-44 shrink-0"
              },
              "content-column": {
                "type": "container",
                "className": "min-w-0 flex-1 rounded-md border bg-background p-6",
                "children": {
                  "site-panel": {
                    "type": "container",
                    "className": "w-full"
                  },
                  "workbench-panel": {
                    "type": "container",
                    "className": "w-full"
                  },
                  "login-panel": {
                    "type": "container",
                    "className": "w-full"
                  },
                  "functions-panel": {
                    "type": "container",
                    "className": "flex min-w-0 flex-col gap-5 overflow-hidden"
                  },
                  "accounts-panel": {
                    "type": "container",
                    "className": "min-w-0 overflow-hidden"
                  }
                }
              }
            }
          },
          "feedback-shell": {
            "type": "container"
          }
        }
      }
    }
  },
  "nodes": {
    "page-header": [
      {
        "type": "show-title",
        "value": "page",
        "className": "min-w-0 flex-1"
      }
    ],
    "header-actions": [
      {
        "type": "show-button",
        "name": "保存设置",
        "className": "shrink-0",
        "meta": {
          "tab": ["site", "workbench", "login", "functions"],
          "variant": "default",
          "size": "sm",
          "icon": "save",
          "validateForm": true,
          "loadingText": "保存中...",
          "successMessage": "设置已保存"
        },
        "action": {
          "click": "submit"
        }
      },
      {
        "type": "show-button",
        "name": "新增账号入口",
        "className": "shrink-0",
        "meta": {
          "tab": "accounts",
          "variant": "default",
          "size": "sm",
          "icon": "plus"
        },
        "action": {
          "click": {
            "type": "modal",
            "key": "dialog.createAccount",
            "value": true
          }
        }
      }
    ],
    "tabs-column": [
      {
        "type": "nav-tab",
        "meta": {
          "target": "state.currentTab",
          "variant": "sidebar",
          "tabs": [
            {
              "label": "站点配置",
              "value": "site"
            },
            {
              "label": "工作台设置",
              "value": "workbench"
            },
            {
              "label": "登录页设置",
              "value": "login"
            },
            {
              "label": "功能列表",
              "value": "functions"
            },
            {
              "label": "三方账号",
              "value": "accounts"
            }
          ]
        }
      }
    ],
    "site-panel": [
      {
        "type": "form-input",
        "name": "站点名称",
        "placeholder": "例如：神创工作台",
        "value": "form.site_name",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "站点名称不能为空。"
          }
        ],
        "meta": {
          "tab": "site",
          "formLayout": "horizontal",
          "controlClassName": "max-w-xl"
        }
      },
      {
        "type": "form-upload",
        "name": "站点 Logo",
        "value": "form.logo",
        "mode": "form",
        "info": "用于登录页和 Body 工作台左上角品牌区域。",
        "meta": {
          "tab": "site",
          "formLayout": "horizontal",
          "uploadType": "pic",
          "kind": "image",
          "saveMode": "url",
          "ruleId": 1,
          "bizKey": "body.config.logo",
          "bizName": "Body站点Logo",
          "maxCount": 1
        }
      },
      {
        "type": "form-upload",
        "name": "站点 Favicon",
        "value": "form.favicon",
        "mode": "form",
        "info": "用于浏览器标签页和收藏夹，推荐上传正方形 PNG 或 SVG。",
        "meta": {
          "tab": "site",
          "formLayout": "horizontal",
          "uploadType": "pic",
          "kind": "image",
          "saveMode": "url",
          "ruleId": 1,
          "bizKey": "body.config.favicon",
          "bizName": "Body站点图标",
          "maxCount": 1
        }
      },
      {
        "type": "form-color",
        "name": "基础配色",
        "placeholder": "例如：#96a29c",
        "value": "form.base_color",
        "mode": "form",
        "info": "用于生成登录页、工作台和画布的基础背景、表面、边框与文字色；留空使用系统默认值。",
        "validate": [
          {
            "type": "pattern",
            "pattern": "^$|^#[0-9a-fA-F]{6}$",
            "message": "基础配色必须是 # 开头的 6 位十六进制颜色。"
          }
        ],
        "meta": {
          "tab": "site",
          "formLayout": "horizontal",
          "controlClassName": "max-w-xs",
          "pickerDefault": "#96a29c"
        }
      },
      {
        "type": "form-color",
        "name": "品牌主色",
        "placeholder": "例如：#1c6548",
        "value": "form.brand_primary_color",
        "mode": "form",
        "info": "可选。作为登录页、工作台和画布的统一强调色；留空使用原来的默认墨绿。",
        "validate": [
          {
            "type": "pattern",
            "pattern": "^$|^#[0-9a-fA-F]{6}$",
            "message": "品牌主色必须是 # 开头的 6 位十六进制颜色。"
          }
        ],
        "meta": {
          "tab": "site",
          "formLayout": "horizontal",
          "controlClassName": "max-w-xs",
          "pickerDefault": "#1c6548"
        }
      },
      {
        "type": "form-editor",
        "name": "底部备案内容",
        "placeholder": "填写企业名称、备案号和相关链接。",
        "value": "form.filing_content",
        "mode": "form",
        "info": "登录页底部和工作台共用此内容。建议使用一行文字与链接，不要插入图片、音视频或表格。",
        "meta": {
          "tab": "site",
          "formLayout": "vertical",
          "minHeight": 180,
          "maxHeight": 320
        }
      }
    ],
    "workbench-panel": [
      {
        "type": "form-radio",
        "name": "工作台模板",
        "value": "form.workbench_template",
        "mode": "form",
        "info": "只调整工作台导航与内容框架，创作、对话、工具和资产功能继续复用。",
        "validate": [
          {
            "type": "required",
            "message": "请选择工作台模板。"
          }
        ],
        "meta": {
          "tab": "workbench",
          "formLayout": "horizontal",
          "controlClassName": "gap-x-5"
        }
      },
      {
        "type": "form-upload",
        "name": "工作台背景图",
        "value": "form.workbench_background_image",
        "mode": "form",
        "info": "用于工作台外层背景，内容区域会保留半透明主题表面以保证可读性。",
        "meta": {
          "tab": "workbench",
          "formLayout": "horizontal",
          "uploadType": "pic",
          "kind": "image",
          "saveMode": "url",
          "ruleId": 1,
          "bizKey": "body.config.workbench_background_image",
          "bizName": "Body工作台背景图",
          "maxCount": 1
        }
      },
      {
        "type": "form-color",
        "name": "工作台底色",
        "placeholder": "例如：#f4f6f5",
        "value": "form.workbench_background_color",
        "mode": "form",
        "info": "可选。铺满工作台底层，导航和内容区会叠加半透明基础表面；留空使用基础配色。",
        "validate": [
          {
            "type": "pattern",
            "pattern": "^$|^#[0-9a-fA-F]{6}$",
            "message": "工作台底色必须是 # 开头的 6 位十六进制颜色。"
          }
        ],
        "meta": {
          "tab": "workbench",
          "formLayout": "horizontal",
          "controlClassName": "max-w-xs",
          "pickerDefault": "#f4f6f5"
        }
      }
    ],
    "login-panel": [
      {
        "type": "form-input",
        "name": "登录页标题",
        "placeholder": "例如：把想法变成作品",
        "value": "form.login_title",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "登录页标题不能为空。"
          }
        ],
        "meta": {
          "tab": "login",
          "formLayout": "horizontal",
          "controlClassName": "max-w-xl"
        }
      },
      {
        "type": "form-textarea",
        "name": "登录页说明",
        "placeholder": "说明 Body 工作台的主要用途。",
        "value": "form.login_description",
        "mode": "form",
        "meta": {
          "tab": "login",
          "formLayout": "horizontal",
          "controlClassName": "max-w-xl",
          "rows": 4
        }
      },
      {
        "type": "form-switch",
        "name": "开放注册",
        "value": "form.register_status",
        "mode": "form",
        "info": "关闭后登录页不显示注册入口，登录页注册请求也会被拒绝。",
        "meta": {
          "tab": "login",
          "trueValue": 1,
          "falseValue": 2,
          "formLayout": "horizontal"
        }
      },
      {
        "type": "form-radio",
        "name": "登录页模板",
        "value": "form.login_template",
        "mode": "form",
        "info": "切换登录页外层布局，账号、三方登录和单页链接保持不变。",
        "validate": [
          {
            "type": "required",
            "message": "请选择登录页模板。"
          }
        ],
        "meta": {
          "tab": "login",
          "formLayout": "horizontal",
          "controlClassName": "gap-x-5"
        }
      },
      {
        "type": "form-color",
        "name": "登录页文案颜色",
        "placeholder": "例如：#ffffff",
        "value": "form.login_text_color",
        "mode": "form",
        "info": "可选。控制登录页标题和说明；留空时有背景图自动使用白色，无背景图使用基础配色文字色。",
        "validate": [
          {
            "type": "pattern",
            "pattern": "^$|^#[0-9a-fA-F]{6}$",
            "message": "登录页文案颜色必须是 # 开头的 6 位十六进制颜色。"
          }
        ],
        "meta": {
          "tab": "login",
          "formLayout": "horizontal",
          "controlClassName": "max-w-xs",
          "pickerDefault": "#ffffff"
        }
      },
      {
        "type": "form-upload",
        "name": "登录页背景图",
        "value": "form.login_background_image",
        "mode": "form",
        "info": "铺满登录页背景；未上传时不显示背景图。",
        "meta": {
          "tab": "login",
          "formLayout": "horizontal",
          "uploadType": "pic",
          "kind": "image",
          "saveMode": "url",
          "ruleId": 1,
          "bizKey": "body.config.login_background_image",
          "bizName": "Body登录页背景图",
          "maxCount": 1
        }
      },
      {
        "type": "form-color",
        "name": "登录页底色",
        "placeholder": "例如：#fbfcfb",
        "value": "form.login_background_color",
        "mode": "form",
        "info": "可选。作为登录页底层颜色；与背景图同时设置时用于图片加载前和透明区域。",
        "validate": [
          {
            "type": "pattern",
            "pattern": "^$|^#[0-9a-fA-F]{6}$",
            "message": "登录页底色必须是 # 开头的 6 位十六进制颜色。"
          }
        ],
        "meta": {
          "tab": "login",
          "formLayout": "horizontal",
          "controlClassName": "max-w-xs",
          "pickerDefault": "#fbfcfb"
        }
      },
      {
        "type": "form-upload",
        "name": "登录页介绍图",
        "value": "form.login_image",
        "mode": "form",
        "info": "用于分栏和品牌展示模板；未上传时不显示介绍图。",
        "meta": {
          "tab": "login",
          "formLayout": "horizontal",
          "uploadType": "pic",
          "kind": "image",
          "saveMode": "url",
          "ruleId": 1,
          "bizKey": "body.config.login_image",
          "bizName": "Body登录页介绍图",
          "maxCount": 1
        }
      }
    ],
    "functions-panel": [
      {
        "type": "show-table",
        "value": "functions.list",
        "meta": {
          "tab": "functions",
          "pagePath": "data.functions.page",
          "pageSizePath": "data.functions.pageSize",
          "totalPath": "data.functions.total",
          "remote": true,
          "externalPagination": true,
          "reloadDataKey": "functions",
          "savePath": "bot/body/function/update",
          "rowKey": "id",
          "columns": [
            {
              "name": "固定入口",
              "value": "code",
              "type": "show-tag"
            },
            {
              "name": "显示名称",
              "value": "name",
              "type": "show-base"
            },
            {
              "name": "系统图标",
              "value": "icon",
              "type": "show-icon"
            },
            {
              "name": "状态",
              "value": "status",
              "type": "form-switch",
              "meta": {
                "trueValue": 1,
                "falseValue": 2
              }
            },
            {
              "name": "排序",
              "value": "sort",
              "type": "show-base",
              "description": "双击数值可编辑；数值越小越靠前。",
              "editor": "form-number",
              "trigger": "doubleClick"
            },
            {
              "name": "创建时间",
              "value": "created_at",
              "type": "show-date"
            },
            {
              "name": "操作",
              "type": "show-button",
              "className": "w-[1%] whitespace-nowrap px-3 text-center",
              "meta": {
                "buttons": [
                  {
                    "icon": "square-pen",
                    "variant": "outline",
                    "size": "sm",
                    "description": "编辑功能",
                    "action": {
                      "click": [
                        {
                          "type": "data",
                          "key": "actionTarget.editFunctionId",
                          "value": "$row.id"
                        },
                        {
                          "type": "modal",
                          "key": "dialog.editFunction",
                          "value": true
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "type": "show-page",
        "meta": {
          "tab": "functions",
          "reloadDataKey": "functions"
        }
      }
    ],
    "accounts-panel": [
      {
        "type": "show-table",
        "value": "accounts.list",
        "meta": {
          "tab": "accounts",
          "pagePath": "data.accounts.page",
          "pageSizePath": "data.accounts.pageSize",
          "totalPath": "data.accounts.total",
          "remote": true,
          "externalPagination": true,
          "reloadDataKey": "accounts",
          "savePath": "bot/body/account/update",
          "rowKey": "id",
          "columns": [
            {
              "name": "类型",
              "value": "provider",
              "type": "show-tag"
            },
            {
              "name": "按钮名称",
              "value": "name",
              "type": "show-base"
            },
            {
              "value": "icon",
              "name": "图标",
              "type": "show-base"
            },
            {
              "name": "状态",
              "value": "status",
              "type": "form-switch",
              "meta": {
                "trueValue": 1,
                "falseValue": 2
              }
            },
            {
              "name": "排序",
              "value": "sort",
              "type": "show-base",
              "description": "双击数值可编辑；数值越小越靠前。",
              "editor": "form-number",
              "trigger": "doubleClick"
            },
            {
              "name": "创建时间",
              "value": "created_at",
              "type": "show-date"
            },
            {
              "name": "操作",
              "type": "show-button",
              "className": "w-[1%] whitespace-nowrap px-3 text-center",
              "meta": {
                "buttons": [
                  {
                    "icon": "square-pen",
                    "variant": "outline",
                    "size": "sm",
                    "description": "编辑账号入口",
                    "action": {
                      "click": [
                        {
                          "type": "data",
                          "key": "actionTarget.editAccountId",
                          "value": "$row.id"
                        },
                        {
                          "type": "modal",
                          "key": "dialog.editAccount",
                          "value": true
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "type": "show-page",
        "meta": {
          "tab": "accounts",
          "reloadDataKey": "accounts"
        }
      }
    ],
    "feedback-shell": [
      {
        "type": "feedback-modal",
        "meta": {
          "stateKey": "dialog.editFunction",
          "reloadDataKey": "functions",
          "pageRoute": "/bot/body/function/update",
          "pageRouteQuery": {
            "id": "data.actionTarget.editFunctionId"
          },
          "title": "编辑功能",
          "size": "lg",
          "footer": {
            "confirm": true,
            "confirmText": "保存"
          }
        }
      },
      {
        "type": "feedback-modal",
        "meta": {
          "stateKey": "dialog.createAccount",
          "reloadDataKey": "accounts",
          "pageRoute": "/bot/body/account/update",
          "title": "新增账号入口",
          "size": "lg",
          "footer": {
            "confirm": true,
            "confirmText": "保存"
          }
        }
      },
      {
        "type": "feedback-modal",
        "meta": {
          "stateKey": "dialog.editAccount",
          "reloadDataKey": "accounts",
          "pageRoute": "/bot/body/account/update",
          "pageRouteQuery": {
            "id": "data.actionTarget.editAccountId"
          },
          "title": "编辑账号入口",
          "size": "lg",
          "footer": {
            "confirm": true,
            "confirmText": "保存"
          }
        }
      }
    ]
  },
  "data": {
    "page": {
      "title": "基础配置",
      "description": "统一维护站点、底部备案内容、工作台、登录页、功能入口和三方账号。"
    },
    "form": {
      "id": 1,
      "_fields": [
        "site_name",
        "logo",
        "favicon",
        "base_color",
        "brand_primary_color",
        "workbench_template",
        "workbench_background_image",
        "workbench_background_color",
        "login_title",
        "login_description",
        "register_status",
        "login_template",
        "login_text_color",
        "login_background_image",
        "login_background_color",
        "login_image",
        "filing_content"
      ],
      "site_name": "神创工作台",
      "logo": "",
      "favicon": "",
      "base_color": "#96a29c",
      "brand_primary_color": "",
      "workbench_template": "rail",
      "workbench_background_image": "",
      "workbench_background_color": "",
      "login_title": "把想法变成作品",
      "login_description": "调用团队能力，与智能体协作，把每一次创作沉淀为可复用的项目资产。",
      "register_status": 1,
      "login_template": "split",
      "login_text_color": "",
      "login_background_image": "",
      "login_background_color": "",
      "login_image": "",
      "filing_content": "",
      "model": "bot.body.NewConfigModel"
    },
    "accounts": {
      "model": "bot.body.NewAccountModel",
      "pageSize": 100,
      "order": "sort asc,id asc",
      "relationFields": []
    },
    "functions": {
      "model": "bot.body.NewFunctionModel",
      "pageSize": 100,
      "order": "sort asc,id asc"
    },
    "actionTarget": {
      "editAccountId": "",
      "editFunctionId": ""
    }
  },
  "state": {
    "currentTab": "site",
    "dialog": {
      "createAccount": false,
      "editAccount": false,
      "editFunction": false
    }
  },
  "action": {
    "submit": {
      "type": "save",
      "params": "form",
      "model": "bot.body.NewConfigModel"
    }
  }
}
