{
  "page": {
    "name": "基础配置",
    "icon": "settings-2",
    "parent": "bot-body",
    "type": 1,
    "sort": 1
  },
  "layout": {
    "type": "container",
    "children": {
      "page-header": {
        "type": "header",
        "className": "gap-4",
        "children": {
          "header-actions": {
            "type": "row",
            "className": "ms-auto shrink-0 flex-nowrap items-center gap-2"
          }
        }
      },
      "page-main": {
        "type": "main",
        "className": "flex flex-1 flex-col gap-5 sm:gap-6",
        "children": {
          "config-shell": {
            "type": "container",
            "className": "flex min-w-0 flex-col items-stretch gap-6 lg:flex-row",
            "children": {
              "tabs-column": {
                "type": "container",
                "className": "w-44 shrink-0"
              },
              "content-column": {
                "type": "container",
                "className": "min-w-0 flex-1 rounded-md border bg-background p-6",
                "children": {
                  "site-panel": {
                    "type": "container",
                    "className": "w-full"
                  },
                  "filing-panel": {
                    "type": "container",
                    "className": "w-full"
                  },
                  "accounts-panel": {
                    "type": "container",
                    "className": "min-w-0 overflow-hidden"
                  },
                  "home-menu-panel": {
                    "type": "container",
                    "className": "w-full"
                  },
                  "links-panel": {
                    "type": "container",
                    "className": "min-w-0 overflow-hidden"
                  }
                }
              }
            }
          },
          "feedback-shell": {
            "type": "container"
          }
        }
      }
    }
  },
  "nodes": {
    "page-header": [
      {
        "type": "show-title",
        "value": "page",
        "className": "min-w-0 flex-1"
      }
    ],
    "header-actions": [
      {
        "type": "show-button",
        "name": "保存配置",
        "className": "shrink-0",
        "meta": {
          "tab": "site",
          "variant": "default",
          "size": "sm",
          "icon": "save",
          "validateForm": true,
          "loadingText": "保存中...",
          "successMessage": "配置已保存"
        },
        "action": {
          "click": "submit"
        }
      },
      {
        "type": "show-button",
        "name": "保存首页菜单",
        "className": "shrink-0",
        "meta": {
          "tab": "home_menu",
          "variant": "default",
          "size": "sm",
          "icon": "save",
          "validateForm": true,
          "loadingText": "保存中...",
          "successMessage": "首页菜单已保存"
        },
        "action": {
          "click": "submit"
        }
      },
      {
        "type": "show-button",
        "name": "保存备案信息",
        "className": "shrink-0",
        "meta": {
          "tab": "filing",
          "variant": "default",
          "size": "sm",
          "icon": "save",
          "loadingText": "保存中...",
          "successMessage": "备案信息已保存"
        },
        "action": {
          "click": "submit"
        }
      },
      {
        "type": "show-button",
        "name": "新增登录页菜单",
        "className": "shrink-0",
        "meta": {
          "tab": "links",
          "variant": "default",
          "size": "sm",
          "icon": "plus"
        },
        "action": {
          "click": {
            "type": "modal",
            "key": "dialog.createLink",
            "value": true
          }
        }
      },
      {
        "type": "show-button",
        "name": "新增账号入口",
        "className": "shrink-0",
        "meta": {
          "tab": "accounts",
          "variant": "default",
          "size": "sm",
          "icon": "plus"
        },
        "action": {
          "click": {
            "type": "modal",
            "key": "dialog.createAccount",
            "value": true
          }
        }
      }
    ],
    "tabs-column": [
      {
        "type": "nav-tab",
        "meta": {
          "target": "state.currentTab",
          "variant": "sidebar",
          "tabs": [
            {
              "label": "站点设置",
              "value": "site"
            },
            {
              "label": "备案信息",
              "value": "filing"
            },
            {
              "label": "三方账号",
              "value": "accounts"
            },
            {
              "label": "首页菜单",
              "value": "home_menu"
            },
            {
              "label": "登录页菜单",
              "value": "links"
            }
          ]
        }
      }
    ],
    "site-panel": [
      {
        "type": "form-input",
        "name": "站点名称",
        "placeholder": "例如：神创工作台",
        "value": "form.site_name",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "站点名称不能为空。"
          }
        ],
        "meta": {
          "tab": "site",
          "formLayout": "horizontal",
          "controlClassName": "max-w-xl"
        }
      },
      {
        "type": "form-upload",
        "name": "站点 Logo",
        "value": "form.logo",
        "mode": "form",
        "info": "用于登录页和 Body 工作台左上角品牌区域。",
        "meta": {
          "tab": "site",
          "formLayout": "horizontal",
          "uploadType": "pic",
          "kind": "image",
          "saveMode": "url",
          "ruleId": 1,
          "bizKey": "body.config.logo",
          "bizName": "Body站点Logo",
          "maxCount": 1
        }
      },
      {
        "type": "form-upload",
        "name": "站点图标",
        "value": "form.favicon",
        "mode": "form",
        "info": "用于浏览器标签页，推荐上传正方形 PNG 或 SVG。",
        "meta": {
          "tab": "site",
          "formLayout": "horizontal",
          "uploadType": "pic",
          "kind": "image",
          "saveMode": "url",
          "ruleId": 1,
          "bizKey": "body.config.favicon",
          "bizName": "Body站点图标",
          "maxCount": 1
        }
      },
      {
        "type": "form-upload",
        "name": "登录页图片",
        "value": "form.login_image",
        "mode": "form",
        "info": "用于登录页左侧展示；未上传时使用系统默认图片。",
        "meta": {
          "tab": "site",
          "formLayout": "horizontal",
          "uploadType": "pic",
          "kind": "image",
          "saveMode": "url",
          "ruleId": 1,
          "bizKey": "body.config.login_image",
          "bizName": "Body登录页图片",
          "maxCount": 1
        }
      },
      {
        "type": "form-input",
        "name": "登录页标题",
        "placeholder": "例如：把想法变成作品",
        "value": "form.login_title",
        "mode": "form",
        "validate": [
          {
            "type": "required",
            "message": "登录页标题不能为空。"
          }
        ],
        "meta": {
          "tab": "site",
          "formLayout": "horizontal",
          "controlClassName": "max-w-xl"
        }
      },
      {
        "type": "form-textarea",
        "name": "登录页说明",
        "placeholder": "说明 Body 工作台的主要用途。",
        "value": "form.login_description",
        "mode": "form",
        "meta": {
          "tab": "site",
          "formLayout": "horizontal",
          "controlClassName": "max-w-xl",
          "rows": 4
        }
      }
    ],
    "home-menu-panel": [
      {
        "type": "bot-body-home-menu-editor",
        "meta": {
          "tab": "home_menu"
        }
      }
    ],
    "filing-panel": [
      {
        "type": "form-input",
        "name": "企业名称",
        "placeholder": "营业执照上的企业名称",
        "value": "form.company_name",
        "mode": "form",
        "meta": {
          "tab": "filing",
          "formLayout": "horizontal",
          "controlClassName": "max-w-xl"
        }
      },
      {
        "type": "form-textarea",
        "name": "企业地址",
        "placeholder": "企业注册地址或经营地址",
        "value": "form.company_address",
        "mode": "form",
        "meta": {
          "tab": "filing",
          "formLayout": "horizontal",
          "controlClassName": "max-w-xl",
          "rows": 3
        }
      },
      {
        "type": "form-input",
        "name": "营业执照链接",
        "placeholder": "https://...",
        "value": "form.business_license_url",
        "mode": "form",
        "meta": {
          "tab": "filing",
          "formLayout": "horizontal",
          "controlClassName": "max-w-xl"
        }
      },
      {
        "type": "form-input",
        "name": "ICP备案号",
        "placeholder": "例如：京ICP备XXXXXXXX号",
        "value": "form.icp_record",
        "mode": "form",
        "meta": {
          "tab": "filing",
          "formLayout": "horizontal",
          "controlClassName": "max-w-xl"
        }
      },
      {
        "type": "form-input",
        "name": "ICP备案链接",
        "placeholder": "https://beian.miit.gov.cn/",
        "value": "form.icp_record_url",
        "mode": "form",
        "meta": {
          "tab": "filing",
          "formLayout": "horizontal",
          "controlClassName": "max-w-xl"
        }
      },
      {
        "type": "form-input",
        "name": "公安备案号",
        "placeholder": "例如：京公网安备XXXXXXXXXXXXXX号",
        "value": "form.public_security_record",
        "mode": "form",
        "meta": {
          "tab": "filing",
          "formLayout": "horizontal",
          "controlClassName": "max-w-xl"
        }
      },
      {
        "type": "form-input",
        "name": "公安备案链接",
        "placeholder": "https://www.beian.gov.cn/...",
        "value": "form.public_security_record_url",
        "mode": "form",
        "meta": {
          "tab": "filing",
          "formLayout": "horizontal",
          "controlClassName": "max-w-xl"
        }
      }
    ],
    "links-panel": [
      {
        "type": "show-table",
        "value": "links.list",
        "meta": {
          "tab": "links",
          "pagePath": "data.links.page",
          "pageSizePath": "data.links.pageSize",
          "totalPath": "data.links.total",
          "remote": true,
          "externalPagination": true,
          "reloadDataKey": "links",
          "savePath": "bot/body/link/update",
          "rowKey": "id",
          "columns": [
            {
              "name": "名称",
              "value": "name",
              "type": "show-base"
            },
            {
              "name": "链接地址",
              "value": "url",
              "type": "show-base"
            },
            {
              "name": "打开方式",
              "value": "target",
              "type": "show-tag"
            },
            {
              "name": "状态",
              "value": "status",
              "type": "form-switch",
              "meta": {
                "trueValue": 1,
                "falseValue": 2
              }
            },
            {
              "name": "排序",
              "value": "sort",
              "type": "show-base",
              "description": "双击数值可编辑；数值越小越靠前。",
              "editor": "form-number",
              "trigger": "doubleClick"
            },
            {
              "name": "创建时间",
              "value": "created_at",
              "type": "show-date"
            },
            {
              "name": "操作",
              "type": "show-button",
              "className": "w-[1%] whitespace-nowrap px-3 text-center",
              "meta": {
                "buttons": [
                  {
                    "icon": "square-pen",
                    "variant": "outline",
                    "size": "sm",
                    "description": "编辑登录页菜单",
                    "action": {
                      "click": [
                        {
                          "type": "data",
                          "key": "actionTarget.editLinkId",
                          "value": "$row.id"
                        },
                        {
                          "type": "modal",
                          "key": "dialog.editLink",
                          "value": true
                        }
                      ]
                    }
                  },
                  {
                    "icon": "trash-2",
                    "variant": "outline",
                    "size": "sm",
                    "description": "删除菜单",
                    "action": {
                      "click": [
                        {
                          "type": "data",
                          "key": "actionTarget.deleteLink",
                          "value": "$row"
                        },
                        {
                          "type": "modal",
                          "key": "confirm.deleteLink",
                          "value": true
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "type": "show-page",
        "meta": {
          "tab": "links",
          "reloadDataKey": "links"
        }
      }
    ],
    "accounts-panel": [
      {
        "type": "show-table",
        "value": "accounts.list",
        "meta": {
          "tab": "accounts",
          "pagePath": "data.accounts.page",
          "pageSizePath": "data.accounts.pageSize",
          "totalPath": "data.accounts.total",
          "remote": true,
          "externalPagination": true,
          "reloadDataKey": "accounts",
          "savePath": "bot/body/account/update",
          "rowKey": "id",
          "columns": [
            {
              "name": "类型",
              "value": "provider",
              "type": "show-tag"
            },
            {
              "name": "按钮名称",
              "value": "name",
              "type": "show-base"
            },
            {
              "value": "icon",
              "name": "图标",
              "type": "show-base"
            },
            {
              "name": "状态",
              "value": "status",
              "type": "form-switch",
              "meta": {
                "trueValue": 1,
                "falseValue": 2
              }
            },
            {
              "name": "排序",
              "value": "sort",
              "type": "show-base",
              "description": "双击数值可编辑；数值越小越靠前。",
              "editor": "form-number",
              "trigger": "doubleClick"
            },
            {
              "name": "创建时间",
              "value": "created_at",
              "type": "show-date"
            },
            {
              "name": "操作",
              "type": "show-button",
              "className": "w-[1%] whitespace-nowrap px-3 text-center",
              "meta": {
                "buttons": [
                  {
                    "icon": "square-pen",
                    "variant": "outline",
                    "size": "sm",
                    "description": "编辑账号入口",
                    "action": {
                      "click": [
                        {
                          "type": "data",
                          "key": "actionTarget.editAccountId",
                          "value": "$row.id"
                        },
                        {
                          "type": "modal",
                          "key": "dialog.editAccount",
                          "value": true
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "type": "show-page",
        "meta": {
          "tab": "accounts",
          "reloadDataKey": "accounts"
        }
      }
    ],
    "feedback-shell": [
      {
        "type": "feedback-modal",
        "meta": {
          "stateKey": "dialog.createLink",
          "pageRoute": "/bot/body/link/update",
          "title": "新增登录页菜单",
          "size": "lg",
          "footer": {
            "confirm": true,
            "confirmText": "保存"
          }
        }
      },
      {
        "type": "feedback-modal",
        "meta": {
          "stateKey": "dialog.editLink",
          "pageRoute": "/bot/body/link/update",
          "pageRouteQuery": {
            "id": "data.actionTarget.editLinkId"
          },
          "title": "编辑登录页菜单",
          "size": "lg",
          "footer": {
            "confirm": true,
            "confirmText": "保存"
          }
        }
      },
      {
        "type": "feedback-confirm",
        "name": "删除登录页菜单",
        "info": "确认删除当前登录页菜单吗？",
        "meta": {
          "stateKey": "confirm.deleteLink"
        },
        "action": {
          "confirm": {
            "type": "delete",
            "model": "bot.body.NewLinkModel",
            "params": "actionTarget.deleteLink"
          }
        }
      },
      {
        "type": "feedback-modal",
        "meta": {
          "stateKey": "dialog.createAccount",
          "pageRoute": "/bot/body/account/update",
          "title": "新增账号入口",
          "size": "lg",
          "footer": {
            "confirm": true,
            "confirmText": "保存"
          }
        }
      },
      {
        "type": "feedback-modal",
        "meta": {
          "stateKey": "dialog.editAccount",
          "pageRoute": "/bot/body/account/update",
          "pageRouteQuery": {
            "id": "data.actionTarget.editAccountId"
          },
          "title": "编辑账号入口",
          "size": "lg",
          "footer": {
            "confirm": true,
            "confirmText": "保存"
          }
        }
      }
    ]
  },
  "data": {
    "page": {
      "title": "基础配置",
      "description": "维护 Body 站点品牌、备案信息、第三方账号、首页菜单和登录页菜单。"
    },
    "form": {
      "id": 1,
      "_fields": [
        "site_name",
        "logo",
        "favicon",
        "login_image",
        "login_title",
        "login_description",
        "company_name",
        "company_address",
        "business_license_url",
        "icp_record",
        "icp_record_url",
        "public_security_record",
        "public_security_record_url",
        "home_works_name",
        "home_works_icon",
        "home_works_status",
        "home_dialogue_name",
        "home_dialogue_icon",
        "home_dialogue_status",
        "home_function_name",
        "home_function_icon",
        "home_function_status",
        "home_assets_name",
        "home_assets_icon",
        "home_assets_status",
        "home_points_name",
        "home_points_icon",
        "home_points_status",
        "home_messages_name",
        "home_messages_icon",
        "home_messages_status"
      ],
      "site_name": "神创工作台",
      "logo": "",
      "favicon": "",
      "login_image": "",
      "login_title": "把想法变成作品",
      "login_description": "调用团队能力，与智能体协作，把每一次创作沉淀为可复用的项目资产。",
      "home_works_name": "创作",
      "home_works_icon": "file-stack",
      "home_works_status": 1,
      "home_dialogue_name": "对话",
      "home_dialogue_icon": "messages-square",
      "home_dialogue_status": 1,
      "home_function_name": "工具",
      "home_function_icon": "zap",
      "home_function_status": 1,
      "home_assets_name": "资产",
      "home_assets_icon": "archive",
      "home_assets_status": 1,
      "home_points_name": "积分",
      "home_points_icon": "sparkles",
      "home_points_status": 1,
      "home_messages_name": "消息",
      "home_messages_icon": "bell",
      "home_messages_status": 1,
      "company_name": "",
      "company_address": "",
      "business_license_url": "",
      "icp_record": "",
      "icp_record_url": "",
      "public_security_record": "",
      "public_security_record_url": "",
      "model": "bot.body.NewConfigModel"
    },
    "links": {
      "model": "bot.body.NewLinkModel",
      "pageSize": 100,
      "order": "sort asc,id asc"
    },
    "accounts": {
      "model": "bot.body.NewAccountModel",
      "pageSize": 100,
      "order": "sort asc,id asc",
      "relationFields": []
    },
    "actionTarget": {
      "editLinkId": "",
      "deleteLink": {},
      "editAccountId": ""
    }
  },
  "state": {
    "currentTab": "site",
    "dialog": {
      "createLink": false,
      "editLink": false,
      "createAccount": false,
      "editAccount": false
    },
    "confirm": {
      "deleteLink": false
    }
  },
  "action": {
    "submit": {
      "type": "save",
      "params": "form",
      "model": "bot.body.NewConfigModel"
    }
  }
}
