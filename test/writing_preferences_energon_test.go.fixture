package energon

import (
	"encoding/json"
	"reflect"
	"strings"
	"testing"

	botmodel "github.com/dever-package/bot/model/energon"
	botprotocol "github.com/dever-package/bot/service/energon/protocol"
)

func preferenceOutput(action string) map[string]any {
	entity := func() map[string]any {
		return map[string]any{"id": "", "name": "人物或场景", "description": "必要设定"}
	}
	switch action {
	case "planning_preferences":
		return map[string]any{"preferences": map[string]any{"genre": "现实", "style": "natural", "style_instructions": "简洁", "pov": "third_limited", "mode": "complete", "chapter_words": 1200, "planned_chapters": 2}}
	case "planning_direction":
		return map[string]any{"content": "因果推进及收束"}
	case "planning_background":
		return map[string]any{"world": "现代城市的现实约束", "locations": []any{entity()}, "props": []any{}}
	case "continuity":
		return map[string]any{"synopsis": "发生本章事件", "end_state": "结束状态", "facts": []any{}, "character_changes": []any{}, "threads": []any{}, "findings": []any{}}
	case "generate_inspirations":
		return map[string]any{"inspirations": []any{map[string]any{"id": "", "title": "灵感", "content": "具体故事方向"}}}
	case "generate_chapters", "append":
		return map[string]any{"units": []any{map[string]any{"id": "", "unit_type": "chapter", "title": "一章", "plan": "因果推进", "children": []any{}}}}
	case "outline_section":
		return map[string]any{"content": "当前大纲块"}
	case "chapter_plan":
		return map[string]any{"plan": "本章章纲"}
	case "section_entities":
		return map[string]any{"entities": []any{entity()}}
	case "propose_edit":
		return map[string]any{"replacement": "仅目标替换内容"}
	case "chapter_body":
		return map[string]any{"body": "她在门前停下。"}
	}
	panic("unknown test action")
}

func TestWritingPreferencesActionContractAgreement(t *testing.T) {
	for _, action := range []string{"generate_inspirations", "planning_preferences", "planning_direction", "planning_background", "continuity", "generate_chapters", "outline_section", "chapter_plan", "section_entities", "append", "propose_edit", "chapter_body"} {
		t.Run(action, func(t *testing.T) {
			contract, err := writingOutputContract(powerOutputContractContext{WritingAction: action})
			if err != nil {
				t.Fatal(err)
			}
			required := contract.Schema["required"].([]string)
			if !strings.Contains(contract.Prompt, "顶层必填且仅允许字段："+strings.Join(required, ", ")) || !strings.Contains(contract.Prompt, action) || !strings.Contains(contract.Prompt, "preferences") {
				t.Fatal("prompt, action and schema field names diverged")
			}
			output := preferenceOutput(action)
			if normalized, err := contract.Normalize(output, nil); err != nil || !reflect.DeepEqual(normalized, output) {
				t.Fatalf("valid shape changed or rejected: %v", err)
			}
			delete(output, required[0])
			output["unexpected"] = "不得静默丢弃"
			_, err = contract.Normalize(output, nil)
			if err == nil {
				t.Fatal("equal-length wrong field names accepted")
			}
			for _, detail := range []string{"动作 " + action, "result", "缺失字段 [" + required[0] + "]", "额外字段 [unexpected]"} {
				if !strings.Contains(err.Error(), detail) {
					t.Fatalf("missing diagnostic %s in %v", detail, err)
				}
			}
			for repeat := 0; repeat < 5; repeat++ {
				_, repeated := contract.Normalize(output, nil)
				if repeated.Error() != err.Error() {
					t.Fatal("field diagnostics not deterministic")
				}
			}
		})
	}
}

func TestWritingPreferencesNestedFieldAndTypeFailures(t *testing.T) {
	for _, scenario := range []struct{ name, action, path, detail string }{
		{"missing_nested", "planning_background", "result", "缺失字段 [world]"},
		{"extra_nested", "planning_background", "result.locations[0]", "额外字段 [age]"},
		{"wrong_type", "planning_background", "result.world", "必须为文字"},
		{"empty_description", "planning_background", "result.locations[0].description", "有效文字"},
		{"null_array", "planning_background", "result.props", "必须为列表"},
		{"fake_pointer", "generate_chapters", "result.units[0]", "额外字段 [asset_id]"},
		{"wrong_kind", "generate_chapters", "result.units[0].unit_type", "必须为 chapter"},
		{"child_plan", "generate_chapters", "result.units[0].children", "上限 0"},
		{"empty_body", "chapter_body", "body", "有效文字"},
	} {
		t.Run(scenario.name, func(t *testing.T) {
			contract, _ := writingOutputContract(powerOutputContractContext{WritingAction: scenario.action})
			output := preferenceOutput(scenario.action)
			switch scenario.name {
			case "missing_nested":
				delete(output, "world")
			case "extra_nested":
				output["locations"].([]any)[0].(map[string]any)["age"] = 20
			case "wrong_type":
				output["world"] = 32
			case "empty_description":
				output["locations"].([]any)[0].(map[string]any)["description"] = " "
			case "null_array":
				output["props"] = nil
			case "fake_pointer":
				output["units"].([]any)[0].(map[string]any)["asset_id"] = 81
			case "wrong_kind":
				output["units"].([]any)[0].(map[string]any)["unit_type"] = "episode"
			case "child_plan":
				output["units"].([]any)[0].(map[string]any)["children"] = []any{"scene"}
			case "empty_body":
				output["body"] = " "
			}
			_, err := contract.Normalize(output, nil)
			if err == nil || !strings.Contains(err.Error(), scenario.path) || !strings.Contains(err.Error(), scenario.detail) || !strings.Contains(err.Error(), scenario.action) {
				t.Fatalf("wrong diagnostic: %v", err)
			}
		})
	}
}

func TestWritingPreferencesActualToolSubmission(t *testing.T) {
	power := botmodel.Power{Name: "故事", Kind: "text", OutputType: botmodel.OutputTypeStory, Prompt: "通用能力的历史输出要求"}
	req := &botprotocol.ShemicRequest{WritingAction: "outline_section", Input: map[string]any{"prompt": "当前任务"}}
	if err := preparePowerRequest(req, power); err != nil {
		t.Fatal(err)
	}
	tool := req.Options["tools"].([]any)[0].(map[string]any)["function"].(map[string]any)
	if tool["strict"] != true || tool["name"] != "submit_output" || req.Options["parallel_tool_calls"] != false {
		t.Fatal("writing tool lost its strict submission contract")
	}
	role := botprotocol.AsText(req.Set["role"])
	if strings.Index(role, "当前动作 outline_section") < strings.Index(role, power.Prompt) {
		t.Fatal("current action contract is not applied after generic prompt")
	}
	submit := func(arguments map[string]any) (any, error) {
		encoded, _ := json.Marshal(arguments)
		return normalizePowerOutput(req, power, botprotocol.Output{"tool_calls": botprotocol.ToolCallsValue([]botprotocol.ToolCall{{Name: "submit_output", Arguments: string(encoded)}})})
	}
	result, err := submit(map[string]any{"content": "局部大纲"})
	if err != nil || result.(botprotocol.Output)["json"].(map[string]any)["content"] != "局部大纲" {
		t.Fatalf("actual tool extraction broke: %v", err)
	}
	result, err = submit(map[string]any{"outline": "错误的全局合同"})
	if err == nil || result != nil || !botprotocol.PreventsReplay(err) || !strings.Contains(err.Error(), "outline_section") || !strings.Contains(err.Error(), "缺失字段 [content]") || !strings.Contains(err.Error(), "额外字段 [outline]") {
		t.Fatalf("format failure was obscured or became replayable: %v", err)
	}
	_, err = normalizePowerOutput(req, power, botprotocol.Output{"text": `{"content":"没有提交工具"}`})
	if err == nil || !botprotocol.PreventsReplay(err) || !strings.Contains(err.Error(), "submit_output") {
		t.Fatal("plain text silently substituted for tool contract")
	}
}

func TestWritingPreferencesOutlineAndContinuityInstructions(t *testing.T) {
	direction, _ := writingOutputContract(powerOutputContractContext{WritingAction: "planning_direction"})
	if !strings.Contains(direction.Prompt, "不另写梗概、故事线或结构副本") {
		t.Fatal("duplicated planning returns")
	}
	contract, _ := writingOutputContract(powerOutputContractContext{WritingAction: "chapter_body"})
	for _, instruction := range []string{"actual_history", "知识必须有获取过程", "不复活已解线索", "软字数"} {
		if !strings.Contains(contract.Prompt, instruction) {
			t.Fatal("missing actual history boundary", instruction)
		}
	}
}
