package adapters

import (
	"context"
	"fmt"
	botmodel "github.com/dever-package/bot/model/energon"
	botprotocol "github.com/dever-package/bot/service/energon/protocol"
	botprovider "github.com/dever-package/bot/service/energon/provider"
	bottask "github.com/dever-package/bot/service/energon/task"
	"strings"
	"testing"
)

type recoveryClient struct {
	calls          int
	queue, history map[string]any
}

func (client *recoveryClient) Do(_ context.Context, request botprovider.Request) (*botprovider.Response, error) {
	client.calls++
	if request.Method != "GET" {
		return nil, fmt.Errorf("recovery submitted a new task")
	}
	body := client.queue
	if request.URL == "https://comfy.example.test/history?max_items=256" {
		body = client.history
	}
	return &botprovider.Response{StatusCode: 200, Body: body}, nil
}
func TestComfyUIRecovery(t *testing.T) {
	adapter := ComfyUIAdapter{}
	input := botprotocol.NativeInput{Request: &botprotocol.ShemicRequest{RequestID: "stable-client"}, Power: botmodel.Power{Kind: "image"}, Provider: botmodel.Provider{Host: "https://comfy.example.test"}, Account: botmodel.Account{Key: `{"username":"test","password":"test"}`}, ServiceEndpoint: botmodel.ServiceEndpoint{InterfaceType: botmodel.ServiceEndpointTypeWorkflowJSON, WorkflowJSON: `{"1":{"class_type":"EmptyImage","inputs":{"width":512,"height":512,"batch_size":1,"color":0}}}`}}
	native, err := adapter.BuildNativeRequest(input)
	if err != nil {
		t.Fatal(err)
	}
	row := []any{1, "original-task", native.Body["prompt"], map[string]any{"client_id": "stable-client"}, []any{"1"}}
	for _, state := range []string{"pending", "running", "history"} {
		t.Run(state, func(t *testing.T) {
			client := &recoveryClient{queue: map[string]any{"queue_pending": []any{}, "queue_running": []any{}}, history: map[string]any{}}
			if state == "history" {
				client.history["original-task"] = map[string]any{"prompt": row}
			} else {
				client.queue["queue_"+state] = []any{row}
			}
			id, err := adapter.LookupSubmission(context.Background(), input, client)
			if err != nil || id != "original-task" {
				t.Fatal(id, err)
			}
			if state != "history" {
				status, err := adapter.QueryQueueStatus(context.Background(), input, id, client)
				expected := bottask.TaskStatePending
				if state == "running" {
					expected = bottask.TaskStateRunning
				}
				if err != nil || status.State != expected || strings.Contains(strings.ToLower(status.Label), "comfy") {
					t.Fatal(status, err)
				}
			}
		})
	}
	t.Run("workflow mismatch cannot reuse identity", func(t *testing.T) {
		changed := append([]any(nil), row...)
		changed[2] = map[string]any{"different": true}
		client := &recoveryClient{queue: map[string]any{"queue_pending": []any{changed}}}
		if _, err := adapter.LookupSubmission(context.Background(), input, client); err == nil {
			t.Fatal("changed workflow accepted")
		}
	})
}
