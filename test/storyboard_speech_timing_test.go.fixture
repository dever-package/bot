func TestStoryboardContinuityReviewSheetShowsMidShotChange(t *testing.T) {
	ffmpegPath, err := exec.LookPath("ffmpeg")
	if err != nil {
		t.Skip("ffmpeg unavailable")
	}
	ctx := context.Background()
	dir := t.TempDir()
	video := filepath.Join(dir, "scene.mp4")
	cmd := exec.CommandContext(ctx, ffmpegPath, "-hide_banner", "-loglevel", "error",
		"-f", "lavfi", "-i", "color=red:s=90x160:r=24:d=2",
		"-f", "lavfi", "-i", "color=blue:s=90x160:r=24:d=1",
		"-f", "lavfi", "-i", "color=red:s=90x160:r=24:d=2",
		"-filter_complex", "concat=n=3:v=1:a=0", "-c:v", "libx264", "-threads", "1", video)
	if raw, err := cmd.CombinedOutput(); err != nil {
		t.Fatalf("create test video: %v: %s", err, raw)
	}
	output := filepath.Join(dir, "review.jpg")
	times := videoReviewSampleTimes(0, 5)
	if err := writeFFmpegVideoReviewSheet(ctx, ffmpegPath, video, output, times); err != nil {
		t.Fatal(err)
	}
	file, err := os.Open(output)
	if err != nil {
		t.Fatal(err)
	}
	defer file.Close()
	sheet, err := jpeg.Decode(file)
	if err != nil {
		t.Fatal(err)
	}
	width, height := sheet.Bounds().Dx()/3, sheet.Bounds().Dy()/4
	for index, seconds := range times {
		red, _, blue, _ := sheet.At(index%3*width+width/2, index/3*height+height/2).RGBA()
		if seconds >= 2 && seconds < 3 {
			if blue < 50000 || red > 10000 {
				t.Fatalf("middle sample %.2fs lost the observed change: red %d blue %d", seconds, red, blue)
			}
		} else if red < 50000 || blue > 10000 {
			t.Fatalf("sample %.2fs has the wrong state: red %d blue %d", seconds, red, blue)
		}
	}
}

func TestStoryboardContinuitySpeechKeepsWordsAndUsesFinalCutTimes(t *testing.T) {
	cache := newFFmpegProbeCache("")
	for path, seconds := range map[string]float64{"first.wav": 2.5, "second.wav": 1, "n1.wav": 2, "n2.wav": 2.5} {
		cache.results[path] = ffmpegProbeResult{probe: ffmpegMediaProbe{HasAudio: true, Duration: seconds}}
	}
	composition := ffmpegComposition{
		Clips: []ffmpegCompositionClip{
			{ID: "a", Duration: 4, SpeechTracks: []ffmpegCompositionSpeech{{ID: "first", Audio: "first.wav", StartTime: 2, Fit: "strict"}}, TransitionToNext: ffmpegCompositionTransition{Type: "fade", DurationMS: 600}},
			{ID: "b", Duration: 4, SpeechTracks: []ffmpegCompositionSpeech{{ID: "second", Audio: "second.wav", StartTime: .2, Fit: "strict"}}},
			{ID: "c", Duration: 2},
		},
		AudioTracks: []ffmpegCompositionGlobalAudio{
			{ID: "n1", Audio: "n1.wav", Kind: "narration", Fit: "strict", StartTime: 7.7, ShotID: "b", ShotStart: 3},
			{ID: "n2", Audio: "n2.wav", Kind: "narration", Fit: "strict", StartTime: 9, ShotID: "c", ShotStart: .5},
		},
	}
	if err := planFFmpegStoryboardSpeech(context.Background(), cache, &composition); err != nil {
		t.Fatal(err)
	}
	closeEnough := func(got, want float64) bool { return math.Abs(got-want) < .003 }
	a, b, c := composition.Clips[0], composition.Clips[1], composition.Clips[2]
	if a.Duration != 4.5 || a.SpeechHold != .5 || a.TransitionToNext.DurationMS != 200 || b.SpeechTracks[0].StartTime != .2 {
		t.Fatalf("dialogue did not fit its shot or avoid overlap: %#v / %#v", a, b)
	}
	if !closeEnough(composition.AudioTracks[0].StartTime, 7.3) || !closeEnough(composition.AudioTracks[1].StartTime, 9.3) || !closeEnough(c.Duration, 3.5) {
		t.Fatalf("narration was truncated, overlapped or moved off its shot: %#v / %#v", composition.AudioTracks, c)
	}
}

func TestStoryboardContinuitySourceWindowPreservesVideoAndOriginalAudio(t *testing.T) {
	ffmpeg, err := exec.LookPath("ffmpeg")
	if err != nil {
		t.Skip("ffmpeg unavailable")
	}
	ffprobe, err := exec.LookPath("ffprobe")
	if err != nil {
		t.Skip("ffprobe unavailable")
	}
	ctx := context.Background()
	workspace := t.TempDir()
	input, output := filepath.Join(workspace, "input.mp4"), filepath.Join(workspace, "cut.mp4")
	run := func(args ...string) []byte {
		t.Helper()
		bytes, err := exec.CommandContext(ctx, ffmpeg, append([]string{"-hide_banner", "-loglevel", "error"}, args...)...).CombinedOutput()
		if err != nil {
			t.Fatalf("ffmpeg: %v: %s", err, bytes)
		}
		return bytes
	}
	run("-f", "lavfi", "-i", "color=red:s=160x96:r=25:d=1",
		"-f", "lavfi", "-i", "anullsrc=r=48000:cl=mono:d=1",
		"-f", "lavfi", "-i", "color=blue:s=160x96:r=25:d=1",
		"-f", "lavfi", "-i", "sine=f=440:r=48000:d=1",
		"-filter_complex", "concat=n=2:v=1:a=1", "-c:v", "libx264", "-threads", "1", "-c:a", "aac", input)
	media := ffmpegVideoReviewMedia{ffmpegPath: ffmpeg, videoPath: input}
	silence, err := media.reviewSilence(ctx)
	if err != nil || !reviewRangeSilent(silence, 0, 0.6) || reviewRangeSilent(silence, 0, 1.3) {
		t.Fatalf("only the measured quiet head may be removed: %v, %v", silence, err)
	}
	composition := ffmpegComposition{Clips: []ffmpegCompositionClip{{VisualVideo: input, OriginalAudio: input, OriginalVolume: 1, SourceStart: 1.04, Duration: 0.6}}}
	args, mode, err := buildFFmpegLocalCompositionArgs(ctx, workspace, output, ffprobe, composition)
	if err != nil || mode != ffmpegCompositionModeTranscode {
		t.Fatalf("non-zero source windows must render from the selected start: %s: %v", mode, err)
	}
	run(args...)
	pixel := run("-i", output, "-vf", "scale=1:1", "-pix_fmt", "rgb24", "-frames:v", "1", "-f", "rawvideo", "pipe:1")
	if len(pixel) != 3 || pixel[2] < 200 || pixel[0] > 20 {
		t.Fatalf("the kept picture should start on the blue portion: %v", pixel)
	}
	pcm := run("-i", output, "-t", "0.1", "-ac", "1", "-ar", "8000", "-f", "f32le", "pipe:1")
	var peak float64
	for offset := 0; offset+4 <= len(pcm); offset += 4 {
		peak = math.Max(peak, math.Abs(float64(math.Float32frombits(binary.LittleEndian.Uint32(pcm[offset:])))))
	}
	if peak < 0.03 {
		t.Fatalf("the kept original audio should start with the tone, not the excluded silence: %g", peak)
	}
	probe, err := probeFFmpegMedia(ctx, ffprobe, output)
	if err != nil || !probe.HasVideo || !probe.HasAudio || math.Abs(probe.Duration-0.6) > 0.05 {
		t.Fatalf("wanted a 0.6-second clip with both streams: %+v, %v", probe, err)
	}
	composition.Clips[0].Duration = 1.4
	if _, _, err := buildFFmpegLocalCompositionArgs(ctx, workspace, output, ffprobe, composition); err == nil {
		t.Fatal("a cut beyond the source must not be padded or published")
	}
}

func TestStoryboardContinuityDialogueRequiresAudibleNativeTrack(t *testing.T) {
	ffmpeg, err := exec.LookPath("ffmpeg")
	if err != nil {
		t.Skip("ffmpeg unavailable")
	}
	ffprobe, err := exec.LookPath("ffprobe")
	if err != nil {
		t.Skip("ffprobe unavailable")
	}
	ctx := context.Background()
	for _, hasTrack := range []bool{false, true} {
		testVideo := filepath.Join(t.TempDir(), "shot.mp4")
		args := []string{"-hide_banner", "-loglevel", "error", "-f", "lavfi", "-i", "color=black:s=160x96:r=25:d=1"}
		want := "没有原声音轨"
		if hasTrack {
			want = "全段静音"
			args = append(args, "-f", "lavfi", "-i", "anullsrc=r=48000:cl=mono:d=0.7", "-c:a", "aac")
		}
		args = append(args, "-c:v", "libx264", "-threads", "1", testVideo)
		if raw, err := exec.CommandContext(ctx, ffmpeg, args...).CombinedOutput(); err != nil {
			t.Fatalf("generate test video: %v: %s", err, raw)
		}
		probe, err := probeFFmpegMedia(ctx, ffprobe, testVideo)
		if err != nil {
			t.Fatal(err)
		}
		media := ffmpegVideoReviewMedia{ffmpegPath: ffmpeg, videoPath: testVideo, probe: probe, duration: probe.VideoDuration}
		if _, err := media.reviewOriginalSound(ctx, true); err == nil || !strings.Contains(err.Error(), want) {
			t.Fatalf("want %q, got %v", want, err)
		}
	}
}

func TestStoryboardContinuitySoundLeadInRenderedVideo(t *testing.T) {
	ffmpeg, err := exec.LookPath("ffmpeg")
	if err != nil {
		t.Skip("FFmpeg unavailable")
	}
	ffprobe, err := exec.LookPath("ffprobe")
	if err != nil {
		t.Skip("ffprobe unavailable")
	}
	ctx := context.Background()
	work := t.TempDir()
	run := func(t *testing.T, args ...string) []byte {
		t.Helper()
		output, err := exec.CommandContext(ctx, ffmpeg, append([]string{"-hide_banner", "-loglevel", "error"}, args...)...).CombinedOutput()
		if err != nil {
			t.Fatalf("ffmpeg: %v: %s", err, output)
		}
		return output
	}
	opening, incoming := filepath.Join(work, "red.mp4"), filepath.Join(work, "blue.mp4")
	for _, in := range []struct{ color, sound, path string }{
		{"red", "sine=f=300:r=48000", opening},
		{"blue", "aevalsrc=0.12*sin(2*PI*400*t)+0.06*sin(2*PI*800*t)*gte(t\\,0.8):s=48000", incoming},
	} {
		run(t, "-f", "lavfi", "-i", "color=c="+in.color+":s=160x96:r=25", "-f", "lavfi", "-i", in.sound,
			"-t", "5", "-c:v", "libx264", "-pix_fmt", "yuv420p", "-c:a", "aac", in.path)
	}
	for _, test := range []struct {
		mode string
		fps  int
	}{
		{ffmpegCompositionModeCopyVideoMixAudio, 25},
		{ffmpegCompositionModeTranscode, 30},
	} {
		t.Run(test.mode, func(t *testing.T) {
			workspace := t.TempDir()
			output := filepath.Join(workspace, "bridged.mp4")
			composition := ffmpegComposition{
				Settings: ffmpegCompositionSettings{FPS: test.fps},
				Clips: []ffmpegCompositionClip{
					{VisualVideo: opening, OriginalAudio: opening, OriginalVolume: .75, Duration: 5, TransitionToNext: ffmpegCompositionTransition{Type: "none"}},
					{VisualVideo: incoming, OriginalAudio: incoming, OriginalVolume: 1, Duration: 5},
				},
			}
			render := func(path string) float64 {
				args, mode, err := buildFFmpegLocalCompositionArgs(ctx, workspace, path, ffprobe, composition)
				if err != nil || mode != test.mode {
					t.Fatalf("expected %s, got %s: %v", test.mode, mode, err)
				}
				run(t, args...)
				probe, err := probeFFmpegMedia(ctx, ffprobe, path)
				if err != nil {
					t.Fatal(err)
				}
				return probe.Duration
			}
			baseline := render(filepath.Join(workspace, "baseline.mp4"))
			composition.Clips[0].TransitionToNext.SoundLeadMS = 500
			if actual := render(output); math.Abs(actual-baseline) > .001 {
				t.Fatalf("sound lead changed running time: %g -> %g", baseline, actual)
			}
			amplitude := func(at string, frequency float64) float64 {
				pcm := run(t, "-ss", at, "-i", output, "-t", "0.08", "-vn", "-ac", "1", "-ar", "8000", "-f", "f32le", "pipe:1")
				var sine, cosine float64
				for offset := 0; offset+4 <= len(pcm); offset += 4 {
					sample := float64(math.Float32frombits(binary.LittleEndian.Uint32(pcm[offset:])))
					phase := 2 * math.Pi * frequency * float64(offset/4) / 8000
					sine += sample * math.Sin(phase)
					cosine += sample * math.Cos(phase)
				}
				return 8 * math.Hypot(sine, cosine) / float64(len(pcm))
			}
			before, during := amplitude("4.30", 300), amplitude("4.87", 300)
			lead, after := amplitude("4.87", 400), amplitude("5.24", 400)
			if before < .07 || during > before*.4 || lead < after*.65 || after < .08 {
				t.Fatalf("expected outgoing tone to fade into incoming tone, got outgoing %g -> %g, incoming %g -> %g", before, during, lead, after)
			}
			if early, onCue := amplitude("5.64", 800), amplitude("5.88", 800); early > .005 || onCue < .035 {
				t.Fatalf("incoming synchronized sound moved off its cue: %g / %g", early, onCue)
			}
			pixel := func(at string) []byte {
				return run(t, "-ss", at, "-i", output, "-vf", "scale=1:1", "-pix_fmt", "rgb24", "-frames:v", "1", "-f", "rawvideo", "pipe:1")
			}
			if before, after := pixel("4.92"), pixel("5.08"); len(before) != 3 || len(after) != 3 || before[0] < 200 || after[2] < 200 {
				t.Fatalf("the picture must cut from red to blue at 5s: %v -> %v", before, after)
			}
		})
	}
}

func TestStoryboardContinuityRoomToneFillsSilentHeadWithoutShiftingSound(t *testing.T) {
	ffmpeg, err := exec.LookPath("ffmpeg")
	if err != nil {
		t.Skip("FFmpeg unavailable")
	}
	ffprobe, err := exec.LookPath("ffprobe")
	if err != nil {
		t.Skip("ffprobe unavailable")
	}
	ctx := context.Background()
	work := t.TempDir()
	run := func(args ...string) {
		t.Helper()
		output, err := exec.CommandContext(ctx, ffmpeg, append([]string{"-hide_banner", "-loglevel", "error"}, args...)...).CombinedOutput()
		if err != nil {
			t.Fatalf("ffmpeg: %v: %s", err, output)
		}
	}
	opening, incoming := filepath.Join(work, "opening.mp4"), filepath.Join(work, "incoming.mp4")
	for _, input := range []struct{ color, sound, path string }{
		{"red", "sine=f=300:r=48000", opening},
		{"blue", "sine=f=400:r=48000:d=1.35,adelay=2650:all=1,apad=whole_dur=5", incoming},
	} {
		run("-f", "lavfi", "-i", "color=c="+input.color+":s=160x96:r=25", "-f", "lavfi", "-i", input.sound,
			"-t", "5", "-c:v", "libx264", "-pix_fmt", "yuv420p", "-c:a", "aac", input.path)
	}
	composition := ffmpegComposition{Clips: []ffmpegCompositionClip{
		{VisualVideo: opening, OriginalAudio: opening, OriginalVolume: 1, Duration: 5, TransitionToNext: ffmpegCompositionTransition{Type: "none", SoundLeadMS: 200, CarryRoomTone: true}},
		{VisualVideo: incoming, OriginalAudio: incoming, OriginalVolume: 1, Duration: 5},
	}}
	output := filepath.Join(work, "continuous.mp4")
	args, mode, err := buildFFmpegLocalCompositionArgs(ctx, work, output, ffprobe, composition)
	if err != nil || mode != ffmpegCompositionModeCopyVideoMixAudio {
		t.Fatalf("expected original video streams, got %s: %v", mode, err)
	}
	run(args...)
	probe, err := probeFFmpegMedia(ctx, ffprobe, output)
	if err != nil || math.Abs(probe.Duration-10) > .15 {
		t.Fatalf("continuity mix changed duration: %+v: %v", probe, err)
	}
	silent, err := detectFFmpegAudioSilence(ctx, ffmpeg, output)
	if err != nil {
		t.Fatal(err)
	}
	for _, interval := range silent {
		if interval.start < 7.60 && interval.end > 5.05 {
			t.Fatalf("unused incoming silence was not filled: %+v", silent)
		}
	}
	if !reviewRangeSilent(silent, 9.2, 9.8) {
		t.Fatalf("the next shot's own audio was moved or its unrelated ending was changed: %+v", silent)
	}
}

func TestStoryboardContinuityAmbientLevelWithoutAudioOverlap(t *testing.T) {
	ffmpeg, err := exec.LookPath("ffmpeg")
	if err != nil {
		t.Skip("FFmpeg unavailable")
	}
	ctx := context.Background()
	work := t.TempDir()
	clips := make([]ffmpegPreparedClip, 2)
	for index, source := range []string{"sine=f=300:r=32000:d=1", "sine=f=400:r=32000:d=1,volume=0.25"} {
		path := filepath.Join(work, []string{"left.wav", "right.wav"}[index])
		if output, err := exec.CommandContext(ctx, ffmpeg, "-loglevel", "error", "-f", "lavfi", "-i", source, path).CombinedOutput(); err != nil {
			t.Fatalf("generate test audio: %v: %s", err, output)
		}
		clips[index] = ffmpegPreparedClip{Clip: ffmpegCompositionClip{OriginalVolume: 1}, Duration: 1, VisualVideoPath: path, VisualProbe: ffmpegMediaProbe{AudioDuration: 1}, HasOriginalAudio: true}
	}
	clips[0].Clip.TransitionToNext = ffmpegCompositionTransition{Type: "none", CarryRoomTone: true, MatchAmbientLevel: true}
	if err := prepareFFmpegCompositionRoomTone(ctx, clips); err != nil {
		t.Fatal(err)
	}
	if clips[0].TailAttenuationDB != 6 || clips[1].HeadAttenuationDB != 0 || clips[1].RoomTone.duration != 0 || clips[0].Clip.TransitionToNext.SoundLeadMS != 0 {
		t.Fatalf("only attenuate the loud outgoing edge, never duplicate or move source samples: %+v", clips)
	}
}

func TestStoryboardContinuityNativeReactionCutsPictureBeforeSound(t *testing.T) {
	ffmpeg, err := exec.LookPath("ffmpeg")
	if err != nil {
		t.Skip("FFmpeg unavailable")
	}
	ffprobe, err := exec.LookPath("ffprobe")
	if err != nil {
		t.Fatal(err)
	}
	ctx := context.Background()
	dir := t.TempDir()
	run := func(args ...string) []byte {
		t.Helper()
		out, err := exec.CommandContext(ctx, ffmpeg, append([]string{"-v", "error"}, args...)...).CombinedOutput()
		if err != nil {
			t.Fatalf("ffmpeg: %v: %s", err, out)
		}
		return out
	}
	var clips []ffmpegCompositionClip
	for index, color := range []string{"red", "blue"} {
		path := filepath.Join(dir, color+".mp4")
		sound := []string{"sine=f=400:r=48000", "anullsrc=r=48000:cl=mono"}[index]
		run("-f", "lavfi", "-i", "color="+color+":s=96x64:r=24", "-f", "lavfi", "-i", sound, "-t", "2", "-c:v", "libx264", "-c:a", "aac", path)
		clips = append(clips, ffmpegCompositionClip{VisualVideo: path, OriginalAudio: path, OriginalVolume: 1, Duration: 2})
	}
	clips[0].TransitionToNext = ffmpegCompositionTransition{Type: "none", CarryRoomTone: true, ReactionCut: true}
	output := filepath.Join(dir, "reaction.mp4")
	args, mode, err := buildFFmpegLocalCompositionArgs(ctx, dir, output, ffprobe, ffmpegComposition{Clips: clips})
	if err != nil || mode != ffmpegCompositionModeTranscode {
		t.Fatalf("reaction edit: %v, %s", err, mode)
	}
	run(args...)
	pixel := run("-ss", "1.85", "-i", output, "-frames:v", "1", "-vf", "scale=1:1", "-pix_fmt", "rgb24", "-f", "rawvideo", "-")
	peak := func(at string) float64 {
		pcm := run("-ss", at, "-i", output, "-t", "0.05", "-map", "0:a", "-ac", "1", "-f", "f32le", "-")
		var value float64
		for offset := 0; offset+4 <= len(pcm); offset += 4 {
			value = max(value, math.Abs(float64(math.Float32frombits(binary.LittleEndian.Uint32(pcm[offset:])))))
		}
		return value
	}
	if len(pixel) != 3 || pixel[2] < 200 || peak("1.85") < 0.05 || peak("2.10") > 0.005 {
		t.Fatal("reaction picture and outgoing native audio must coexist, without repeating sound afterwards")
	}
}

func TestStoryboardContinuityRoomToneCanReuseIncomingAmbientTailAcrossBothSides(t *testing.T) {
	ffmpeg, err := exec.LookPath("ffmpeg")
	if err != nil {
		t.Skip("ffmpeg unavailable")
	}
	ffprobe, err := exec.LookPath("ffprobe")
	if err != nil {
		t.Skip("ffprobe unavailable")
	}
	ctx, work := context.Background(), t.TempDir()
	run := func(args ...string) {
		t.Helper()
		command := exec.CommandContext(ctx, ffmpeg, append([]string{"-hide_banner", "-loglevel", "error"}, args...)...)
		if raw, err := command.CombinedOutput(); err != nil {
			t.Fatalf("ffmpeg: %v: %s", err, raw)
		}
	}
	opening, incoming := filepath.Join(work, "opening.mp4"), filepath.Join(work, "incoming.mp4")
	for _, clip := range []struct{ color, sound, path string }{
		{"red", "sine=f=300:r=48000:d=4.6,apad=whole_dur=5", opening},
		{"blue", "sine=f=600:r=48000:d=4.72,adelay=280:all=1", incoming},
	} {
		run("-f", "lavfi", "-i", "color=c="+clip.color+":s=160x96:r=25", "-f", "lavfi", "-i", clip.sound,
			"-t", "5", "-c:v", "libx264", "-pix_fmt", "yuv420p", "-c:a", "aac", clip.path)
	}
	composition := ffmpegComposition{Clips: []ffmpegCompositionClip{
		{VisualVideo: opening, OriginalAudio: opening, OriginalVolume: 1, Duration: 5, TransitionToNext: ffmpegCompositionTransition{Type: "none", RoomToneFromNextMS: 200}},
		{VisualVideo: incoming, OriginalAudio: incoming, OriginalVolume: 1, Duration: 5},
	}}
	output := filepath.Join(work, "continuous.mp4")
	args, mode, err := buildFFmpegLocalCompositionArgs(ctx, work, output, ffprobe, composition)
	if err != nil || mode != ffmpegCompositionModeCopyVideoMixAudio {
		t.Fatalf("expected unchanged video streams with mixed audio, got %s: %v", mode, err)
	}
	run(args...)
	intervals, err := detectFFmpegAudioSilence(ctx, ffmpeg, output)
	if err != nil {
		t.Fatal(err)
	}
	for _, interval := range intervals {
		if interval.start < 5.24 && interval.end > 4.65 {
			t.Fatalf("the audio seam retained a silent gap on either side: %+v", intervals)
		}
	}
}
