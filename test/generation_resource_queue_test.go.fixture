package energon

import (
	"context"
	"errors"
	"fmt"
	"sync"
	"testing"
	"time"

	botmodel "github.com/dever-package/bot/model/energon"
	botprotocol "github.com/dever-package/bot/service/energon/protocol"
	botadapters "github.com/dever-package/bot/service/energon/protocol/adapters"
	botschedule "github.com/dever-package/bot/service/energon/schedule"
	bottask "github.com/dever-package/bot/service/energon/task"
	"github.com/dever-package/bot/test/runtimefixture"
)

func TestGenerationResourceQueue(t *testing.T) {
	broker := runtimefixture.Redis(t)
	db := runtimefixture.New(t)
	runtimefixture.CreateTable(t, db, "bot_energon_provider", botmodel.Provider{})
	runtimefixture.CreateTable(t, db, "bot_energon_service", botmodel.Service{})
	runtimefixture.CreateTable(t, db, "bot_energon_service_account", botmodel.ServiceAccount{})
	runtimefixture.CreateTable(t, db, "bot_energon_account", botmodel.Account{})
	ctx := botschedule.WithBroker(context.Background(), broker)
	t.Run("comfyui observes two tasks under its configured shared limit", func(t *testing.T) {
		botmodel.NewProviderModel().Insert(ctx, map[string]any{"id": 1, "status": 1})
		botmodel.NewServiceModel().Insert(ctx, map[string]any{"id": 1, "provider_id": 1, "status": 1})
		botmodel.NewAccountModel().Insert(ctx, map[string]any{"id": 1, "provider_id": 1, "scope": botmodel.AccountScopeCommon, "status": 1, "concurrency": 2})
		service := GatewayService{}
		callCtx := bottask.WithDefaultStore(ctx)
		for _, id := range []string{"first-image", "second-music"} {
			if _, err := prepareExecution(callCtx, id); err != nil {
				t.Fatal(err)
			}
		}
		prepared := remoteCallPreparation{Request: &botprotocol.ShemicRequest{RequestID: "first-image"}, Adapter: botadapters.ComfyUIAdapter{}, Selected: selectedTarget{Account: botmodel.Account{ID: 1, Concurrency: 2}, Provider: botmodel.Provider{ID: 1}, Service: botmodel.Service{ID: 1}, Power: botmodel.Power{Kind: "image"}}}
		first, _, err := service.acquireRemoteResource(callCtx, prepared)
		if err != nil {
			t.Fatal(err)
		}
		defer finishSourceCall(first)
		prepared.Request = &botprotocol.ShemicRequest{RequestID: "second-music"}
		prepared.Selected.Power.Kind = "music"
		second, _, err := service.acquireRemoteResource(callCtx, prepared)
		if err != nil {
			t.Fatal(err)
		}
		stats, err := runtimefixture.AccountUsage(ctx, broker, 1)
		if err != nil || stats["active_tasks"] != 2 {
			t.Fatal("ComfyUI bypassed configured accounting", stats, err)
		}
		finishSourceCall(second)
	})
	t.Run("five gpu jobs are serial and cloud request proceeds", func(t *testing.T) {
		ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
		defer cancel()
		gpuProceed := make(chan struct{})
		gpuStarted := make(chan string, 5)
		cloudStarted := make(chan struct{}, 1)
		queued := make(chan struct{}, 5)
		var mu sync.Mutex
		active, maximum, completed := 0, 0, 0
		queue := bottask.NewInlineQueue(bottask.HandlerFunc(func(ctx context.Context, job bottask.Job) error {
			accountID := uint64(2)
			if job.RequestID == "cloud" {
				accountID = 3
			}
			lease, err := broker.Acquire(ctx, job.RequestID, job.RequestID, fmt.Sprint(accountID), []botschedule.Account{{ID: accountID, Limit: 1}}, func(int) { queued <- struct{}{} }, nil)
			if err != nil {
				return err
			}
			defer lease.Release(context.WithoutCancel(ctx))
			if job.RequestID == "cloud" {
				cloudStarted <- struct{}{}
				return nil
			}
			mu.Lock()
			active++
			if active > maximum {
				maximum = active
			}
			mu.Unlock()
			gpuStarted <- job.RequestID
			select {
			case <-gpuProceed:
			case <-ctx.Done():
				return ctx.Err()
			}
			mu.Lock()
			active--
			completed++
			mu.Unlock()
			return nil
		}), time.Minute)
		defer queue.Shutdown(ctx)
		if err := queue.Push(ctx, bottask.Job{RequestID: "gpu-0"}); err != nil {
			t.Fatal(err)
		}
		select {
		case <-gpuStarted:
		case <-ctx.Done():
			t.Fatal(ctx.Err())
		}
		for i := 1; i < 5; i++ {
			if err := queue.Push(ctx, bottask.Job{RequestID: fmt.Sprint("gpu-", i)}); err != nil {
				t.Fatal(err)
			}
		}
		for i := 1; i < 5; i++ {
			select {
			case <-queued:
			case <-ctx.Done():
				t.Fatal(ctx.Err())
			}
		}
		if err := queue.Push(ctx, bottask.Job{RequestID: "cloud"}); err != nil {
			t.Fatal(err)
		}
		select {
		case <-cloudStarted:
		case <-ctx.Done():
			t.Fatal("GPU wait blocked cloud request")
		}
		close(gpuProceed)
		for i := 1; i < 5; i++ {
			select {
			case <-gpuStarted:
			case <-ctx.Done():
				t.Fatal(ctx.Err())
			}
		}
		if err := queue.Shutdown(ctx); err != nil {
			t.Fatal(err)
		}
		mu.Lock()
		defer mu.Unlock()
		if maximum != 1 || completed != 5 {
			t.Fatal(maximum, completed)
		}
	})
	t.Run("canceled account waiter frees its place", func(t *testing.T) {
		ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
		defer cancel()
		first, err := broker.Acquire(ctx, "held", "held", "4", []botschedule.Account{{ID: 4, Limit: 1}}, nil, nil)
		if err != nil {
			t.Fatal(err)
		}
		waiting, stop := context.WithCancel(ctx)
		position := make(chan int, 1)
		done := make(chan error, 1)
		go func() {
			_, err := broker.Acquire(waiting, "waiting", "waiting", "4", []botschedule.Account{{ID: 4, Limit: 1}}, func(n int) { position <- n }, nil)
			done <- err
		}()
		select {
		case n := <-position:
			if n != 1 {
				t.Fatal(n)
			}
		case <-ctx.Done():
			t.Fatal(ctx.Err())
		}
		stop()
		if err := <-done; !errors.Is(err, context.Canceled) {
			t.Fatal(err)
		}
		if err := first.Release(ctx); err != nil {
			t.Fatal(err)
		}
		next, err := broker.Acquire(ctx, "next", "next", "4", []botschedule.Account{{ID: 4, Limit: 1}}, nil, nil)
		if err != nil {
			t.Fatal(err)
		}
		if err := next.Release(ctx); err != nil {
			t.Fatal(err)
		}
		stats, err := runtimefixture.AccountUsage(ctx, broker, 4)
		if err != nil || stats["active_tasks"] != 0 || stats["waiting_tasks"] != 0 {
			t.Fatal(stats, err)
		}
	})
}
