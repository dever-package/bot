	storyboardReferencePromptRepository
}

func (storyboardReferencePromptSlotsRepository) ParamMap(context.Context) map[uint64]botmodel.Param {
	return map[uint64]botmodel.Param{
		1: {ID: 1, Key: "caption", Type: "prompt", ValueType: "string", Status: 1},
		2: {ID: 2, Key: "first", Type: "file", ValueType: "string", Status: 1},
		3: {ID: 3, Key: "last", Type: "file", ValueType: "string", Status: 1},
	}
}

func (storyboardReferencePromptSlotsRepository) PowerParamsByPower(context.Context, uint64) []botmodel.PowerParam {
	return []botmodel.PowerParam{{ID: 1, ParamID: 1, Show: 1, Status: 1}, {ID: 2, ParamID: 2, Show: 1, Status: 2}, {ID: 3, ParamID: 3, Show: 1, Status: 2}}
}

func (storyboardReferencePromptSlotsRepository) ServiceParamsByService(context.Context, uint64) []botmodel.ServiceParam {
	return []botmodel.ServiceParam{
		{ID: 1, ParamID: 1, Key: "native_prompt", ParamRule: 1, Status: 1},
		{ID: 2, ParamID: 2, Key: "first_slot", ParamRule: 1, Status: 1},
		{ID: 3, ParamID: 3, Key: "last_slot", ParamRule: 1, Status: 1},
	}
}

func TestStoryboardReferencePromptFixedSettingsReachNativeInput(t *testing.T) {
	fixed := []string{
		"画面类型：写实影像；统一视觉风格：自然纪实风格",
		"当前可见素材设定：角色“旅人”：身高1米75，深色外套；道具“木盒”：幻想木盒宽三米；未列出的主体不得擅自出现",
		"空间关系与真实尺度：幻想木盒宽三米，大于旅人身高；人物双脚接触地面，门框与桌边保持一致透视",
	}
	parent := &botprotocol.ShemicRequest{
		Input: map[string]any{
			"prompt": "完整动作：旅人走到终点并坐下", "native_prompt": "父级尾帧：旅人已坐下",
		},
		Options: map[string]any{
			botprotocol.OptionImageSequenceMode:             botprotocol.ImageSequenceModeReferences,
			botprotocol.OptionImageSequenceFixedConstraints: fixed,
		},
		Raw: botprotocol.RawRequest{Body: map[string]any{}},
	}
	before, err := json.Marshal(parent)
	if err != nil {
		t.Fatal(err)
	}
	for _, framePrompt := range []string{"角色近景", "木盒细节近景\n" + strings.Join(fixed, "\n")} {
		for attempt := 1; attempt <= 2; attempt++ {
			frame := storyboardGridFrame{Order: 1, Title: "规划省略尺度", Prompt: framePrompt}
			prompt := storyboardGridFramePrompt(storyboardGridPlan{}, frame, imageSequenceFixedConstraints(parent), attempt > 1)
			child := cloneStoryboardGridRequest(parent, prompt, "16:9", 1, attempt)
			child.Input = botinput.PrepareImageSequenceInput(context.Background(), storyboardReferencePromptRepository{}, botinput.Target{PowerID: 1, ServiceID: 1}, child.Input, storyboardReferencePromptParams(4), nil)
			mapped, err := botinput.BuildMapped(context.Background(), storyboardReferencePromptRepository{}, child, botinput.Target{PowerID: 1, ServiceID: 1})
			if err != nil {
				t.Fatal(err)
			}
			native := mapped.NativeBody()
			nativePrompt := botprotocol.AsText(native["native_prompt"])
			for _, constraint := range fixed {
				if strings.Count(nativePrompt, constraint) != 1 {
					t.Fatalf("native prompt dropped or duplicated fixed setting %q: %s", constraint, nativePrompt)
				}
			}
			for _, forbidden := range []string{"完整动作", "终点", "已坐下", "父级"} {
				if strings.Contains(nativePrompt, forbidden) {
					t.Fatalf("parent action leaked through fixed context: %s", nativePrompt)
				}
			}
			if !strings.Contains(nativePrompt, "原脚本设定优先") || !strings.Contains(nativePrompt, "不要求所有素材同时入画") {
				t.Fatal("fixed settings lost precedence or changed subject visibility")
			}
			if hasImageSequenceOption(child.Options) || hasImageSequenceOption(botprotocol.NormalizeMap(child.Raw.Body["options"])) {
				t.Fatal("child leaked internal fixed constraints")
			}
			if _, leaked := native[botprotocol.OptionImageSequenceFixedConstraints]; leaked {
				t.Fatal("fixed constraints became a provider-native field")
			}
		}
	}
	after, err := json.Marshal(parent)
	if err != nil {
		t.Fatal(err)
	}
	if string(before) != string(after) {
		t.Fatal("fixed constraints mutated parent request")
	}
}

func TestStoryboardReferencePromptFixedSettingsOnlyApplyToReferences(t *testing.T) {
	if constraints := imageSequenceFixedConstraints(nil); len(constraints) != 0 {
		t.Fatal("nil request gained fixed settings")
	}
	for _, mode := range []string{"", botprotocol.ImageSequenceModeSingle, botprotocol.ImageSequenceModeAuto, botprotocol.ImageSequenceModeFrames, botprotocol.ImageSequenceModeReferences} {
		t.Run(mode, func(t *testing.T) {
			parent := &botprotocol.ShemicRequest{Options: map[string]any{
				botprotocol.OptionImageSequenceMode:             mode,
				botprotocol.OptionImageSequenceFixedConstraints: []any{"固定尺度：木盒宽30厘米"},
			}}
			constraints := imageSequenceFixedConstraints(parent)
			if mode == botprotocol.ImageSequenceModeReferences {
				if !reflect.DeepEqual(constraints, []string{"固定尺度：木盒宽30厘米"}) {
					t.Fatalf("reference mode lost constraints: %#v", constraints)
				}
				return
			}
			if len(constraints) != 0 {
				t.Fatal("ordinary sequence changed behavior")
			}
		})
	}
}

func TestStoryboardReferencePromptRepeatedURLInDistinctNativeSlots(t *testing.T) {
	ctx := context.Background()
	repo := storyboardReferencePromptSlotsRepository{}
	url := "https://example.test/same.png"
	values := map[string]any{"prompt": "当前首帧", "caption": "旧主提示词", "native_prompt": "旧native提示词", "first": url, "last": url}
	params := []botinput.PowerParam{
		{ID: 2, ParamID: 2, Key: "first", Type: "file", AcceptedKinds: []string{"image"}},
		{ID: 3, ParamID: 3, Key: "last", Type: "file", AcceptedKinds: []string{"image"}},
	}
	references := []botinput.MediaReference{
		{Kind: "image", URL: url, Label: "第一槽", Usage: "first"},
		{Kind: "image", URL: url, Label: "第二槽", Usage: "last"},
	}
	target := botinput.Target{PowerID: 1, ServiceID: 1}
	prepared := botinput.PrepareImageSequenceInput(ctx, repo, target, values, params, references)
	mapped, err := botinput.BuildMapped(ctx, repo, &botprotocol.ShemicRequest{Input: prepared}, target)
	if err != nil {
		t.Fatal(err)
	}
	native := mapped.NativeBody()
	if native["first_slot"] != url || native["last_slot"] != url {
		t.Fatalf("native slots lost repeated URL: %#v", native)
	}
	prompt := botprotocol.AsText(native["native_prompt"])
	for _, expected := range []string{"当前首帧", "图1（参考图1）= 第1张图片输入；素材标签：@第一槽", "图2（参考图2）= 第2张图片输入；素材标签：@第二槽"} {
		if !strings.Contains(prompt, expected) {
			t.Fatalf("native prompt missing %q: %s", expected, prompt)
		}
	}
	if strings.Contains(prompt, "旧") || values["caption"] != "旧主提示词" || values["native_prompt"] != "旧native提示词" {
		t.Fatal("custom primary alias leaked or parent input mutated")
	}
}

type storyboardReferencePromptAliasRepository struct {
	storyboardReferencePromptRepository
	primaryKey string
	nativeKey  string
}

func (repo storyboardReferencePromptAliasRepository) ParamMap(ctx context.Context) map[uint64]botmodel.Param {
	params := repo.storyboardReferencePromptRepository.ParamMap(ctx)
	primary := params[1]
	primary.Key = repo.primaryKey
	params[1] = primary
	return params
}

func (repo storyboardReferencePromptAliasRepository) ServiceParamsByService(ctx context.Context, serviceID uint64) []botmodel.ServiceParam {
	params := repo.storyboardReferencePromptRepository.ServiceParamsByService(ctx, serviceID)
	params[0].Key = repo.nativeKey
	return params
}

func TestStoryboardReferencePromptDoesNotInventAliases(t *testing.T) {
	for _, scenario := range []struct {
		name       string
		primaryKey string
		nativeKey  string
		aliases    map[string]any
	}{
		{name: "canonical", primaryKey: "prompt", nativeKey: "native_prompt"},
		{name: "custom_missing", primaryKey: "caption", nativeKey: "native_prompt"},
		{name: "nested_missing", primaryKey: "caption", nativeKey: "request.text"},
		{name: "existing_native", primaryKey: "caption", nativeKey: "request.text", aliases: map[string]any{"request.text": "父级提示词"}},
	} {
		t.Run(scenario.name, func(t *testing.T) {
			ctx := context.Background()
			repo := storyboardReferencePromptAliasRepository{primaryKey: scenario.primaryKey, nativeKey: scenario.nativeKey}
			parent := map[string]any{"prompt": "当前独立画面", "images": []string{"https://example.test/reference.png"}}
			for key, value := range scenario.aliases {
				parent[key] = value
			}
			before, err := json.Marshal(parent)
			if err != nil {
				t.Fatal(err)
			}
			target := botinput.Target{PowerID: 1, ServiceID: 1}
			prepared := botinput.PrepareImageSequenceInput(ctx, repo, target, parent, storyboardReferencePromptParams(4), nil)
			if _, exists := prepared["param_1"]; exists {
				t.Fatal("invented synthetic prompt alias")
			}
			if _, existed := parent[scenario.nativeKey]; !existed {
				if _, added := prepared[scenario.nativeKey]; added {
					t.Fatalf("invented unused native input alias %q", scenario.nativeKey)
				}
			}
			if len(scenario.aliases) > 0 && scenario.primaryKey != "prompt" {
				if _, added := prepared[scenario.primaryKey]; added {
					t.Fatal("added canonical key despite existing effective native alias")
				}
			}
			mapped, err := botinput.BuildMapped(ctx, repo, &botprotocol.ShemicRequest{Input: prepared}, target)
			if err != nil {
				t.Fatal(err)
			}
			native := mapped.NativeBody()
			expectedKeys := map[string]bool{"native_images": true, strings.Split(scenario.nativeKey, ".")[0]: true}
			if scenario.primaryKey != "prompt" {
				expectedKeys["prompt"] = true
			}
			if len(native) != len(expectedKeys) {
				t.Fatalf("unexpected provider body fields: %#v", native)
			}
			for key := range native {
				if !expectedKeys[key] {
					t.Fatalf("unused input alias leaked to provider: %s", key)
				}
			}
			var nativePrompt any = native[scenario.nativeKey]
			if scenario.nativeKey == "request.text" {
				nativePrompt = botprotocol.NormalizeMap(native["request"])["text"]
			}
			if nativePrompt != prepared["prompt"] || !strings.Contains(botprotocol.AsText(nativePrompt), "当前独立画面") {
				t.Fatalf("final configured prompt missing: %#v", native)
			}
			after, err := json.Marshal(parent)
			if err != nil {
				t.Fatal(err)
			}
			if string(before) != string(after) {
				t.Fatal("parent input mutated")
			}
		})
	}
}
