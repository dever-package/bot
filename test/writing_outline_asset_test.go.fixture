package asset

import (
	"encoding/json"
	"testing"
)

func TestWritingOutlineAssetRecognition(t *testing.T) {
	root := map[string]any{"type": "story", "preferences": map[string]any{}, "schema_version": float64(1), "inspirations": []any{}, "selected_inspiration_id": "", "units": []any{}, "archived_units": []any{}, "outline": map[string]any{"overview": "", "world": "", "characters": []any{}, "locations": []any{}, "props": []any{}}}
	raw, _ := json.Marshal(map[string]any{"json": root})
	if _, ok := WritingDocument(string(raw)); !ok {
		t.Fatal("structured incomplete draft not recognized")
	}

	for _, mutate := range []func(map[string]any){
		func(d map[string]any) { d["graph"] = map[string]any{} },
		func(d map[string]any) { d["outline"].(map[string]any)["storylines"] = "" },
		func(d map[string]any) { d["units"] = []any{map[string]any{"id": "chapter", "event_ids": []any{}}} },
		func(d map[string]any) { delete(d, "preferences") },
	} {
		var retired map[string]any
		_ = json.Unmarshal(raw, &retired)
		d := retired["json"].(map[string]any)
		mutate(d)
		if _, ok := WritingDocument(d); ok {
			t.Fatal("retired document recognized", d)
		}
	}
	root["outline"] = "旧的纯文本"
	if _, ok := WritingDocument(root); ok {
		t.Fatal("legacy outline recognized")
	}
	root["outline"] = map[string]any{"overview": "内容"}
	if _, ok := WritingDocument(root); ok {
		t.Fatal("malformed outline recognized")
	}
	unit := map[string]any{"type": "writing_unit", "schema_version": float64(1), "profile": "story", "unit_id": "chapter", "body": "正文"}
	if _, ok := WritingDocument(unit); !ok {
		t.Fatal("body contract regressed")
	}
}
