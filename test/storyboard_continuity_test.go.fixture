package energon

import (
	"strings"
	"testing"

	botmodel "github.com/dever-package/bot/model/energon"
)

func TestStoryboardContinuityModelDurationOptions(t *testing.T) {
	contract, err := storyboardGenerationContractForRequest(map[string]any{
		botmodel.StoryboardDurationOptionsInputKey: []any{"5", "8", "10"},
	}, 0)
	if err != nil {
		t.Fatal(err)
	}
	if contract.MinShotDuration != 5 || contract.MaxShotDuration != 10 {
		t.Fatalf("video duration mappings were ignored: %#v", contract)
	}
	for requested, want := range map[int]int{4: 5, 6: 8, 8: 8, 10: 10, 12: 10} {
		got, err := normalizeStoryboardShotDuration(requested, contract)
		if err != nil || got != want {
			t.Fatalf("duration %d: wanted %d; got %d, %v", requested, want, got, err)
		}
	}
}

func storyboardContinuityTestShots(modify func(shots []any)) []any {
	shot := func(id string, materials ...any) map[string]any {
		return map[string]any{
			"id": id, "duration": 4, "beat": "动作", "description": "画面", "video_prompt": "表演",
			"camera_instruction": "固定机位", "start_framing": "中景", "end_framing": "中景",
			"material_ids": materials, "transition_type": "none",
			"continuity_state": map[string]any{"entry": "站在柜台前", "exit": "站在柜台前"},
		}
	}
	shots := []any{
		shot("s1", "owner", "shop"),
		shot("s2", "owner", "shop"),
		shot("s3", "owner", "guest", "shop"),
		shot("s4", "owner", "street"),
	}
	shots[1].(map[string]any)["continue_previous"] = true
	shots[2].(map[string]any)["continue_previous"] = true
	modify(shots)
	return shots
}

func TestStoryboardContinuityNormalization(t *testing.T) {
	for _, spec := range botmodel.StoryboardWorkTypeSpecs() {
		t.Run(spec.Key, func(t *testing.T) {
			materialTypes := map[string]string{"owner": "character", "guest": "character", "shop": "scene", "street": "scene", "umbrella": "prop"}
			lookup := map[string]string{"owner": "owner", "guest": "guest", "shop": "shop", "street": "street", "umbrella": "umbrella"}
			normalize := func(modify func([]any)) []map[string]any {
				contract := storyboardGenerationContract{WorkType: spec.Key, MinShotDuration: 2, MaxShotDuration: 15}
				shots, err := normalizeStoryboardShots(storyboardContinuityTestShots(modify), materialTypes, lookup, contract)
				if err != nil {
					t.Fatal(err)
				}
				rows := make([]map[string]any, len(shots))
				for index, shot := range shots {
					rows[index] = shot.(map[string]any)
				}
				return rows
			}

			shots := normalize(func([]any) {})
			// 同一场戏、没有新人物：复用规划首帧，仍保留本镜目标尾帧。
			if shots[1]["continue_previous"] != true || shots[1]["shot_image_mode"] != botmodel.StoryboardShotImageFirstLast {
				t.Fatalf("same-camera continuation must use the tail frame: %+v", shots[1])
			}
			// 接尾帧的接缝不叠加转场，即使脚本写了也去掉。
			faded := normalize(func(shots []any) {
				shots[1].(map[string]any)["transition_type"] = "fade"
				shots[1].(map[string]any)["transition_duration_ms"] = 500
			})
			if faded[1]["continue_previous"] != true || faded[1]["transition_type"] != botmodel.StoryboardTransitionNone || faded[1]["transition_duration_ms"] != 0 {
				t.Fatalf("a tail-frame seam must not carry a transition: %+v", faded[1])
			}
			// 规划尾图描绘明确入场的新人物，首图仍使用上一边界。
			if shots[2]["continue_previous"] != true || shots[2]["match_previous"] != false {
				t.Fatalf("planned entry should retain the shared opening and new ending: %+v", shots[2])
			}
			// 换场生成新首帧，保留脚本的硬切，不强制淡化。
			if shots[3]["continue_previous"] != false || shots[3]["match_previous"] != false ||
				shots[3]["transition_type"] != botmodel.StoryboardTransitionNone || shots[3]["transition_duration_ms"] != 0 {
				t.Fatalf("a scene change must get a new frame and retain the authored cut: %+v", shots[3])
			}

			// 人物离开画面仍可按脚本续拍。
			leaving := normalize(func(shots []any) {
				shots[0].(map[string]any)["material_ids"] = []any{"owner", "guest", "shop"}
			})
			if leaving[1]["continue_previous"] != true {
				t.Fatalf("a character leaving the frame keeps the continuation: %+v", leaving[1])
			}
			// 作者写明的换场转场不被覆盖。
			authored := normalize(func(shots []any) {
				shots[3].(map[string]any)["transition_type"] = "fadeblack"
				shots[3].(map[string]any)["transition_duration_ms"] = 800
			})
			if authored[3]["transition_type"] != botmodel.StoryboardTransitionFadeBlack || authored[3]["transition_duration_ms"] != 800 {
				t.Fatalf("authored transition must be kept: %+v", authored[3])
			}

			// 同样的角色、场景素材可以换机位，不强制续拍。
			matched := normalize(func(shots []any) {
				shot := shots[1].(map[string]any)
				shot["continue_previous"], shot["match_previous"] = false, true
				shot["start_framing"], shot["end_framing"] = "手部特写", "手部特写"
				shot["continuity_state"] = map[string]any{"entry": "手指压住书页，手部特写可见", "exit": "书页翻开"}
			})
			if matched[1]["continue_previous"] != false || matched[1]["match_previous"] != true || matched[1]["start_framing"] != "手部特写" {
				t.Fatalf("camera change lost its new framing: %+v", matched[1])
			}
			if matched[1]["continuity_state"].(map[string]any)["entry"] != "手指压住书页，手部特写可见" {
				t.Fatal("camera change overwrote the authored close-up state")
			}
			// 独立空镜只用当前场景，不被同场素材推断为续拍。
			independent := normalize(func(shots []any) {
				shot := shots[1].(map[string]any)
				shot["material_ids"] = []any{"shop"}
				shot["continue_previous"], shot["match_previous"] = false, false
			})
			if independent[1]["continue_previous"] != false || independent[1]["match_previous"] != false {
				t.Fatalf("an independent insert must keep its own opening: %+v", independent[1])
			}
			removedProp := normalize(func(shots []any) {
				shots[0].(map[string]any)["material_ids"] = []any{"owner", "shop", "umbrella"}
				shot := shots[1].(map[string]any)
				shot["continue_previous"], shot["match_previous"] = false, false
				shot["continuity_state"] = map[string]any{"entry": "次日老周空手站立", "exit": "老周空手站立"}
			})
			for _, material := range removedProp[1]["material_ids"].([]any) {
				if material == "umbrella" {
					t.Fatal("explicitly absent prop was restored")
				}
			}
			if removedProp[1]["continuity_state"].(map[string]any)["entry"] != "次日老周空手站立" {
				t.Fatal("reset state was overwritten by the previous shot")
			}
		})
	}
}

func TestStoryboardContinuityAllWorkTypesUseShotPlanning(t *testing.T) {
	for _, spec := range botmodel.StoryboardWorkTypeSpecs() {
		input := map[string]any{"storyboard_work_type": spec.Key, botmodel.StoryboardMinShotDurationKey: botmodel.StoryboardDefaultMinShotDuration}
		contract, err := storyboardGenerationContractForRequest(input, 0)
		if err != nil {
			t.Fatal(err)
		}
		prompt, err := storyboardOutputPrompt(contract)
		if err != nil {
			t.Fatal(err)
		}
		for _, retired := range []string{"本次镜头衔接方式：接力", "之后每一段都设 continue_previous=true", "每场戏的第一段必须让这场戏里会出现的所有人物都在画内", "稍后才行动的人物先放在", "让主要人物的脸始终留在画内"} {
			if strings.Contains(prompt, retired) {
				t.Fatal("planning forced a global continuity mode or premature character appearance", spec.Key, retired)
			}
		}
		for _, required := range []string{"逐镜判断衔接", "人物按剧情时机入场", "基于这张实际画面编辑本镜新尾帧", "独立空镜两者都为 false", "光照默认继承", "只有用户或剧情明确安排时间、天气、光源变化时才改变"} {
			if !strings.Contains(prompt, required) {
				t.Fatal("planning lost a shared continuity rule", spec.Key, required)
			}
		}
		for _, retired := range []string{"不超过总镜头数的六分之一", "不超过约 90 度", "系统会自动把后一镜首帧接为前一镜尾帧", "换地点必须有人物的移动过程"} {
			if strings.Contains(prompt, retired) {
				t.Fatal("planning retained a forced creative rule", retired)
			}
		}
	}
}

func TestStoryboardContinuityPreservesLongSpeechAndActualShotTotals(t *testing.T) {
	text := "嘿，地球朋友！这里是山西大同的云冈石窟，一千五百多年前，人们就开始在山崖上雕刻佛像。"
	shot := map[string]any{
		"id": "s1", "duration": 5, "description": "展示石窟全景", "video_prompt": "镜头缓慢推进",
		"material_ids": []any{}, "continuity_state": map[string]any{"entry": "", "exit": ""},
		"speech": []any{map[string]any{"id": "voice", "kind": "narration", "text": text, "start_time": 0.2}},
	}
	output, err := normalizeStoryboardOutput(map[string]any{"target_shot_count": 12, "target_duration": 60, "materials": []any{}, "shots": []any{shot}}, nil,
		storyboardGenerationContract{WorkType: botmodel.StoryboardWorkTypeShort, MinShotDuration: 2, MaxShotDuration: 5, TargetDuration: 60, MinShotCount: 12, MaxShotCount: 30})
	if err != nil {
		t.Fatal(err)
	}
	if output["target_shot_count"] != 1 || output["target_duration"] != 5 {
		t.Fatal("estimated speech or target totals replaced the authored shots")
	}
	actual := output["shots"].([]any)[0].(map[string]any)["speech"].([]any)[0].(map[string]any)
	if actual["text"] != text || actual["start_time"] != 0.2 {
		t.Fatalf("speech was rewritten: %#v", actual)
	}
}
