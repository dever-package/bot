package energon

import (
	"encoding/json"
	"errors"
	"strings"
	"testing"

	botmodel "github.com/dever-package/bot/model/energon"
	botprocessor "github.com/dever-package/bot/service/energon/processor"
	botprotocol "github.com/dever-package/bot/service/energon/protocol"
)

func TestStoryboardContinuityModelDurationOptions(t *testing.T) {
	contract, err := storyboardGenerationContractForRequest(map[string]any{
		botmodel.StoryboardDurationOptionsInputKey: []any{"5", "8", "10"},
	}, 0)
	if err != nil {
		t.Fatal(err)
	}
	if contract.MinShotDuration != botmodel.StoryboardDefaultMinShotDuration || contract.MaxShotDuration != 10 {
		t.Fatalf("video duration mappings were ignored: %#v", contract)
	}
	for requested, want := range map[int]int{4: 5, 6: 8, 8: 8, 10: 10, 12: 10} {
		got, err := normalizeStoryboardShotDuration(requested, contract)
		if err != nil || got != want {
			t.Fatalf("duration %d: wanted %d; got %d, %v", requested, want, got, err)
		}
	}
	for _, example := range []struct{ request, edit, capture int }{{4, 4, 5}, {5, 5, 5}, {6, 6, 8}, {8, 8, 8}, {12, 10, 10}} {
		edit, capture, err := storyboardShotDurations(example.request, contract)
		if err != nil || edit != example.edit || capture != example.capture {
			t.Fatalf("%ds: expected edit=%ds and capture=%ds, got %ds and %ds: %v", example.request, example.edit, example.capture, edit, capture, err)
		}
	}
}

func storyboardContinuityTestShots(modify func(shots []any)) []any {
	shot := func(id string, materials ...any) map[string]any {
		return map[string]any{
			"id": id, "duration": 4, "beat": "动作", "description": "画面", "video_prompt": "表演",
			"camera_instruction": "固定机位", "start_framing": "中景", "end_framing": "中景",
			"material_ids": materials, "transition_type": "none",
			"continuity_state": map[string]any{"entry": "站在柜台前", "exit": "站在柜台前"},
		}
	}
	shots := []any{
		shot("s1", "owner", "shop"),
		shot("s2", "owner", "shop"),
		shot("s3", "owner", "guest", "shop"),
		shot("s4", "owner", "street"),
	}
	shots[1].(map[string]any)["continue_previous"] = true
	shots[2].(map[string]any)["continue_previous"] = true
	modify(shots)
	return shots
}

func TestStoryboardContinuityNormalization(t *testing.T) {
	for _, spec := range botmodel.StoryboardWorkTypeSpecs() {
		t.Run(spec.Key, func(t *testing.T) {
			materialTypes := map[string]string{"owner": "character", "guest": "character", "shop": "scene", "street": "scene", "umbrella": "prop"}
			lookup := map[string]string{"owner": "owner", "guest": "guest", "shop": "shop", "street": "street", "umbrella": "umbrella"}
			normalize := func(modify func([]any)) []map[string]any {
				contract := storyboardGenerationContract{WorkType: spec.Key, MinShotDuration: 2, MaxShotDuration: 15}
				shots, err := normalizeStoryboardShots(storyboardContinuityTestShots(modify), materialTypes, lookup, contract)
				if err != nil {
					t.Fatal(err)
				}
				rows := make([]map[string]any, len(shots))
				for index, shot := range shots {
					rows[index] = shot.(map[string]any)
				}
				return rows
			}

			shots := normalize(func([]any) {})
			if shots[1]["continue_previous"] != true || shots[1]["shot_image_mode"] != botmodel.StoryboardShotImageFirstFrame {
				t.Fatalf("same-camera continuation must not lock an ending by default: %+v", shots[1])
			}
			// 接尾帧的接缝不叠加转场，即使脚本写了也去掉。
			faded := normalize(func(shots []any) {
				shots[1].(map[string]any)["transition_type"] = "fade"
				shots[1].(map[string]any)["transition_duration_ms"] = 500
			})
			if faded[1]["continue_previous"] != true || faded[1]["transition_type"] != botmodel.StoryboardTransitionNone || faded[1]["transition_duration_ms"] != 0 {
				t.Fatalf("a tail-frame seam must not carry a transition: %+v", faded[1])
			}
			// 新人物可随动作入场，起点仍使用上段规划尾图。
			if shots[2]["continue_previous"] != true || shots[2]["match_previous"] != false {
				t.Fatalf("planned entry should retain the shared opening and new ending: %+v", shots[2])
			}
			// 换场生成新首帧，保留脚本的硬切，不强制淡化。
			if shots[3]["continue_previous"] != false || shots[3]["match_previous"] != false ||
				shots[3]["transition_type"] != botmodel.StoryboardTransitionNone || shots[3]["transition_duration_ms"] != 0 {
				t.Fatalf("a scene change must get a new frame and retain the authored cut: %+v", shots[3])
			}

			// 人物离开画面仍可按脚本续拍。
			leaving := normalize(func(shots []any) {
				shots[0].(map[string]any)["material_ids"] = []any{"owner", "guest", "shop"}
			})
			if leaving[1]["continue_previous"] != true {
				t.Fatalf("a character leaving the frame keeps the continuation: %+v", leaving[1])
			}
			// 不以画面特效处理跨时空的接点，保留具体的构图和视线承接。
			authored := normalize(func(shots []any) {
				shot := shots[3].(map[string]any)
				shot["transition_type"], shot["transition_duration_ms"] = "fadeblack", 800
				shot["handoff"] = map[string]any{"incoming": "同向追随从左到右的车灯"}
			})
			if authored[3]["transition_type"] != botmodel.StoryboardTransitionNone || authored[3]["transition_duration_ms"] != 0 ||
				mapField(authored[3], "handoff")["incoming"] != "同向追随从左到右的车灯" {
				t.Fatalf("a spatial cut keeps its visual match, not a transition effect: %+v", authored[3])
			}

			// 同样的角色、场景素材可以换机位，不强制续拍。
			matched := normalize(func(shots []any) {
				shot := shots[1].(map[string]any)
				shot["continue_previous"], shot["match_previous"] = false, true
				shot["start_framing"], shot["end_framing"] = "手部特写", "手部特写"
				shot["continuity_state"] = map[string]any{"entry": "手指压住书页，手部特写可见", "exit": "书页翻开"}
			})
			if matched[1]["continue_previous"] != false || matched[1]["match_previous"] != true || matched[1]["start_framing"] != "手部特写" {
				t.Fatalf("camera change lost its new framing: %+v", matched[1])
			}
			if matched[1]["continuity_state"].(map[string]any)["entry"] != "手指压住书页，手部特写可见" {
				t.Fatal("camera change overwrote the authored close-up state")
			}
			// 独立空镜只用当前场景，不被同场素材推断为续拍。
			independent := normalize(func(shots []any) {
				shot := shots[1].(map[string]any)
				shot["material_ids"] = []any{"shop"}
				shot["continue_previous"], shot["match_previous"] = false, false
			})
			if independent[1]["continue_previous"] != false || independent[1]["match_previous"] != false {
				t.Fatalf("an independent insert must keep its own opening: %+v", independent[1])
			}
			removedProp := normalize(func(shots []any) {
				shots[0].(map[string]any)["material_ids"] = []any{"owner", "shop", "umbrella"}
				shot := shots[1].(map[string]any)
				shot["continue_previous"], shot["match_previous"] = false, false
				shot["continuity_state"] = map[string]any{"entry": "次日老周空手站立", "exit": "老周空手站立"}
			})
			for _, material := range removedProp[1]["material_ids"].([]any) {
				if material == "umbrella" {
					t.Fatal("explicitly absent prop was restored")
				}
			}
			if removedProp[1]["continuity_state"].(map[string]any)["entry"] != "次日老周空手站立" {
				t.Fatal("reset state was overwritten by the previous shot")
			}
		})
	}
}

func TestStoryboardContinuityCameraRouteUsesSharedImageAcrossSpaces(t *testing.T) {
	const path = "沿柜台右侧前移，跟着人物跨过打开的门，街景从门框之间逐步显露"
	const motion = "沿前推的方向与速度继续跟随人物走出门"
	const endpoint = "街边侧后中景，人物向右继续走"
	const opening = "中景，人物从柜台右侧走向门口"
	const staleOpening = "人物已经站在街上"
	const previousMotion = "摄影机正在向门口匀速前推，人物右脚刚抬起"
	const independentMotion = "街边机位向左拉开，人物已站稳"
	items := storyboardContinuityTestShots(func(shots []any) {
		prior := shots[2].(map[string]any)
		prior["end_framing"] = opening
		prior["handoff"] = map[string]any{"outgoing": previousMotion}
		shot := shots[3].(map[string]any)
		shot["continue_previous"] = true
		shot["start_framing"], shot["end_framing"] = staleOpening, endpoint
		shot["handoff"] = map[string]any{"camera_path": path, "incoming": independentMotion}
		shot["camera_instruction"], shot["video_prompt"] = motion, "人物走过门槛"
		shot["shot_image_mode"] = botmodel.StoryboardShotImageFirstLast
	})
	types := map[string]string{"owner": "character", "guest": "character", "shop": "scene", "street": "scene"}
	shots, err := normalizeStoryboardShots(items, types, nil, storyboardGenerationContract{
		WorkType: botmodel.StoryboardWorkTypeShort, MinShotDuration: 2, MaxShotDuration: 15,
	})
	if err != nil {
		t.Fatal(err)
	}
	arrival := shots[3].(map[string]any)
	if arrival["continue_previous"] != true || arrival["start_framing"] != opening || arrival["end_framing"] != endpoint {
		t.Fatalf("the route lost its actual opening or target framing: %+v", arrival)
	}
	if materials := arrival["material_ids"].([]any); len(materials) != 2 || materials[0] != "owner" || materials[1] != "street" {
		t.Fatalf("continuation must not carry unrelated props, locations or people: %+v", materials)
	}
	document := map[string]any{"shots": shots}
	video, err := BuildStoryboardProductionPrompt(document, StoryboardProductionPromptRequest{ItemType: "shot", ItemID: "s4"})
	if err != nil {
		t.Fatal(err)
	}
	for _, want := range []string{"首帧实际可见的姿态、视线、手与道具的接触和机位优先", previousMotion, motion, path, endpoint} {
		if !strings.Contains(video.Prompt, want) {
			t.Fatalf("video model request lost %q: %s", want, video.Prompt)
		}
	}
	if strings.Contains(video.Prompt, staleOpening) || strings.Contains(video.Prompt, independentMotion) {
		t.Fatalf("continued video must open with the prior segment’s framing and motion, not an independent opening: %s", video.Prompt)
	}
	end, err := BuildStoryboardProductionPrompt(document, StoryboardProductionPromptRequest{ItemType: "shot_image", ItemID: "s4", FrameRole: "end"})
	if err != nil || !strings.Contains(end.Prompt, endpoint) || strings.Contains(end.Prompt, path) {
		t.Fatalf("the end image should describe the destination without the camera path: %v %s", err, end.Prompt)
	}

	delete(mapField(items[3].(map[string]any), "handoff"), "camera_path")
	shots, err = normalizeStoryboardShots(items, types, nil, storyboardGenerationContract{
		WorkType: botmodel.StoryboardWorkTypeShort, MinShotDuration: 2, MaxShotDuration: 15,
	})
	if err != nil || shots[3].(map[string]any)["continue_previous"] != false {
		t.Fatalf("different unconnected environments must get their own opening: %v %+v", err, shots)
	}
	if incoming := mapField(shots[3].(map[string]any), "handoff")["incoming"]; incoming != independentMotion {
		t.Fatalf("an actual cut should keep its planned opening motion: %v", incoming)
	}
}

func TestStoryboardContinuityAllWorkTypesUseShotPlanning(t *testing.T) {
	for _, spec := range botmodel.StoryboardWorkTypeSpecs() {
		input := map[string]any{"storyboard_work_type": spec.Key, botmodel.StoryboardMinShotDurationKey: botmodel.StoryboardDefaultMinShotDuration}
		contract, err := storyboardGenerationContractForRequest(input, 0)
		if err != nil {
			t.Fatal(err)
		}
		prompt, err := storyboardOutputPrompt(contract)
		if err != nil {
			t.Fatal(err)
		}
		for _, retired := range []string{"本次镜头衔接方式：接力", "之后每一段都设 continue_previous=true", "每场戏的第一段必须让这场戏里会出现的所有人物都在画内", "稍后才行动的人物先放在", "让主要人物的脸始终留在画内"} {
			if strings.Contains(prompt, retired) {
				t.Fatal("planning forced a global continuity mode or premature character appearance", spec.Key, retired)
			}
		}
		for _, required := range []string{"一条摄影路线", "handoff.camera_path", "每个接点只选一种", "人物按剧情时机入场", "上一段尾帧和下一段首帧", "不等待上一段视频出片", "反打、跳时或独立空镜使用自己的首帧", "光照默认继承", "只有用户或剧情明确安排时间、天气、光源变化时才改变"} {
			if !strings.Contains(prompt, required) {
				t.Fatal("planning lost a shared continuity rule", spec.Key, required)
			}
		}
		for _, retired := range []string{"不超过总镜头数的六分之一", "不超过约 90 度", "系统会自动把后一镜首帧接为前一镜尾帧", "换地点必须有人物的移动过程"} {
			if strings.Contains(prompt, retired) {
				t.Fatal("planning retained a forced creative rule", retired)
			}
		}
	}
}

func TestStoryboardContinuityPreservesLongSpeechAndActualShotTotals(t *testing.T) {
	text := "嘿，地球朋友！这里是山西大同的云冈石窟，一千五百多年前，人们就开始在山崖上雕刻佛像。"
	shot := map[string]any{
		"id": "s1", "duration": 5, "description": "展示石窟全景", "video_prompt": "镜头缓慢推进",
		"material_ids": []any{}, "continuity_state": map[string]any{"facts": []any{}, "time_jump": ""},
		"speech": []any{map[string]any{"id": "voice", "kind": "narration", "text": text, "start_time": 0.2}},
	}
	output, err := normalizeStoryboardOutput(map[string]any{"target_shot_count": 12, "target_duration": 60, "materials": []any{}, "shots": []any{shot}}, nil,
		storyboardGenerationContract{WorkType: botmodel.StoryboardWorkTypeShort, MinShotDuration: 2, MaxShotDuration: 5, TargetDuration: 60, MinShotCount: 12, MaxShotCount: 30})
	if err != nil {
		t.Fatal(err)
	}
	if output["target_shot_count"] != 1 || output["target_duration"] != 5 {
		t.Fatal("estimated speech or target totals replaced the authored shots")
	}
	actual := output["shots"].([]any)[0].(map[string]any)["speech"].([]any)[0].(map[string]any)
	if actual["text"] != text || actual["start_time"] != 0.2 {
		t.Fatalf("speech was rewritten: %#v", actual)
	}
}

func TestStoryboardContinuityTracksActionsAcrossCameraCuts(t *testing.T) {
	const opening = "应急杆拉到底，车门滑开"
	const rescue = "同伴握紧右手向外拉，主角跨过门槛，双脚落在站台"
	const seated = "在座椅上撑坐"
	const threshold = "站在车厢内门槛前，右手尚未握住同伴"
	const clasped = "站在车厢内门槛前，右手已握住同伴"
	const platform = "双脚落在站台地面，右手仍握住同伴"
	fact := func(id, before, after, action string) map[string]any {
		return map[string]any{"material_id": id, "before": before, "after": after, "action": action}
	}
	shot := func(id, framing string, materials []any, facts ...any) map[string]any {
		if facts == nil {
			facts = []any{}
		}
		return map[string]any{
			"id": id, "duration": 5, "description": framing, "video_prompt": "自然表演，保留环境原声",
			"start_framing": framing, "end_framing": framing, "material_ids": materials,
			"match_previous": false, "continue_previous": false,
			"continuity_state": map[string]any{"time_jump": "", "facts": facts},
		}
	}
	trainCast := []any{"train", "actor"}
	input := map[string]any{
		"aspect_ratio":    "9:16",
		"production_plan": map[string]any{"voice_mode": "native", "subtitle_mode": "off"},
		"materials": []any{
			map[string]any{"id": "train", "type": "scene", "name": "车厢", "prompt": "金属车厢，右侧有滑门"},
			map[string]any{"id": "actor", "type": "character", "name": "主角", "prompt": "深色外套"},
		},
		"shots": []any{
			shot("wake", "车厢内中景", trainCast, fact("actor", "躺在座椅上", seated, "主角用肘撑起上身"), fact("train", "滑门关闭", "", "")),
			shot("open", "门边侧机位", trainCast, fact("train", "滑门关闭", "滑门开启", opening), fact("actor", seated, threshold, "主角起身走到门槛前")),
			shot("reaction", "角色面部特写，车门在画外", []any{"actor"}),
			shot("reach", "站台侧手部近景", trainCast, fact("actor", threshold, clasped, "主角伸手并握住同伴的手")),
			shot("rescue", "侧面全景显示门槛和站台", trainCast, fact("actor", clasped, platform, rescue)),
			shot("settle", "站台中景", trainCast, fact("train", "滑门开启", "滑门关闭", "主角已在站台，滑门合拢")),
		},
	}
	duration := storyboardGenerationContract{WorkType: botmodel.StoryboardWorkTypeShort, MinShotDuration: 2, MaxShotDuration: 5}
	output, err := normalizeStoryboardOutput(input, nil, duration)
	if err != nil {
		t.Fatal(err)
	}
	promptFor := func(item, kind, role string) string {
		t.Helper()
		projection, err := BuildStoryboardProductionPrompt(output, StoryboardProductionPromptRequest{ItemID: item, ItemType: kind, FrameRole: role, NativeAudio: true})
		if err != nil {
			t.Fatal(err)
		}
		if projection.AspectRatio != "9:16" {
			t.Fatalf("expected vertical shot, got %s", projection.AspectRatio)
		}
		return projection.Prompt
	}
	if directCut := promptFor("open", "shot_image", "start"); !strings.Contains(directCut, "主角："+seated) || !strings.Contains(directCut, "门边侧机位") {
		t.Fatal("a camera cut must keep the end pose, not the old framing", directCut)
	}
	if offscreen := promptFor("reaction", "shot_image", "start"); strings.Contains(offscreen, "车厢：滑门") {
		t.Fatal("offscreen facts must not put the door back in frame", offscreen)
	}
	if start := promptFor("rescue", "shot_image", "start"); !strings.Contains(start, "主角："+clasped) {
		t.Fatal("rescue must start at the already clasped hand and the threshold", start)
	}
	if end := promptFor("rescue", "shot_image", "end"); !strings.Contains(end, "主角："+platform) || !strings.Contains(end, "车厢：滑门开启") || strings.Contains(end, "车厢内门槛前") {
		t.Fatal("rescue must end with both characters out before any door closing", end)
	}
	if start := promptFor("settle", "shot_image", "start"); !strings.Contains(start, "主角："+platform) || strings.Contains(start, "车厢内门槛前") {
		t.Fatal("the cut must inherit the platform state only", start)
	}
	if video := promptFor("rescue", "shot", ""); !strings.Contains(video, rescue) || strings.Contains(video, opening) || !strings.Contains(video, "不得先变再变回") {
		t.Fatal("the video must play the crossing without replaying the opening", video)
	}
	shots := output["shots"].([]any)
	crossing := mapField(shots[4].(map[string]any), "continuity_state")
	crossingFacts := crossing["facts"].([]any)
	crossing["facts"] = []any{fact("actor", "右手已握住同伴", platform, rescue)}
	if err := ResolveStoryboardContinuity(output); err == nil || !strings.Contains(err.Error(), "镜头 4→5 接不上") {
		t.Fatalf("a partial state must not silently preserve the old position: %v", err)
	}
	crossing["facts"] = []any{crossingFacts[0], fact("actor", clasped, "站在车厢内门槛前", "主角站起来")}
	if err := ResolveStoryboardContinuity(output); err == nil || !strings.Contains(err.Error(), "重复安排") {
		t.Fatalf("a second state for the same actor must be rejected: %v", err)
	}
	crossing["facts"] = crossingFacts
	closing := mapField(shots[5].(map[string]any), "continuity_state")
	closingFact := closing["facts"].([]any)[0].(map[string]any)
	closingFact["before"] = "半关"
	if err := ResolveStoryboardContinuity(output); err == nil || !strings.Contains(err.Error(), "镜头 5→6 接不上") {
		t.Fatalf("unexpected change between adjacent shots: %v", err)
	}
	closing["time_jump"] = "十分钟后，站台只剩主角"
	if err := ResolveStoryboardContinuity(output); err != nil {
		t.Fatalf("a planned time jump can establish a new starting state: %v", err)
	}
	closingFact["action"] = ""
	if err := ResolveStoryboardContinuity(output); err == nil || !strings.Contains(err.Error(), "本镜实际演出") {
		t.Fatalf("a jump does not authorize actionless changes inside a shot: %v", err)
	}
}

func TestStoryboardContinuityVideoVerdictRequiresObservedFrames(t *testing.T) {
	sheets := []botprocessor.VideoReviewSheet{{SampleTimes: []float64{0, 0.5, 1, 1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5}}}
	verdict := func(status, evidence string, sheet, frame int) botprotocol.Output {
		arguments, err := json.Marshal(map[string]any{"status": status, "evidence": evidence, "sheet": sheet, "frame": frame})
		if err != nil {
			t.Fatal(err)
		}
		return botprotocol.Output{"tool_calls": []any{map[string]any{"type": "function", "function": map[string]any{"name": storyboardVideoReviewTool, "arguments": string(arguments)}}}}
	}
	var failure *StoryboardVideoReviewFailure
	if err := validateStoryboardVideoReview(verdict("fail", "首尾车门闭合，但第六格可见车门打开", 1, 6), sheets); !errors.As(err, &failure) || failure.Seconds != 2.5 {
		t.Fatalf("an opening between closed endpoints must block the shot: %v", err)
	}
	if err := validateStoryboardVideoReview(verdict("pass", "车门从首格到末格都闭合", 0, 0), sheets); err != nil {
		t.Fatal(err)
	}
	if err := validateStoryboardVideoReview(verdict("unobservable", "没有收到任何图片", 0, 0), sheets); err == nil || errors.As(err, &failure) {
		t.Fatal("missing visual evidence must never pass")
	}
	if err := validateStoryboardVideoReview(verdict("fail", "第十二格有异常", 1, 12), sheets); err == nil || !strings.Contains(err.Error(), "采样位置不符") {
		t.Fatalf("an unused cell must not count as evidence: %v", err)
	}
}

func TestStoryboardContinuitySeamUsesOnlySafeCuts(t *testing.T) {
	tail := botprocessor.VideoReviewEdge{Sheet: botprocessor.VideoReviewSheet{SampleTimes: []float64{4.4, 4.6, 4.8, 5}}, SafeCuts: []int{2, 3, 4}}
	head := botprocessor.VideoReviewEdge{Sheet: botprocessor.VideoReviewSheet{SampleTimes: []float64{0, 0.2, 0.4, 0.6}}, SafeCuts: []int{1}}
	verdict := func(status, evidence string, end, start int) botprotocol.Output {
		arguments, err := json.Marshal(map[string]any{"status": status, "evidence": evidence, "tail": end, "head": start})
		if err != nil {
			t.Fatal(err)
		}
		return botprotocol.Output{"tool_calls": []any{map[string]any{"type": "function", "function": map[string]any{"name": storyboardSeamReviewTool, "arguments": string(arguments)}}}}
	}
	end, start, err := validateStoryboardSeamReview(verdict("pass", "碗停在桌沿，对方在下一格看向碗", 3, 1), tail, head)
	if err != nil || end != 4.8 || start != 0 {
		t.Fatalf("expected only tail to be shortened: %v, %v, %v", end, start, err)
	}
	if _, _, err := validateStoryboardSeamReview(verdict("pass", "想裁掉入场", 3, 2), tail, head); err == nil {
		t.Fatal("a cut in protected audio must never pass")
	}
	if _, _, err := validateStoryboardSeamReview(verdict("pass", "", 4, 1), tail, head); err == nil {
		t.Fatal("a cut without observed evidence must never pass")
	}
	if _, _, err := validateStoryboardSeamReview(verdict("unobservable", "看不清道具", 0, 0), tail, head); err == nil {
		t.Fatal("unobservable seams must never pass")
	}
}

func TestStoryboardContinuitySavedSceneBoundary(t *testing.T) {
	request := map[string]any{storyboardScreenplayInputKey: map[string]any{
		"screenplay": map[string]any{"parts": []any{
			map[string]any{"connection": "reset"},
			map[string]any{"connection": "continue"},
			map[string]any{"connection": "match"},
			map[string]any{"connection": "reset"},
		}},
	}}
	opening := map[string]any{"scene_index": 1, "continue_previous": true}
	reverse := map[string]any{"scene_index": 2, "match_previous": true, "continue_previous": false}
	carry := map[string]any{"scene_index": 3, "match_previous": false, "continue_previous": true}
	reset := map[string]any{"scene_index": 4, "continue_previous": true}
	if err := applyStoryboardSceneConnections(map[string]any{"shots": []any{opening, reverse, carry, reset}}, request); err != nil {
		t.Fatal(err)
	}
	if opening["continue_previous"] != false || reset["continue_previous"] != false ||
		reverse["match_previous"] != true || reverse["continue_previous"] != false ||
		carry["match_previous"] != false || carry["continue_previous"] != true {
		t.Fatalf("chapter scene metadata overrode the camera plan or lost a reset: %v %v %v %v", opening, reverse, carry, reset)
	}
}

func TestStoryboardContinuityActionCutUsesSamePlannedInstant(t *testing.T) {
	const plannedStart = "盒盖仍微开"
	const newFraming = "右侧手部特写"
	const previousExit = "右手仍按在关上的盒盖上"
	const nextAction = "店主收手，抬眼看向门口。"
	rows := storyboardContinuityTestShots(func(shots []any) {
		for _, index := range []int{0, 2, 3} {
			shot := shots[index].(map[string]any)
			shot["continue_previous"], shot["match_previous"] = false, true
			shot["handoff"] = map[string]any{"match_action": true, "incoming": plannedStart}
		}
		cut := shots[2].(map[string]any)
		mapField(shots[1].(map[string]any), "continuity_state")["exit"] = previousExit
		cut["camera_instruction"] = "固定机位从桌子右侧取景"
		cut["start_framing"] = newFraming
		cut["description"] = plannedStart + "，右手压下盒盖。"
		cut["video_prompt"] = nextAction
		cut["continuity_state"] = map[string]any{"entry": plannedStart, "exit": "右手从关上的盒盖抬起"}
	})
	types := map[string]string{"owner": "character", "guest": "character", "shop": "scene", "street": "scene"}
	lookup := map[string]string{"owner": "owner", "guest": "guest", "shop": "shop", "street": "street"}
	shots, err := normalizeStoryboardShots(rows, types, lookup, storyboardGenerationContract{WorkType: botmodel.StoryboardWorkTypeShort, MinShotDuration: 2, MaxShotDuration: 5})
	if err != nil {
		t.Fatal(err)
	}
	for i, raw := range shots {
		if marked := mapField(raw.(map[string]any), "handoff")["match_action"] == true; marked != (i == 2) {
			t.Fatalf("shot %d got incorrect action-cut flag: %t", i+1, marked)
		}
	}
	plan := map[string]any{"output_target": "final_video"}
	doc := map[string]any{"shots": shots, "production_plan": plan}
	imageReq := StoryboardProductionPromptRequest{ItemType: "shot_image", ItemID: "s3", ShotImageMode: "first_frame"}
	image, err := BuildStoryboardProductionPrompt(doc, imageReq)
	if err != nil {
		t.Fatal(err)
	}
	if !strings.HasPrefix(image.Prompt, "第一张参考图是上一镜的规划尾图") ||
		!strings.Contains(image.Prompt, newFraming) || !strings.Contains(image.Prompt, previousExit) || strings.Contains(image.Prompt, plannedStart) {
		t.Fatalf("new angle does not reframe the planned boundary state: %s", image.Prompt)
	}
	video, err := BuildStoryboardProductionPrompt(doc, StoryboardProductionPromptRequest{ItemType: "shot", ItemID: "s3", ShotImageMode: "first_frame"})
	if err != nil {
		t.Fatal(err)
	}
	if video.ReferenceMode != "frames" || !strings.HasPrefix(video.Prompt, "从本镜新机位首帧") ||
		strings.Contains(video.Prompt, plannedStart) || strings.Contains(video.Prompt, "右手压下盒盖") ||
		!strings.Contains(video.Prompt, nextAction) || !strings.Contains(video.Prompt, "右手从关上的盒盖抬起") {
		t.Fatalf("video does not start at the new opening and advance: %+v", video)
	}
	plan["output_target"] = "shot_images"
	preview, err := BuildStoryboardProductionPrompt(doc, imageReq)
	if err != nil || preview.Prompt != image.Prompt {
		t.Fatalf("image-only and video plans should use the same frame: %v %s", err, preview.Prompt)
	}
}

func TestStoryboardContinuityCutDirectionsReachOnlyTheirOwnShot(t *testing.T) {
	const sharedAction = "右手刚触到封面边缘"
	const newSceneAction = "门外雨水从招牌流下"
	rows := storyboardContinuityTestShots(func(shots []any) {
		shots[1].(map[string]any)["handoff"] = map[string]any{"outgoing": sharedAction}
		shots[2].(map[string]any)["continue_previous"] = false
		shots[2].(map[string]any)["match_previous"] = true
		shots[2].(map[string]any)["handoff"] = map[string]any{"incoming": sharedAction}
		shots[3].(map[string]any)["handoff"] = map[string]any{"incoming": newSceneAction, "outgoing": newSceneAction, "sound_cue": "门外雨声", "sound_lead_ms": 500}
	})
	types := map[string]string{"owner": "character", "guest": "character", "shop": "scene", "street": "scene"}
	lookup := map[string]string{"owner": "owner", "guest": "guest", "shop": "shop", "street": "street"}
	shots, err := normalizeStoryboardShots(rows, types, lookup, storyboardGenerationContract{WorkType: botmodel.StoryboardWorkTypeShort, MinShotDuration: 2, MaxShotDuration: 5})
	if err != nil {
		t.Fatal(err)
	}
	doc := map[string]any{"shots": shots, "work_type": "short"}
	video, err := BuildStoryboardProductionPrompt(doc, StoryboardProductionPromptRequest{ItemType: "shot", ItemID: "s2", NativeAudio: true})
	if err != nil {
		t.Fatal(err)
	}
	if !strings.Contains(video.Prompt, "本镜出点："+sharedAction) || strings.Contains(video.Prompt, newSceneAction) {
		t.Fatalf("wrong outgoing action: %s", video.Prompt)
	}
	image, err := BuildStoryboardProductionPrompt(doc, StoryboardProductionPromptRequest{ItemType: "shot_image", ItemID: "s3", FrameRole: "start"})
	if err != nil {
		t.Fatal(err)
	}
	if strings.Contains(image.Prompt, sharedAction) || strings.Contains(image.Prompt, newSceneAction) {
		t.Fatalf("static image received instructions for motion: %s", image.Prompt)
	}
	if got := mapField(shots[3].(map[string]any), "handoff")["sound_lead_ms"]; got != 500 {
		t.Fatalf("lost authored sound lead: %v", got)
	}
}
