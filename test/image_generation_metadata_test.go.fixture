package asset

import (
	"encoding/json"
	"reflect"
	"testing"

	assetmodel "github.com/dever-package/bot/model/asset"
	botprotocol "github.com/dever-package/bot/service/energon/protocol"
)

func TestImageGenerationAssetMetadata(t *testing.T) {
	for _, images := range [][]string{
		{"https://example.invalid/first.png"},
		{"https://example.invalid/first.png", "https://example.invalid/second.png"},
	} {
		t.Run(images[len(images)-1], func(t *testing.T) {
			meta := map[string]any{
				"output_type": "general", "semantic_planning": true,
				"service_id": uint64(12), "service_name": "实际生图来源",
				"title": "门前的两个人", "summary": "先等候，再开门",
				"visual_bible": "两个穿相同衣服的人", "aspect_ratio": "16:9",
				"requested_count": len(images), "generated_count": len(images), "partial": false,
				"items": []map[string]any{{"order": 1, "prompt": "站在门前"}},
			}
			rawMeta := make(map[string]any, len(meta)+2)
			for key, value := range meta {
				rawMeta[key] = value
			}
			rawMeta["generation_stage"] = "generating"
			rawMeta["provider_debug"] = "不属于资产"
			raw := botprotocol.Output{"event": "final", "images": images, "meta": rawMeta}
			document := EnsureDocument(raw, assetmodel.KindImage)
			if !reflect.DeepEqual(document["meta"], meta) {
				t.Fatalf("生成计划或来源丢失：%#v", document["meta"])
			}
			if got := ContentMediaURLs(document, assetmodel.KindImage); !reflect.DeepEqual(got, images) {
				t.Fatalf("保存计划改变图片顺序：%v", got)
			}
			if rawMeta["generation_stage"] != "generating" || len(rawMeta) != len(meta)+2 {
				t.Fatal("保存资产修改了原始流式输出")
			}
			encoded, err := json.Marshal(document)
			if err != nil {
				t.Fatal(err)
			}
			var reloaded map[string]any
			if err := json.Unmarshal(encoded, &reloaded); err != nil {
				t.Fatal(err)
			}
			resaved := EnsureDocument(reloaded, assetmodel.KindImage)
			if !reflect.DeepEqual(resaved["meta"], reloaded["meta"]) ||
				!reflect.DeepEqual(ContentMediaURLs(resaved, assetmodel.KindImage), images) {
				t.Fatal("图片文档重新读取或保存后丢失元信息")
			}
		})
	}
	t.Run("没有生成元信息的图片保持原有文档", func(t *testing.T) {
		for _, meta := range []any{nil, map[string]any{"provider_debug": "调试信息"}} {
			document := EnsureDocument(botprotocol.Output{
				"images": []string{"https://example.invalid/image.png"}, "meta": meta,
			}, assetmodel.KindImage)
			if _, exists := document["meta"]; exists {
				t.Fatal("普通图片被附加了无关元信息")
			}
		}
	})
}
