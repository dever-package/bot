	for _, scenario := range []string{"rotated credential", "disabled account"} {
		t.Run("recheck queued "+scenario, func(t *testing.T) {
			holds := []*botschedule.Lease{}
			for i := 0; i < 2; i++ {
				id := fmt.Sprintf("hold-%s-%d", scenario, i)
				lease, err := broker.Acquire(ctx, id, id, "18", []botschedule.Account{{ID: 18, Limit: 2}}, nil, nil)
				if err != nil {
					t.Fatal(err)
				}
				holds = append(holds, lease)
			}
			id := "queued-" + strings.ReplaceAll(scenario, " ", "-")
			result := make(chan botprotocol.Response, 1)
			before := posts.Load()
			go func() { result <- gateway.Request(ctx, request(id)) }()
			deadline := time.Now().Add(2 * time.Second)
			for {
				row := botmodel.NewExecutionModel().Find(ctx, map[string]any{"request_id": id})
				if row != nil && row.Phase == "queued" && row.QueuePosition > 0 {
					break
				}
				if time.Now().After(deadline) {
					t.Fatal("request did not queue")
				}
				time.Sleep(5 * time.Millisecond)
			}
			if scenario == "rotated credential" {
				botmodel.NewAccountModel().Update(ctx, map[string]any{"id": 18}, map[string]any{"key": "rotated-key"})
				expectedKey.Store("rotated-key")
			} else {
				botmodel.NewAccountModel().Update(ctx, map[string]any{"id": 18}, map[string]any{"status": 2})
			}
			if err := holds[0].Release(ctx); err != nil {
				t.Fatal(err)
			}
			response := <-result
			if scenario == "rotated credential" {
				if response.Status != 1 || posts.Load() != before+1 {
					t.Fatal(response)
				}
			} else {
				if response.Status != 2 || posts.Load() != before {
					t.Fatal("disabled queued account submitted", response)
				}
			}
			if err := holds[1].Release(ctx); err != nil {
				t.Fatal(err)
			}
			botmodel.NewAccountModel().Update(ctx, map[string]any{"id": 18}, map[string]any{"key": "test-key", "status": 1})
			expectedKey.Store("test-key")
			stats, err := runtimefixture.AccountUsage(ctx, broker, 18)
			if err != nil || stats["active_tasks"] != 0 || stats["waiting_tasks"] != 0 {
				t.Fatal("failed admission leaked account slot", stats, err)
			}
		})
	}

	t.Run("terminal receipt reconciles a process exit before Redis release", func(t *testing.T) {
		state := bottask.WithDefaultStore(ctx)
		cp, err := prepareExecution(state, "release-crash")
		if err != nil {
			t.Fatal(err)
		}
		cp.Stage = bottask.ExecutionSubmitted
		cp.RemoteTaskID = "already-done"
		if _, err = bottask.Store(state).Save(ctx, bottask.ExecutionChange{Checkpoint: *cp}); err != nil {
			t.Fatal(err)
		}
		cp.RemoteResponse = &botprovider.Response{StatusCode: 200, Body: map[string]any{"status": "done"}}
		if _, err = bottask.Store(state).Save(ctx, bottask.ExecutionChange{Checkpoint: *cp, FactsOnly: true}); err != nil {
			t.Fatal(err)
		}
		botmodel.NewExecutionModel().Update(ctx, map[string]any{"request_id": cp.RequestID}, map[string]any{"task_outstanding": true})
		if _, err := broker.Adopt(ctx, cp.RequestID, "dead-worker", 18); err != nil {
			t.Fatal(err)
		}
		if err := broker.Client.Del(ctx, broker.Prefix+":reconcile-tick").Err(); err != nil {
			t.Fatal(err)
		}
		if err := reconcileFinishedSources(ctx, broker); err != nil {
			t.Fatal(err)
		}
		stats, err := runtimefixture.AccountUsage(ctx, broker, 18)
		if err != nil || stats["active_tasks"] != 0 {
			t.Fatal("finished job leaked account slot after crash", stats, err)
		}
	})
	t.Run("distributed cancellation during busy backoff never submits another attempt", func(t *testing.T) {
		busyMode.Store(true)
		defer busyMode.Store(false)
		id := "stop-during-retry"
		result := make(chan botprotocol.Response, 1)
		go func() { result <- gateway.Request(ctx, request(id)) }()
		select {
		case <-firstBusy:
		case <-time.After(3 * time.Second):
			t.Fatal("provider did not reject first attempt")
		}
		if err := gateway.CancelSource(ctx, id); err != nil {
			t.Fatal(err)
		}
		response := <-result
		if response.Status != 2 || busyCalls.Load() != 1 {
			t.Fatal("canceled retry submitted again", response, busyCalls.Load())
		}
		cp, err := (bottask.DatabaseStore{}).Load(ctx, id)
		if err != nil || cp.Failure == "" {
			t.Fatal("proven rejection not durable", cp, err)
		}
		stats, err := runtimefixture.AccountUsage(ctx, broker, 18)
		if err != nil || stats["active_tasks"] != 0 {
			t.Fatal("known rejection retained a task slot", stats, err)
		}
	})

	waitPersisted := func(t *testing.T, id string) {
		t.Helper()
		deadline := time.Now().Add(3 * time.Second)
		for time.Now().Before(deadline) {
			cp, err := (bottask.DatabaseStore{}).Load(ctx, id)
			if err != nil || cp.Failure != "" {
				t.Fatalf("recovery failed: %+v %v", cp, err)
			}
			if cp.Persisted != nil {
				return
			}
			time.Sleep(10 * time.Millisecond)
		}
		t.Fatal("recovery did not persist the original request", id)
	}
	t.Run("queue rejection stays terminal while accepted recovery waits for capacity", func(t *testing.T) {
		full := bottask.NewInlineQueue(bottask.HandlerFunc(func(ctx context.Context, _ bottask.Job) error { <-ctx.Done(); return ctx.Err() }), time.Minute)
		capacity := botruntimeconfig.Load().QueueCapacity
		for i := 0; i < capacity; i++ {
			if err := full.Push(ctx, bottask.Job{RequestID: fmt.Sprintf("capacity-holder-%d", i)}); err != nil {
				t.Fatal(err)
			}
		}
		original := gateway.tasks
		gateway.tasks = bottask.NewService(full)
		defer func() { gateway.tasks = original }()
		defer func() {
			for i := 0; i < capacity; i++ {
				full.Cancel(ctx, fmt.Sprintf("capacity-holder-%d", i))
			}
			shutdown, cancel := context.WithTimeout(ctx, 2*time.Second)
			defer cancel()
			if err := full.Shutdown(shutdown); err != nil {
				t.Error(err)
			}
		}()
		before := posts.Load()
		rejected := request("queue-rejected")
		rejected.Body["options"] = map[string]any{"stream": true}
		response := gateway.Request(ctx, rejected)
		cp, err := (bottask.DatabaseStore{}).Load(ctx, rejected.RequestID)
		if err != nil || response.Status != 2 || cp.Failure == "" {
			t.Fatalf("queue rejection was not durable: %+v %+v %v", response, cp, err)
		}
		accepted := request("accepted-before-restart")
		state := bottask.WithDefaultStore(ctx)
		if _, err := prepareExecution(state, accepted.RequestID); err != nil {
			t.Fatal(err)
		}
		if err := saveSourceRequest(state, accepted); err != nil {
			t.Fatal(err)
		}
		for _, id := range []string{rejected.RequestID, accepted.RequestID} {
			botmodel.NewExecutionModel().Update(ctx, map[string]any{"request_id": id}, map[string]any{"created_at": time.Now().Add(-time.Minute)})
		}
		if err := gateway.recoverSources(ctx); err == nil || !strings.Contains(err.Error(), "队列已满") {
			t.Fatal("full recovery queue should report its actual error", err)
		}
		cp, err = (bottask.DatabaseStore{}).Load(ctx, accepted.RequestID)
		if err != nil || cp.Failure != "" || posts.Load() != before {
			t.Fatalf("accepted work was failed or rejected work was submitted: %+v %v", cp, err)
		}
		gateway.tasks = original
		if err := gateway.recoverSources(ctx); err != nil {
			t.Fatal(err)
		}
		waitPersisted(t, accepted.RequestID)
		if posts.Load() != before+1 {
			t.Fatal("rejected request was recovered into an extra POST", posts.Load()-before)
		}
		response = gateway.Request(ctx, rejected)
		if response.Status != 2 || posts.Load() != before+1 {
			t.Fatal("rejected request became executable", response)
		}
	})

	t.Run("explicit media account rejection releases account slot and preserves the actual error", func(t *testing.T) {
		botmodel.NewServiceModel().Insert(ctx, map[string]any{"id": 41, "provider_id": 7, "name": "image", "type": "image", "path": "images/generations", "status": 1})
		botmodel.NewServiceEndpointModel().Insert(ctx, map[string]any{"id": 48, "service_id": 41, "api": "grok-imagine-image-2.0", "interface_type": "model", "status": 1})
		botmodel.NewPowerModel().Insert(ctx, map[string]any{"id": 3, "key": "image", "name": "Image", "kind": "image", "status": 1})
		botmodel.NewPowerTargetModel().Insert(ctx, map[string]any{"id": 3, "power_id": 3, "service_id": 41, "status": 1})
		rejectionMode.Store(1)
		defer rejectionMode.Store(0)
		before := posts.Load()
		req := GatewayRequest{RequestID: "media-account-rejected", Body: map[string]any{"power": "image", "input": map[string]any{"prompt": "a boat"}}}
		response := gateway.Request(ctx, req)
		cp, err := (bottask.DatabaseStore{}).Load(ctx, req.RequestID)
		row := botmodel.NewExecutionModel().Find(ctx, map[string]any{"request_id": req.RequestID})
		if err != nil || response.Status != 2 || !strings.Contains(response.Msg, "grok_media_no_eligible_account") || cp.Failure == "" || row.TaskOutstanding || row.Phase != "failed" || posts.Load() != before+1 {
			t.Fatalf("explicit rejection became an ambiguous task: response=%+v checkpoint=%+v row=%+v posts=%d err=%v", response, cp, row, posts.Load()-before, err)
		}
		stats, err := runtimefixture.AccountUsage(ctx, broker, 18)
		if err != nil || stats["active_tasks"] != 0 {
			t.Fatal("rejected media submission retained account slot", stats, err)
		}
		response = gateway.Request(ctx, req)
		if response.Status != 2 || posts.Load() != before+1 {
			t.Fatal("rejected submission was automatically repeated", response, posts.Load()-before)
		}
		streamed := GatewayRequest{RequestID: "streamed-media-account-rejected", Body: map[string]any{"power": "image", "input": map[string]any{"prompt": "a boat"}, "options": map[string]any{"stream": true}}}
		response = gateway.Request(ctx, streamed)
		if response.Status != 1 {
			t.Fatal("streamed rejection was not admitted", response)
		}
		deadline := time.Now().Add(3 * time.Second)
		for {
			cp, err = (bottask.DatabaseStore{}).Load(ctx, streamed.RequestID)
			if err != nil {
				t.Fatal(err)
			}
			if cp.Failure != "" {
				break
			}
			if time.Now().After(deadline) {
				t.Fatal("streamed media rejection never reached a terminal receipt")
			}
			time.Sleep(10 * time.Millisecond)
		}
		row = botmodel.NewExecutionModel().Find(ctx, map[string]any{"request_id": streamed.RequestID})
		stats, err = runtimefixture.AccountUsage(ctx, broker, 18)
		if err != nil || !strings.Contains(cp.Failure, "grok_media_no_eligible_account") || row.Phase != "failed" || row.TaskOutstanding || stats["active_tasks"] != 0 || posts.Load() != before+2 {
			t.Fatalf("streamed rejection retained its account slot or lost its cause: checkpoint=%+v row=%+v stats=%+v posts=%d err=%v", cp, row, stats, posts.Load()-before, err)
		}
		rejectionMode.Store(0)
		response = gateway.Request(ctx, request("after-media-account-rejection"))
		if response.Status != 1 || posts.Load() != before+3 {
			t.Fatal("explicit rejection blocked the following request", response, posts.Load()-before)
		}
	})
	t.Run("unclassified 503 retains account slot without repeating the submission", func(t *testing.T) {
		rejectionMode.Store(2)
		defer rejectionMode.Store(0)
		before := posts.Load()
		req := request("ambiguous-503")
		response := gateway.Request(ctx, req)
		row := botmodel.NewExecutionModel().Find(ctx, map[string]any{"request_id": req.RequestID})
		if response.Status != 2 || !row.TaskOutstanding || row.Phase != "unknown" || !strings.Contains(row.LastError, "upstream unavailable") || posts.Load() != before+1 {
			t.Fatalf("ambiguous 503 lost its receipt: response=%+v row=%+v posts=%d", response, row, posts.Load()-before)
		}
		response = gateway.Request(ctx, req)
		if response.Status != 2 || posts.Load() != before+1 {
			t.Fatal("ambiguous 503 was automatically repeated", response, posts.Load()-before)
		}
		confirmRemoteEnded(req.RequestID)
	})

	t.Run("late response preserves a parent failure written during HTTP", func(t *testing.T) {
		state := bottask.WithDefaultStore(ctx)
		raw := request("late-parent-response")
		if _, err := prepareExecution(state, raw.RequestID); err != nil {
			t.Fatal(err)
		}
		normalized, err := gateway.normalizeGatewayRequest(raw, ModeNormalize)
		if err != nil {
			t.Fatal(err)
		}
		power, _ := gateway.repo.Power(ctx, 1)
		target, _ := gateway.repo.FindPowerTarget(ctx, 1)
		selected, err := gateway.selectTarget(ctx, power, target, "")
		if err != nil {
			t.Fatal(err)
		}
		prepared, _, err := gateway.prepareRemoteCall(state, normalized, selected)
		if err != nil {
			t.Fatal(err)
		}
		admitted, _, err := gateway.acquireRemoteResource(state, prepared)
		if err != nil {
			t.Fatal(err)
		}
		defer finishSourceCall(admitted)
		if _, err := gateway.beginRemoteExecution(admitted, prepared); err != nil {
			t.Fatal(err)
		}
		store := bottask.Store(admitted)
		client := sourceClient{base: afterSourceResponseClient{Client: botprovider.NewHTTPClient(time.Second), after: func() error {
			cp, err := store.Load(admitted, raw.RequestID)
			if err != nil {
				return err
			}
			cp.Failure = "parent stopped while HTTP was in flight"
			_, err = store.Save(admitted, bottask.ExecutionChange{Checkpoint: *cp})
			return err
		}}}
		if _, err := client.Do(admitted, prepared.NativeRequest); err != nil {
			t.Fatal(err)
		}
		cp, err := store.Load(ctx, raw.RequestID)
		if err != nil || cp.SubmissionResponse == nil || cp.Failure != "parent stopped while HTTP was in flight" {
			t.Fatalf("late receipt lost the response or overwrote the parent failure: %#v %v", cp, err)
		}
	})

	for _, protocol := range []string{"local", "webcontent", "unregistered-protocol", "corrupt-checkpoint", "corrupt-request"} {
		t.Run("recovery isolates "+protocol+" from unrelated sources", func(t *testing.T) {
			id := "interrupted-" + protocol
			state := bottask.WithDefaultStore(ctx)
			cp, err := prepareExecution(state, id)
			if err != nil {
				t.Fatal(err)
			}
			if err := saveSourceRequest(state, request(id)); err != nil {
				t.Fatal(err)
			}
			cp.Protocol, cp.Stage = protocol, bottask.ExecutionSubmitting
			if protocol == "corrupt-request" {
				cp.Protocol, cp.Stage = "openai", bottask.ExecutionPrepared
			}
			if _, err := bottask.Store(state).Save(ctx, bottask.ExecutionChange{Checkpoint: *cp}); err != nil {
				t.Fatal(err)
			}
			values := map[string]any{"phase": "unknown", "task_outstanding": true, "expires_at": time.Now().Add(-time.Minute)}
			if protocol == "corrupt-checkpoint" {
				values["checkpoint"] = "{"
			} else if protocol == "corrupt-request" {
				values["request"] = "{"
			}
			botmodel.NewExecutionModel().Update(ctx, map[string]any{"request_id": id}, values)
			defer botmodel.NewExecutionModel().Delete(ctx, map[string]any{"request_id": id})
			healthy := request("recoverable-after-" + protocol)
			fresh := bottask.WithDefaultStore(ctx)
			if _, err := prepareExecution(fresh, healthy.RequestID); err != nil {
				t.Fatal(err)
			}
			if err := saveSourceRequest(fresh, healthy); err != nil {
				t.Fatal(err)
			}
			botmodel.NewExecutionModel().Update(ctx, map[string]any{"request_id": healthy.RequestID}, map[string]any{"created_at": time.Now().Add(-time.Minute)})
			before := posts.Load()
			err = gateway.recoverSources(ctx)
			if protocol == "local" || protocol == "webcontent" {
				if err != nil {
					t.Fatal("non-queryable local work should await reconciliation", err)
				}
			} else if err == nil || !strings.Contains(err.Error(), id) {
				t.Fatal("receipt error was hidden or lost its identity", err)
			}
			waitPersisted(t, healthy.RequestID)
			row := botmodel.NewExecutionModel().Find(ctx, map[string]any{"request_id": id})
			if posts.Load() != before+1 || !row.TaskOutstanding || row.Phase != "unknown" {
				t.Fatalf("ambiguous source was repeated or blocked unrelated work: %+v posts=%d", row, posts.Load()-before)
			}
		})
	}

	readCheckpoint := func(t *testing.T, id string) *bottask.ExecutionCheckpoint {
		t.Helper()
		cp, err := (bottask.DatabaseStore{}).Load(ctx, id)
		if err != nil || cp == nil {
			t.Fatal("checkpoint missing", id, err)
		}
		return cp
	}
	waitOriginalTimeout := func(t *testing.T, cp *bottask.ExecutionCheckpoint) {
		t.Helper()
		remaining := time.Until(cp.SubmissionDeadline)
		if remaining <= 0 || remaining > time.Second {
			t.Fatalf("original HTTP timeout was not recorded: %v", remaining)
		}
		time.Sleep(remaining + 20*time.Millisecond)
	}
	for _, scenario := range []string{"recover", "exhaust", "cancel"} {
		t.Run("interrupted synchronous request "+scenario, func(t *testing.T) {
			account := botmodel.NewAccountModel().Find(ctx, map[string]any{"id": 18})
			botmodel.NewAccountModel().Update(ctx, map[string]any{"id": 18}, map[string]any{"concurrency": 1})
			defer botmodel.NewAccountModel().Update(ctx, map[string]any{"id": 18}, map[string]any{"concurrency": account.Concurrency})
			checkingRecovery.Store(true)
			defer checkingRecovery.Store(false)
			dropResponses.Store(1)
			if scenario == "exhaust" {
				dropResponses.Store(2)
			}
			defer dropResponses.Store(0)
			before := posts.Load()
			raw := request("interrupted-sync-" + scenario)
			raw.Billing.BusinessKey = raw.RequestID
			response := gateway.Request(ctx, raw)
			if response.Status != botprotocol.ResponseStatusFail || posts.Load() != before+1 {
				t.Fatal("first interrupted call was not preserved", response, posts.Load()-before)
			}
			original := readCheckpoint(t, raw.RequestID)
			if original.Attempt != 1 || !original.RetryableSubmission || original.Failure != "" || original.SubmissionResponse != nil {
				t.Fatalf("bad interrupted checkpoint: %+v", original)
			}
			_ = gateway.Request(ctx, raw)
			if posts.Load() != before+1 || readCheckpoint(t, raw.RequestID).Attempt != 1 {
				t.Fatal("request retried before the original timeout")
			}
			if scenario == "cancel" {
				if err := gateway.CancelSource(ctx, raw.RequestID); err != nil {
					t.Fatal(err)
				}
			}
			waitOriginalTimeout(t, original)
			if scenario != "cancel" {
				response = gateway.Request(ctx, raw)
				if posts.Load() != before+2 {
					t.Fatal("recovery did not submit exactly once", response, posts.Load()-before)
				}
				if scenario == "recover" {
					recovered := readCheckpoint(t, raw.RequestID)
					if response.Status != botprotocol.ResponseStatusSuccess || recovered.Attempt != 2 || recovered.SubmissionToken == original.SubmissionToken || recovered.BillingKey != original.BillingKey || !recovered.StartedAt.Equal(original.StartedAt) || !recovered.Deadline.Equal(original.Deadline) || recovered.Persisted["text"] != "done" {
						t.Fatalf("recovery lost task identity or original billing key: %+v %+v", response, recovered)
					}
					stale := bottask.WithExecutionAttempt(ctx, raw.RequestID, original.SubmissionToken)
					store := bottask.DatabaseStore{}
					if _, err := store.Save(stale, bottask.ExecutionChange{Checkpoint: *recovered, FactsOnly: true}); err == nil {
						t.Fatal("an old execution could attach facts to the new attempt")
					}
					var charges int
					if _, err := store.CommitResult(stale, bottask.ExecutionChange{Checkpoint: *recovered}, func(context.Context) error { charges++; return nil }); err == nil || charges != 0 {
						t.Fatal("old attempt could settle the new result", err, charges)
					}
					if _, err := store.CommitResult(ctx, bottask.ExecutionChange{Checkpoint: *recovered}, func(context.Context) error { charges++; return nil }); err != nil || charges != 0 {
						t.Fatal("already committed result could settle again", err, charges)
					}
					response = gateway.Request(ctx, raw)
					if response.Status != botprotocol.ResponseStatusSuccess || posts.Load() != before+2 || len(botmodel.NewLogModel().Select(ctx, map[string]any{"request_id": raw.RequestID, "status": StatusSuccess})) != 1 {
						t.Fatal("completed recovery generated or recorded success twice")
					}
				} else {
					second := readCheckpoint(t, raw.RequestID)
					if second.Attempt != 2 || second.Failure != "" {
						t.Fatalf("second interruption was not preserved: %+v", second)
					}
					_ = gateway.Request(ctx, raw)
					if posts.Load() != before+2 {
						t.Fatal("retry budget was exceeded before timeout")
					}
					waitOriginalTimeout(t, second)
				}
			}
			deadline := time.Now().Add(4 * time.Second)
			for {
				if err := gateway.recoverSources(ctx); err != nil {
					t.Fatal(err)
				}
				cp := readCheckpoint(t, raw.RequestID)
				stats, err := runtimefixture.AccountUsage(ctx, broker, 18)
				row := botmodel.NewExecutionModel().Find(ctx, map[string]any{"request_id": raw.RequestID})
				finished := cp.Persisted != nil
				if scenario == "exhaust" {
					finished = strings.Contains(cp.Failure, "一次恢复重试") && cp.Attempt == 2
				} else if scenario == "cancel" {
					finished = cp.Failure != "" && cp.Attempt == 1 && row.Phase == "canceled"
				}
				if err == nil && finished && !row.TaskOutstanding && stats["active_tasks"] == 0 {
					break
				}
				if time.Now().After(deadline) {
					t.Fatalf("recovered task did not terminate or release admission: %+v %+v %+v %v", cp, row, stats, err)
				}
				time.Sleep(30 * time.Millisecond)
			}
			want := before + 2
			if scenario == "cancel" {
				want = before + 1
			}
			_ = gateway.Request(ctx, raw)
			if posts.Load() != want {
				t.Fatal("terminal interrupted task was submitted again")
			}
		})
	}
	t.Run("partial stream is not regenerated or concatenated with another attempt", func(t *testing.T) {
		partialResponse.Store(true)
		defer partialResponse.Store(false)
		before := posts.Load()
		raw := request("interrupted-partial-stream")
		raw.Body["options"] = map[string]any{"stream": true}
		response := gateway.Request(ctx, raw)
		if response.Status != botprotocol.ResponseStatusSuccess {
			t.Fatal(response)
		}
		deadline := time.Now().Add(3 * time.Second)
		var cp *bottask.ExecutionCheckpoint
		for {
			cp = readCheckpoint(t, raw.RequestID)
			if cp.ResponseStarted && cp.LastError != "" {
				break
			}
			if time.Now().After(deadline) {
				t.Fatalf("partial response was not recorded: %+v", cp)
			}
			time.Sleep(10 * time.Millisecond)
		}
		if cp.SubmissionResponse != nil || cp.Persisted != nil || posts.Load() != before+1 {
			t.Fatalf("partial stream became a complete response: %+v", cp)
		}
		waitOriginalTimeout(t, cp)
		deadline = time.Now().Add(3 * time.Second)
		for {
			if err := gateway.recoverSources(ctx); err != nil {
				t.Fatal(err)
			}
			cp = readCheckpoint(t, raw.RequestID)
			row := botmodel.NewExecutionModel().Find(ctx, map[string]any{"request_id": raw.RequestID})
			if cp.Failure != "" && !row.TaskOutstanding {
				break
			}
			if time.Now().After(deadline) {
				t.Fatalf("partial stream did not end explicitly: %+v", cp)
			}
			time.Sleep(20 * time.Millisecond)
		}
		if cp.Attempt != 1 || posts.Load() != before+1 || !strings.Contains(cp.Failure, "流式输出已中断") {
			t.Fatalf("partial output caused duplicate generation: %+v", cp)
		}
	})
	for _, started := range []bool{false, true} {
		t.Run(fmt.Sprintf("expired task terminates without submission started=%t", started), func(t *testing.T) {
			id := fmt.Sprintf("expired-recovery-%t", started)
			state := bottask.WithDefaultStore(ctx)
			store := bottask.Store(state)
			cp, err := store.Save(state, bottask.ExecutionChange{Checkpoint: bottask.ExecutionCheckpoint{Version: 1, RequestID: id, Attempt: 1, SubmissionToken: id, Stage: bottask.ExecutionPrepared, StartedAt: time.Now().Add(-2 * time.Hour), Deadline: time.Now().Add(-time.Hour)}})
			if err != nil {
				t.Fatal(err)
			}
			if err := saveSourceRequest(state, request(id)); err != nil {
				t.Fatal(err)
			}
			if started {
				cp.Stage = bottask.ExecutionSubmitting
				cp.Protocol, cp.ProviderID, cp.AccountID, cp.ServiceID = "openai", 7, 18, 39
				cp.RetryableSubmission, cp.SubmissionDeadline = true, time.Now().Add(-time.Hour)
				if _, err := store.Save(state, bottask.ExecutionChange{Checkpoint: *cp}); err != nil {
					t.Fatal(err)
				}
				if _, err := broker.Adopt(ctx, id, "expired-owner", 18); err != nil {
					t.Fatal(err)
				}
			}
			botmodel.NewExecutionModel().Update(ctx, map[string]any{"request_id": id}, map[string]any{"phase": "queued", "created_at": time.Now().Add(-2 * time.Hour), "task_outstanding": started})
			before := posts.Load()
			deadline := time.Now().Add(3 * time.Second)
			for {
				if err := gateway.recoverSources(ctx); err != nil {
					t.Fatal(err)
				}
				current := readCheckpoint(t, id)
				row := botmodel.NewExecutionModel().Find(ctx, map[string]any{"request_id": id})
				stats, err := runtimefixture.AccountUsage(ctx, broker, 18)
				if err == nil && strings.Contains(current.Failure, "恢复期限") && !row.TaskOutstanding && stats["active_tasks"] == 0 {
					break
				}
				if time.Now().After(deadline) {
					t.Fatalf("expired task did not terminate: %+v %+v %+v %v", current, row, stats, err)
				}
				time.Sleep(30 * time.Millisecond)
			}
			if posts.Load() != before || readCheckpoint(t, id).Attempt != 1 {
				t.Fatal("expired task was submitted or retried")
			}
		})
	}
	t.Run("multi account service uses dedicated credentials and restores original video account", func(t *testing.T) {
		var calls [2]atomic.Int32
		var polls [2]atomic.Int32
		makeServer := func(index int) *httptest.Server {
			return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
				if r.Header.Get("Authorization") != fmt.Sprintf("Bearer pool-key-%d", index) {
					t.Error("wrong account credential on selected host")
					w.WriteHeader(401)
					return
				}
				w.Header().Set("Content-Type", "application/json")
				if r.Method == http.MethodGet {
					polls[index].Add(1)
					fmt.Fprint(w, "{\"status\":\"done\",\"video\":{\"url\":\"https://media.example.test/pool.mp4\"}}")
					return
				}
				calls[index].Add(1)
				fmt.Fprint(w, "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"pooled\"},\"finish_reason\":\"stop\"}]}")
			}))
		}
		firstServer, secondServer := makeServer(0), makeServer(1)
		defer firstServer.Close()
		defer secondServer.Close()
		botmodel.NewProviderModel().Insert(ctx, map[string]any{"id": 90, "name": "pool-source", "protocol": "openai", "host": secondServer.URL + "/v1", "status": 1})
		for i, host := range []string{firstServer.URL + "/v1", ""} {
			botmodel.NewAccountModel().Insert(ctx, map[string]any{"id": 120 + i, "provider_id": 90, "name": fmt.Sprint(i), "host": host, "key": fmt.Sprintf("pool-key-%d", i), "scope": 2, "concurrency": 1, "status": 1})
		}
		botmodel.NewAccountModel().Insert(ctx, map[string]any{"id": 122, "provider_id": 90, "name": "unbound", "key": "must-not-use", "scope": 2, "concurrency": 1, "status": 1})
		for i, kind := range []string{"text", "video"} {
			serviceID := uint64(150 + i)
			path := "chat/completions"
			if kind == "video" {
				path = "videos/generations"
			}
			botmodel.NewServiceModel().Insert(ctx, map[string]any{"id": serviceID, "provider_id": 90, "name": kind, "type": kind, "path": path, "status": 1})
			botmodel.NewServiceEndpointModel().Insert(ctx, map[string]any{"id": 160 + i, "service_id": serviceID, "api": "pool-model", "interface_type": "model", "status": 1})
			botmodel.NewPowerModel().Insert(ctx, map[string]any{"id": 110 + i, "key": "pool-" + kind, "name": kind, "kind": kind, "status": 1})
			botmodel.NewPowerTargetModel().Insert(ctx, map[string]any{"id": 110 + i, "power_id": 110 + i, "service_id": serviceID, "status": 1})
			for _, id := range []uint64{120, 121} {
				botmodel.NewServiceAccountModel().Insert(ctx, map[string]any{"service_id": serviceID, "account_id": id})
			}
		}
		for i := 0; i < 4; i++ {
			id := fmt.Sprintf("pooled-text-%d", i)
			_, err := gateway.Invoke(ctx, GatewayRequest{RequestID: id, Body: map[string]any{"power": "pool-text", "input": map[string]any{"prompt": "hello"}}}, InvokeOptions{})
			if err != nil {
				t.Fatal(err)
			}
			cp, err := (bottask.DatabaseStore{}).Load(ctx, id)
			if err != nil || cp.AccountID != 120+uint64(i%2) {
				t.Fatalf("actual account not persisted: %+v %v", cp, err)
			}
		}
		if calls[0].Load() != 2 || calls[1].Load() != 2 {
			t.Fatal("requests did not rotate between account hosts", calls[0].Load(), calls[1].Load())
		}
		held, err := broker.Acquire(ctx, "pool-held", "pool-held", "other-service", []botschedule.Account{{ID: 120, Limit: 1}}, nil, nil)
		if err != nil {
			t.Fatal(err)
		}
		defer held.Release(ctx)
		raw := GatewayRequest{RequestID: "pool-video-original", Body: map[string]any{"power": "pool-video", "input": map[string]any{"prompt": "a boat"}, "options": map[string]any{"poll_interval_ms": 1}}}
		original := bottask.WithDefaultStore(ctx)
		if _, err := prepareExecution(original, raw.RequestID); err != nil {
			t.Fatal(err)
		}
		req, err := gateway.normalizeGatewayRequest(raw, ModeNormalize)
		if err != nil {
			t.Fatal(err)
		}
		power, _ := gateway.repo.Power(ctx, 111)
		target, _ := gateway.repo.FindPowerTarget(ctx, 111)
		selected, err := gateway.selectTarget(ctx, power, target, "")
		if err != nil {
			t.Fatal(err)
		}
		prepared, _, err := gateway.prepareRemoteCall(original, req, selected)
		if err != nil {
			t.Fatal(err)
		}
		first, _, err := gateway.acquireRemoteResource(original, prepared)
		if err != nil {
			t.Fatal(err)
		}
		prepared, err = gateway.refreshRemoteCredential(first, prepared)
		if err != nil {
			t.Fatal(err)
		}
		cp, err := gateway.beginRemoteExecution(first, prepared)
		if err != nil {
			t.Fatal(err)
		}
		if cp.AccountID != 121 {
			t.Fatal("video did not use idle account", cp.AccountID)
		}
		cp.RemoteTaskID, cp.Stage = "pool-original", bottask.ExecutionSubmitted
		if _, err := bottask.Store(first).Save(first, bottask.ExecutionChange{Checkpoint: *cp}); err != nil {
			t.Fatal(err)
		}
		finishSourceCall(first)
		botmodel.NewServiceAccountModel().Delete(ctx, map[string]any{"service_id": 151})
		selected, err = gateway.selectTarget(original, power, target, raw.RequestID)
		if err != nil {
			t.Fatal(err)
		}
		resumed, _, err := gateway.prepareRemoteCall(original, req, selected)
		if err != nil {
			t.Fatal(err)
		}
		second, _, err := gateway.acquireRemoteResource(original, resumed)
		if err != nil {
			t.Fatal(err)
		}
		defer finishSourceCall(second)
		_, err = gateway.tasks.ObserveTerminal(second, bottask.StreamJob{Input: resumed.NativeInput, Adapter: resumed.Adapter, Client: gateway.client, Request: resumed.NativeRequest}, cp.RemoteTaskID)
		if err != nil {
			t.Fatal(err)
		}
		if polls[1].Load() != 1 || polls[0].Load() != 0 {
			t.Fatal("video query switched account", polls[0].Load(), polls[1].Load())
		}
	})

}
