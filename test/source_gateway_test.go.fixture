package energon

import (
	"context"
	"encoding/json"
	"fmt"
	"github.com/redis/go-redis/v9"
	deverserver "github.com/shemic/dever/server"
	"net/http"
	"net/http/httptest"
	"os"
	"strings"
	"sync"
	"sync/atomic"
	"testing"
	"time"

	botmodel "github.com/dever-package/bot/model/energon"
	botprocessor "github.com/dever-package/bot/service/energon/processor"
	botprotocol "github.com/dever-package/bot/service/energon/protocol"
	botprovider "github.com/dever-package/bot/service/energon/provider"
	botruntimeconfig "github.com/dever-package/bot/service/energon/runtimeconfig"
	botschedule "github.com/dever-package/bot/service/energon/schedule"
	botstream "github.com/dever-package/bot/service/energon/stream"
	bottask "github.com/dever-package/bot/service/energon/task"
	"github.com/dever-package/bot/test/runtimefixture"
)

type afterSourceResponseClient struct {
	botprovider.Client
	after func() error
}

type localCheckpointProcessor struct {
	calls atomic.Int32
}

func (*localCheckpointProcessor) Manifest() botprocessor.Manifest {
	return botprocessor.Manifest{Key: "checkpoint-test"}
}

func (p *localCheckpointProcessor) Execute(ctx context.Context, req botprocessor.ExecuteRequest) (any, error) {
	cp, err := bottask.Store(ctx).Load(ctx, req.RequestID)
	if err != nil {
		return nil, err
	}
	if cp.Stage != bottask.ExecutionSubmitting || cp.Protocol != botprocessor.ProtocolLocal || cp.ExecutionDeadline.IsZero() {
		return nil, fmt.Errorf("local processor did not own its submission checkpoint")
	}
	p.calls.Add(1)
	return botprotocol.Output{
		"videos":      []string{"https://example.invalid/composed.mp4"},
		"media_files": []map[string]any{{"file_id": 42, "kind": "video", "url": "https://example.invalid/composed.mp4", "download": "/front/api/upload/open?id=42"}},
		"meta":        map[string]any{"stored": true},
	}, nil
}

func (c afterSourceResponseClient) Do(ctx context.Context, req botprovider.Request) (*botprovider.Response, error) {
	response, err := c.Client.Do(ctx, req)
	if err == nil {
		err = c.after()
	}
	return response, err
}

func TestSourceGatewayLifecycle(t *testing.T) {
	broker := runtimefixture.Redis(t)
	db := runtimefixture.New(t)
	db.SetMaxOpenConns(1)
	for _, table := range []struct {
		name  string
		model any
	}{
		{"bot_energon_provider", botmodel.Provider{}}, {"bot_energon_account", botmodel.Account{}},
		{"bot_energon_service", botmodel.Service{}}, {"bot_energon_service_account", botmodel.ServiceAccount{}}, {"bot_energon_service_endpoint", botmodel.ServiceEndpoint{}},
		{"bot_energon_power", botmodel.Power{}}, {"bot_energon_power_target", botmodel.PowerTarget{}},
		{"bot_energon_param", botmodel.Param{}}, {"bot_energon_power_param", botmodel.PowerParam{}},
		{"bot_energon_service_param", botmodel.ServiceParam{}}, {"bot_energon_param_option", botmodel.ParamOption{}},
		{"bot_energon_param_group_member", botmodel.ParamGroupMember{}}, {"bot_energon_log", botmodel.Log{}}, {"bot_energon_service_price", botmodel.ServicePrice{}}, {"bot_energon_cost_record", botmodel.CostRecord{}},
	} {
		runtimefixture.CreateTable(t, db, table.name, table.model)
	}
	ctx := botschedule.WithBroker(context.Background(), broker)
	var active, maximum, posts, videoPosts, videoPolls, downloads atomic.Int32
	var busyMode atomic.Bool
	var busyCalls atomic.Int32
	var rejectionMode atomic.Int32
	var dropResponses atomic.Int32
	var partialResponse atomic.Bool
	var checkingRecovery atomic.Bool
	firstBusy := make(chan struct{}, 1)
	firstConcurrentPair := make(chan struct{})
	var firstConcurrent sync.Once
	var expectedKey atomic.Value
	expectedKey.Store("test-key")
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		switch r.URL.Path {
		case "/v1/videos/generations":
			videoPosts.Add(1)
			w.Header().Set("Content-Type", "application/json")
			fmt.Fprint(w, `{"request_id":"remote-one"}`)
			return
		case "/v1/videos/remote-one", "/v1/videos/expired-job":
			videoPolls.Add(1)
			w.Header().Set("Content-Type", "application/json")
			fmt.Fprint(w, `{"status":"done","video":{"url":"/v1/videos/remote-one/content","duration":1}}`)
			return
		case "/v1/videos/remote-one/content":
			if r.Header.Get("Authorization") != "Bearer test-key" {
				t.Error("download lost original account")
			}
			stats, err := runtimefixture.AccountUsage(ctx, broker, 18)
			if err != nil || stats["active_tasks"] != 0 {
				t.Error("terminal task slot must be free during download", stats, err)
			}
			if downloads.Add(1) == 1 {
				w.WriteHeader(500)
				return
			}
			w.Header().Set("Content-Type", "video/mp4")
			fmt.Fprint(w, "opaque provider video bytes")
			return
		}
		if r.URL.Path != "/v1/chat/completions" && r.URL.Path != "/v1/images/generations" {
			t.Errorf("unexpected path %s", r.URL.Path)
			http.NotFound(w, r)
			return
		}
		if r.Header.Get("Authorization") != "Bearer "+expectedKey.Load().(string) {
			t.Error("submission used stale account credential")
		}
		posts.Add(1)
		if checkingRecovery.Load() {
			stats, err := runtimefixture.AccountUsage(ctx, broker, 18)
			if err != nil || stats["active_tasks"] != 1 {
				t.Error("recovery bypassed account admission", stats, err)
			}
		}
		if dropResponses.Load() > 0 && dropResponses.Add(-1) >= 0 {
			connection, _, err := w.(http.Hijacker).Hijack()
			if err != nil {
				t.Error(err)
				return
			}
			_ = connection.Close()
			return
		}
		if partialResponse.Load() {
			w.Header().Set("Content-Type", "text/event-stream")
			fmt.Fprint(w, "data: {\"choices\":[{\"delta\":{\"content\":\"partial\"}}]}\n\n")
			w.(http.Flusher).Flush()
			connection, _, err := w.(http.Hijacker).Hijack()
			if err != nil {
				t.Error(err)
				return
			}
			_ = connection.Close()
			return
		}
		if mode := rejectionMode.Load(); mode != 0 {
			w.Header().Set("Content-Type", "application/json")
			w.WriteHeader(503)
			if mode == 1 {
				fmt.Fprint(w, `{"error":{"message":"No eligible Grok media accounts","type":"grok_media_no_eligible_account"}}`)
			} else {
				fmt.Fprint(w, `{"error":{"message":"upstream unavailable","type":"server_error"}}`)
			}
			return
		}
		if busyMode.Load() {
			busyCalls.Add(1)
			w.Header().Set("Content-Type", "application/json")
			w.WriteHeader(429)
			fmt.Fprint(w, `{"error":{"code":"gateway_concurrency_limit"}}`)
			select {
			case firstBusy <- struct{}{}:
			default:
			}
			return
		}
		n := active.Add(1)
		defer active.Add(-1)
		for {
			old := maximum.Load()
			if n <= old || maximum.CompareAndSwap(old, n) {
				break
			}
		}
		if posts.Load() <= 2 {
			if n == 2 {
				firstConcurrent.Do(func() { close(firstConcurrentPair) })
			}
			select {
			case <-firstConcurrentPair:
			case <-r.Context().Done():
				t.Error("two admitted requests did not execute concurrently")
				return
			}
		}
		time.Sleep(20 * time.Millisecond)
		w.Header().Set("Content-Type", "application/json")
		fmt.Fprint(w, `{"choices":[{"message":{"role":"assistant","content":"done"},"finish_reason":"stop"}],"usage":{"prompt_tokens":1,"completion_tokens":1}}`)
	}))
	defer server.Close()
	botmodel.NewProviderModel().Insert(ctx, map[string]any{"id": 7, "name": "test-source", "protocol": "openai", "host": server.URL + "/v1", "status": 1})
	botmodel.NewAccountModel().Insert(ctx, map[string]any{"id": 18, "provider_id": 7, "name": "key-a", "concurrency": 2, "key": "test-key", "scope": 1, "status": 1, "sort": 100})
	botmodel.NewServiceModel().Insert(ctx, map[string]any{"id": 39, "provider_id": 7, "name": "chat", "type": "text", "path": "chat/completions", "status": 1})
	botmodel.NewServiceEndpointModel().Insert(ctx, map[string]any{"id": 46, "service_id": 39, "api": "test-model", "interface_type": "model", "status": 1, "sort": 100})
	botmodel.NewPowerModel().Insert(ctx, map[string]any{"id": 1, "key": "text", "name": "Text", "kind": "text", "status": 1})
	botmodel.NewPowerTargetModel().Insert(ctx, map[string]any{"id": 1, "power_id": 1, "service_id": 39, "status": 1, "sort": 100})
	options := broker.Client.(*redis.Client).Options()
	testConfig, err := json.Marshal(map[string]any{"database": map[string]any{"default": "default", "persist": false, "create": false}, "redis": map[string]any{"enable": true, "addr": options.Addr, "username": options.Username, "password": options.Password, "db": options.DB, "prefix": broker.Prefix}})
	if err != nil {
		t.Fatal(err)
	}
	if err := os.WriteFile("config/setting.json", testConfig, 0600); err != nil {
		t.Fatal(err)
	}
	gateway := newGatewayService(botprovider.NewHTTPClient(time.Second))
	t.Cleanup(func() {
		shutdown, cancel := context.WithTimeout(context.Background(), time.Second)
		defer cancel()
		if err := deverserver.RunShutdownHooks(shutdown); err != nil {
			t.Error(err)
		}
	})

	confirmRemoteEnded := func(id string) {
		store := bottask.DatabaseStore{}
		cp, err := store.Load(ctx, id)
		if err != nil {
			t.Fatal(err)
		}
		cp.RemoteResponse = &botprovider.Response{StatusCode: 200, Body: map[string]any{"status": "failed"}}
		cp.RemoteFailure = "provider confirmed terminal"
		if cp.Failure == "" {
			cp.Failure = cp.RemoteFailure
		}
		if _, err := store.Save(ctx, bottask.ExecutionChange{Checkpoint: *cp, FactsOnly: false}); err != nil {
			t.Fatal(err)
		}
		if err := broker.Client.Del(ctx, broker.Prefix+":reconcile-tick").Err(); err != nil {
			t.Fatal(err)
		}
		if err := restoreSourceOccupancy(ctx, broker); err != nil {
			t.Fatal(err)
		}
	}
	request := func(id string) GatewayRequest {
		return GatewayRequest{RequestID: id, Body: map[string]any{"power": "text", "input": map[string]any{"prompt": "hello"}}}
	}
	t.Run("local leaf owns submission and saved results prevent replay", func(t *testing.T) {
		botmodel.NewProviderModel().Insert(ctx, map[string]any{"id": 80, "name": "local", "protocol": "local", "protocol_option": "checkpoint-test", "status": 1})
		botmodel.NewServiceModel().Insert(ctx, map[string]any{"id": 140, "provider_id": 80, "name": "local", "type": "video", "path": "local://checkpoint-test/run", "status": 1})
		botmodel.NewServiceEndpointModel().Insert(ctx, map[string]any{"id": 147, "service_id": 140, "api": "run", "interface_type": "model", "status": 1, "sort": 100})
		botmodel.NewPowerModel().Insert(ctx, map[string]any{"id": 102, "key": "local-test", "name": "Local", "kind": "video", "status": 1})
		botmodel.NewPowerTargetModel().Insert(ctx, map[string]any{"id": 102, "power_id": 102, "service_id": 140, "status": 1, "sort": 100})
		processor := &localCheckpointProcessor{}
		gateway.processors.Register(processor)
		for _, streaming := range []bool{false, true} {
			raw := GatewayRequest{RequestID: fmt.Sprintf("local-first-%t", streaming), Body: map[string]any{"power": "local-test", "options": map[string]any{"stream": streaming}}}
			before := processor.calls.Load()
			response := gateway.Request(ctx, raw)
			if response.Status != botprotocol.ResponseStatusSuccess {
				t.Fatal(response)
			}
			deadline := time.Now().Add(3 * time.Second)
			for {
				cp, err := (bottask.DatabaseStore{}).Load(ctx, raw.RequestID)
				if err != nil {
					t.Fatal(err)
				}
				if cp.Persisted != nil {
					media := botprotocol.ExtractPrimaryMediaURLs(cp.Persisted, botprotocol.MediaTypeVideo)
					if len(media) != 1 || media[0] != "https://example.invalid/composed.mp4" {
						t.Fatal("local result lost", cp.Persisted)
					}
					break
				}
				if time.Now().After(deadline) {
					t.Fatal("local result was not persisted", cp.LastError)
				}
				time.Sleep(10 * time.Millisecond)
			}
			raw.Body["options"] = map[string]any{"stream": false}
			response = gateway.Request(ctx, raw)
			if response.Status != botprotocol.ResponseStatusSuccess || processor.calls.Load() != before+1 {
				t.Fatal("local task replayed or result unavailable", response, processor.calls.Load())
			}
		}
	})
	t.Run("sync and proxy share account concurrency and durable receipts", func(t *testing.T) {
		var wg sync.WaitGroup
		failures := make(chan string, 8)
		for i := 0; i < 6; i++ {
			wg.Add(1)
			go func(i int) {
				defer wg.Done()
				raw := request(fmt.Sprintf("request-%d", i))
				if i%2 == 1 {
					raw.Body["mode"] = "proxy"
					raw.Body["model"] = "test-model"
				}
				response := gateway.Request(ctx, raw)
				if response.Status != botprotocol.ResponseStatusSuccess {
					failures <- response.Msg
				}
			}(i)
		}
		wg.Wait()
		close(failures)
		for failure := range failures {
			t.Error(failure)
		}
		if maximum.Load() != 2 || posts.Load() != 6 {
			t.Fatal("account concurrency bypassed", maximum.Load(), posts.Load())
		}
		cp, err := (bottask.DatabaseStore{}).Load(ctx, "request-0")
		if err != nil || cp.Persisted == nil {
			t.Fatal(cp, err)
		}
		response := gateway.Request(ctx, request("request-0"))
		if response.Status != 1 || posts.Load() != 6 {
			t.Fatal("persisted request replayed", response, posts.Load())
		}
		stats, err := runtimefixture.AccountUsage(ctx, broker, 18)
		if err != nil || stats["active_tasks"] != 0 {
			t.Fatal(stats, err)
		}
	})
	t.Run("receipt identity rejects another user or admin", func(t *testing.T) {
		for _, raw := range []GatewayRequest{{RequestID: "request-0", Billing: botprotocol.BillingContext{UserID: 999}, Body: map[string]any{"power": "text", "input": map[string]any{"prompt": "wrong owner"}}}, {RequestID: "request-0", AdminID: 999, Body: map[string]any{"power": "text", "input": map[string]any{"prompt": "wrong owner"}}}} {
			response := gateway.Request(ctx, raw)
			if response.Status != 2 || posts.Load() != 6 {
				t.Fatal("receipt crossed owner boundary", response, posts.Load())
			}
		}
	})
	t.Run("queued cancellation never submits", func(t *testing.T) {
		callCtx := bottask.WithDefaultStore(ctx)
		if _, err := prepareExecution(callCtx, "cancel-before-post"); err != nil {
			t.Fatal(err)
		}
		if err := saveSourceRequest(callCtx, request("cancel-before-post")); err != nil {
			t.Fatal(err)
		}
		if err := gateway.CancelSource(ctx, "cancel-before-post"); err != nil {
			t.Fatal(err)
		}
		response := gateway.Request(ctx, request("cancel-before-post"))
		if response.Status != botprotocol.ResponseStatusFail || posts.Load() != 6 {
			t.Fatal(response, posts.Load())
		}
	})
	t.Run("unknown submission retains account slot until its original timeout", func(t *testing.T) {
		callCtx := bottask.WithDefaultStore(ctx)
		req := request("unknown-post")
		if _, err := prepareExecution(callCtx, req.RequestID); err != nil {
			t.Fatal(err)
		}
		if err := saveSourceRequest(callCtx, req); err != nil {
			t.Fatal(err)
		}
		normalized, err := gateway.normalizeGatewayRequest(req, ModeNormalize)
		if err != nil {
			t.Fatal(err)
		}
		power, _ := gateway.repo.Power(ctx, 1)
		target, _ := gateway.repo.FindPowerTarget(ctx, 1)
		selected, err := gateway.selectTarget(ctx, power, target, "")
		if err != nil {
			t.Fatal(err)
		}
		prepared, _, err := gateway.prepareRemoteCall(callCtx, normalized, selected)
		if err != nil {
			t.Fatal(err)
		}
		admitted, _, err := gateway.acquireRemoteResource(callCtx, prepared)
		if err != nil {
			t.Fatal(err)
		}
		cp, err := gateway.beginRemoteExecution(admitted, prepared)
		if err != nil {
			t.Fatal(err)
		}
		cp.SubmissionDeadline = time.Now().Add(time.Minute)
		if _, err := bottask.Store(admitted).Save(admitted, bottask.ExecutionChange{Checkpoint: *cp}); err != nil {
			t.Fatal(err)
		}
		finishSourceCall(admitted) // Simulate process loss after starting a POST but before its receipt.
		stats, err := runtimefixture.AccountUsage(ctx, broker, 18)
		if err != nil || stats["active_tasks"] != 1 {
			t.Fatal(stats, err)
		}
		response := gateway.Request(ctx, req)
		if response.Status != 2 || posts.Load() != 6 {
			t.Fatal("ambiguous POST repeated", response, posts.Load())
		}
		// Simulate Redis losing only this test namespace's admission index.
		if err := broker.Client.Del(ctx, broker.Prefix+":ready", broker.Prefix+":active:18", broker.Prefix+":lease:"+req.RequestID).Err(); err != nil {
			t.Fatal(err)
		}
		if err := restoreSourceOccupancy(ctx, broker); err != nil {
			t.Fatal(err)
		}
		stats, err = runtimefixture.AccountUsage(ctx, broker, 18)
		if err != nil || stats["active_tasks"] != 1 {
			t.Fatal("SQL did not restore unfinished occupancy", stats, err)
		}
		confirmRemoteEnded(req.RequestID)
		stats, err = runtimefixture.AccountUsage(ctx, broker, 18)
		if err != nil || stats["active_tasks"] != 0 {
			t.Fatal(stats, err)
		}

	})
	t.Run("canceled composite child releases its expired slot without a request snapshot", func(t *testing.T) {
		callCtx := bottask.WithExecutionStore(ctx, bottask.DatabaseStore{RunID: 101, NodeRunID: 202})
		bottask.BindRootRequest(callCtx, "composite-parent")
		raw := request("canceled-composite-child")
		if _, err := prepareExecution(callCtx, raw.RequestID); err != nil {
			t.Fatal(err)
		}
		req, err := gateway.normalizeGatewayRequest(raw, ModeNormalize)
		if err != nil {
			t.Fatal(err)
		}
		power, _ := gateway.repo.Power(ctx, 1)
		target, _ := gateway.repo.FindPowerTarget(ctx, 1)
		selected, err := gateway.selectTarget(ctx, power, target, "")
		if err != nil {
			t.Fatal(err)
		}
		prepared, _, err := gateway.prepareRemoteCall(callCtx, req, selected)
		if err != nil {
			t.Fatal(err)
		}
		admitted, _, err := gateway.acquireRemoteResource(callCtx, prepared)
		if err != nil {
			t.Fatal(err)
		}
		cp, err := gateway.beginRemoteExecution(admitted, prepared)
		if err != nil {
			t.Fatal(err)
		}
		cp.SubmissionDeadline = time.Now().Add(-time.Second)
		if _, err := bottask.Store(admitted).Save(admitted, bottask.ExecutionChange{Checkpoint: *cp}); err != nil {
			t.Fatal(err)
		}
		finishSourceCall(admitted)
		before := posts.Load()
		if err := gateway.CancelSource(ctx, raw.RequestID); err != nil {
			t.Fatal(err)
		}
		if err := gateway.recoverSources(ctx); err != nil {
			t.Fatal(err)
		}
		row := botmodel.NewExecutionModel().Find(ctx, map[string]any{"request_id": raw.RequestID})
		if row.Request != "{}" || row.Phase != "canceled" || row.TaskOutstanding || posts.Load() != before {
			t.Fatalf("canceled child retained its slot or submitted again: phase=%s outstanding=%v posts=%d", row.Phase, row.TaskOutstanding, posts.Load()-before)
		}
		if err := broker.Client.Del(ctx, broker.Prefix+":reconcile-tick").Err(); err != nil {
			t.Fatal(err)
		}
		if err := restoreSourceOccupancy(ctx, broker); err != nil {
			t.Fatal(err)
		}
		stats, err := runtimefixture.AccountUsage(ctx, broker, 18)
		if err != nil || stats["active_tasks"] != 0 {
			t.Fatal("canceled child still blocks the account queue", stats, err)
		}
	})
	t.Run("stream survives HTTP return and shares the same account slot", func(t *testing.T) {
		requestCtx, cancel := context.WithCancel(ctx)
		raw := request("streamed")
		raw.Body["options"] = map[string]any{"stream": true}
		response := gateway.Request(requestCtx, raw)
		cancel() // The original HTTP handler has returned its stream identity.
		if response.Status != 1 || response.Type != botprotocol.ResponseTypeStream {
			t.Fatal(response)
		}
		collection := gateway.CollectStream(ctx, botstream.CollectOptions{RequestID: raw.RequestID, Block: time.Second, IdleTimeout: 5 * time.Second})
		if collection.Err != nil || botstream.FrameStatus(collection.Frame) != 1 {
			t.Fatal(collection.Err, collection.Frame)
		}
		if posts.Load() != 7 {
			t.Fatal(posts.Load())
		}
	})
	t.Run("terminal receipt frees account slot before download and resumes without POST or poll", func(t *testing.T) {
		botmodel.NewAccountModel().Update(ctx, map[string]any{"id": 18}, map[string]any{"concurrency": 1})
		defer botmodel.NewAccountModel().Update(ctx, map[string]any{"id": 18}, map[string]any{"concurrency": 2})
		botmodel.NewServiceModel().Insert(ctx, map[string]any{"id": 40, "provider_id": 7, "name": "video", "type": "video", "path": "videos/generations", "status": 1})
		botmodel.NewServiceEndpointModel().Insert(ctx, map[string]any{"id": 47, "service_id": 40, "api": "grok-imagine-video-1.5", "interface_type": "model", "status": 1, "sort": 100})
		botmodel.NewPowerModel().Insert(ctx, map[string]any{"id": 2, "key": "video", "name": "Video", "kind": "video", "status": 1})
		botmodel.NewPowerTargetModel().Insert(ctx, map[string]any{"id": 2, "power_id": 2, "service_id": 40, "status": 1, "sort": 100})
		raw := GatewayRequest{RequestID: "video-download", Body: map[string]any{"power": "video", "input": map[string]any{"prompt": "a boat"}, "options": map[string]any{"poll_interval_ms": 1}}}
		t.Cleanup(func() { botmodel.NewExecutionModel().Delete(ctx, map[string]any{"request_id": raw.RequestID}) })
		original := bottask.WithDefaultStore(ctx)
		if _, err := prepareExecution(original, raw.RequestID); err != nil {
			t.Fatal(err)
		}
		if err := saveSourceRequest(original, raw); err != nil {
			t.Fatal(err)
		}
		req, err := gateway.normalizeGatewayRequest(raw, ModeNormalize)
		if err != nil {
			t.Fatal(err)
		}
		power, _ := gateway.repo.Power(ctx, 2)
		target, _ := gateway.repo.FindPowerTarget(ctx, 2)
		selected, err := gateway.selectTarget(ctx, power, target, "")
		if err != nil {
			t.Fatal(err)
		}
		prepared, _, err := gateway.prepareRemoteCall(original, req, selected)
		if err != nil {
			t.Fatal(err)
		}
		first, _, err := gateway.acquireRemoteResource(original, prepared)
		if err != nil {
			t.Fatal(err)
		}
		if _, err := gateway.beginRemoteExecution(first, prepared); err != nil {
			t.Fatal(err)
		}
		job := bottask.StreamJob{Input: prepared.NativeInput, Adapter: prepared.Adapter, Client: gateway.client, Request: prepared.NativeRequest}
		_, err = gateway.tasks.ResolveStream(first, job)
		if err == nil {
			t.Fatal("download failure was hidden")
		}
		finishSourceCall(first)
		cp, err := bottask.Store(original).Load(ctx, raw.RequestID)
		if err != nil || cp.RemoteResponse == nil || cp.RemoteTaskID != "remote-one" {
			t.Fatal(cp, err)
		}
		second, _, err := gateway.acquireRemoteResource(original, prepared)
		if err != nil {
			t.Fatal(err)
		}
		defer finishSourceCall(second)
		if _, err := gateway.beginRemoteExecution(second, prepared); err != nil {
			t.Fatal(err)
		}
		result, err := gateway.tasks.ResumePolling(second, job, cp.RemoteTaskID)
		if err != nil {
			t.Fatal(err)
		}
		if _, ok := botprovider.AsBinaryPayload(result.Data); !ok {
			t.Fatal("original protected result not restored")
		}
		if videoPosts.Load() != 1 || videoPolls.Load() != 1 || downloads.Load() != 2 {
			t.Fatal("accepted work repeated", videoPosts.Load(), videoPolls.Load(), downloads.Load())
		}
	})

	t.Run("cancel root also cancels composite child calls", func(t *testing.T) {
		group := bottask.WithDefaultStore(ctx)
		for _, id := range []string{"composite-root", "composite-child-a", "composite-child-b"} {
			if _, err := prepareExecution(group, id); err != nil {
				t.Fatal(err)
			}
		}
		if err := gateway.CancelSource(ctx, "composite-root"); err != nil {
			t.Fatal(err)
		}
		for _, id := range []string{"composite-child-a", "composite-child-b"} {
			row := botmodel.NewExecutionModel().Find(ctx, map[string]any{"request_id": id})
			if row.RootRequestID != "composite-root" || !row.CancelRequested || row.Phase != "canceled" {
				t.Fatal(row)
			}
		}
	})
	t.Run("expired business deadline still observes upstream terminal without generation or download", func(t *testing.T) {
		original := bottask.WithDefaultStore(ctx)
		raw := GatewayRequest{RequestID: "expired-observer", Body: map[string]any{"power": "video", "input": map[string]any{"prompt": "an already submitted job"}, "options": map[string]any{"poll_interval_ms": 1}}}
		cp, err := prepareExecution(original, raw.RequestID)
		if err != nil {
			t.Fatal(err)
		}
		if err := saveSourceRequest(original, raw); err != nil {
			t.Fatal(err)
		}
		req, err := gateway.normalizeGatewayRequest(raw, ModeNormalize)
		if err != nil {
			t.Fatal(err)
		}
		power, _ := gateway.repo.Power(ctx, 2)
		target, _ := gateway.repo.FindPowerTarget(ctx, 2)
		selected, err := gateway.selectTarget(ctx, power, target, "")
		if err != nil {
			t.Fatal(err)
		}
		prepared, _, err := gateway.prepareRemoteCall(original, req, selected)
		if err != nil {
			t.Fatal(err)
		}
		cp.PowerID = 2
		cp.TargetID = 2
		cp.ProviderID = 7
		cp.AccountID = 18
		cp.ServiceID = 40
		cp.EndpointID = 47
		cp.ServiceAPI = prepared.Selected.ServiceAPI
		cp.Protocol = "openai"
		cp.Mapped = prepared.NativeInput.Mapped
		cp.RemoteTaskID = "expired-job"
		cp.ExecutionDeadline = time.Now().Add(-time.Minute)
		cp.Stage = bottask.ExecutionSubmitted
		if _, err = bottask.Store(original).Save(ctx, bottask.ExecutionChange{Checkpoint: *cp}); err != nil {
			t.Fatal(err)
		}
		botmodel.NewExecutionModel().Update(ctx, map[string]any{"request_id": raw.RequestID}, map[string]any{"run_id": 999, "task_outstanding": true})
		row := botmodel.NewExecutionModel().Find(ctx, map[string]any{"request_id": raw.RequestID})
		if err := gateway.observeSource(ctx, *row, *cp); err != nil {
			t.Fatal(err)
		}
		after, err := (bottask.DatabaseStore{RunID: 999}).Load(ctx, raw.RequestID)
		if err != nil || after.RemoteResponse == nil {
			t.Fatal(after, err)
		}
		if videoPosts.Load() != 1 || downloads.Load() != 2 {
			t.Fatal("observation repeated paid work or downloaded expired result", videoPosts.Load(), downloads.Load())
		}
		stats, err := runtimefixture.AccountUsage(ctx, broker, 18)
		if err != nil || stats["active_tasks"] != 0 {
			t.Fatal(stats, err)
		}
