package energon

import (
	"context"
	"encoding/json"
	"fmt"
	"io"
	"net/http"
	"net/http/httptest"
	"reflect"
	"strings"
	"testing"
	"time"
	"unicode/utf8"

	botmodel "github.com/dever-package/bot/model/energon"
	botprotocol "github.com/dever-package/bot/service/energon/protocol"
	"github.com/dever-package/bot/service/energon/protocol/adapters"
	botprovider "github.com/dever-package/bot/service/energon/provider"
)

func TestWritingReliabilityNativeStrictRequest(t *testing.T) {
	for _, path := range []string{"", "/chat/completions"} {
		for _, action := range []string{"generate_inspirations", "planning_preferences", "planning_direction", "section_entities", "planning_background", "generate_chapters", "outline_section", "chapter_plan", "append", "propose_edit", "chapter_body", "continuity"} {
			t.Run(path+"/"+action, func(t *testing.T) {
				var wire []byte
				server := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
					wire, _ = io.ReadAll(request.Body)
					writer.Header().Set("Content-Type", "application/json")
					fmt.Fprint(writer, `{}`)
				}))
				defer server.Close()
				power := botmodel.Power{Name: "故事", Kind: "text", OutputType: botmodel.OutputTypeStory}
				request := &botprotocol.ShemicRequest{WritingAction: action, Input: map[string]any{"prompt": "写一个故事"}, Options: map[string]any{"stream": true}}
				if err := preparePowerRequest(request, power); err != nil {
					t.Fatal(err)
				}
				native, err := (adapters.OpenAIAdapter{}).BuildNativeRequest(botprotocol.NativeInput{Request: request, Power: power, Provider: botmodel.Provider{Host: server.URL}, Service: botmodel.Service{Path: path}, ServiceAPI: "test-model"})
				if err != nil {
					t.Fatal(err)
				}
				if _, err := botprovider.NewHTTPClient(time.Second).Do(context.Background(), native); err != nil {
					t.Fatal(err)
				}
				var body map[string]any
				if err := json.Unmarshal(wire, &body); err != nil {
					t.Fatal(err)
				}
				function := body["tools"].([]any)[0].(map[string]any)["function"].(map[string]any)
				if function["strict"] != true || function["name"] != "submit_output" || body["parallel_tool_calls"] != false || body["stream"] != true {
					t.Fatal("native HTTP request lost strict tool, streaming or serial tool invocation")
				}
				if body["tool_choice"].(map[string]any)["function"].(map[string]any)["name"] != "submit_output" {
					t.Fatal("forced tool choice lost")
				}
				contract, _ := writingOutputContract(powerOutputContractContext{WritingAction: action})
				canonical, _ := json.Marshal(contract.Schema)
				var wanted map[string]any
				_ = json.Unmarshal(canonical, &wanted)
				if !reflect.DeepEqual(wanted, function["parameters"]) {
					t.Fatal("ordered serialization changed schema validation semantics")
				}
				if action == "planning_background" {
					assertWritingWireOrder(t, string(wire), []string{"world", "locations", "props"})
				}
				if action == "continuity" {
					assertWritingWireOrder(t, string(wire), []string{"synopsis", "end_state", "facts", "character_changes", "threads", "findings"})
				}
				if action == "generate_chapters" || action == "append" {
					assertWritingWireOrder(t, string(wire), []string{"id", "unit_type", "title", "plan", "children"})
				}
			})
		}
	}
}

func assertWritingWireOrder(t *testing.T, raw string, keys []string) {
	t.Helper()
	position := -1
	for _, key := range keys {
		next := strings.Index(raw, `"`+key+`":`)
		if next <= position {
			t.Fatalf("schema property %s arrived out of narrative order", key)
		}
		position = next
	}
}

func TestWritingReliabilityNonWritingToolUnchanged(t *testing.T) {
	contract, err := storyboardOutputContract(powerOutputContractContext{})
	if err != nil {
		t.Fatal(err)
	}
	request := &botprotocol.ShemicRequest{}
	applyPowerOutputTool(request, contract)
	tool := request.Options["tools"].([]any)[0].(map[string]any)["function"].(map[string]any)
	if contract.Strict || tool["strict"] != nil {
		t.Fatal("writing strict mode escaped into storyboard")
	}
	if _, plain := tool["parameters"].(map[string]any); !plain {
		t.Fatal("non-writing schema serialization changed")
	}
}

func TestWritingReliabilityMissingChapterFieldsRejected(t *testing.T) {
	request := &botprotocol.ShemicRequest{WritingAction: "generate_chapters"}
	power := botmodel.Power{Name: "故事", Kind: "text", OutputType: botmodel.OutputTypeStory}
	args := `{"units":[{"id":"","plan":"完整章纲","children":[]}]}`
	result, err := normalizePowerOutput(request, power, botprotocol.Output{"tool_calls": botprotocol.ToolCallsValue([]botprotocol.ToolCall{{Name: submitOutputToolName, Arguments: args}})})
	if result != nil || err == nil || !botprotocol.PreventsReplay(err) || !strings.Contains(err.Error(), "result.units[0]") || !strings.Contains(err.Error(), "缺失字段 [title, unit_type]") {
		t.Fatalf("malformed model output was filled, replayed or lost its diagnosis: %v", err)
	}
}

func TestWritingReliabilityPlanningScopeIsExplicit(t *testing.T) {
	full, _ := writingOutputContract(powerOutputContractContext{WritingAction: "planning_direction"})
	section, _ := writingOutputContract(powerOutputContractContext{WritingAction: "outline_section"})
	if !strings.Contains(full.Prompt, "只写一份") || !strings.Contains(section.Prompt, "仅修改 section_id 指定的大纲文字区块") {
		t.Fatal("phase and local edit scopes diverged")
	}
}

func TestWritingReliabilityActiveFieldFollowsArgumentOrder(t *testing.T) {
	for _, example := range []struct{ raw, active, text string }{
		{``, "", ""},
		{`{"outline":{"overview":"开端","world":"因果推进`, "outline.world", "因果推进"},
		{`{"outline":{"overview":"开端","characters":[{"id":"保密","name":"人物","description":"成长`, "outline.characters.0.description", "成长"},
		{`{"outline":{"world":"环境","locations":[{"name":"街道","description":"作用"}],"props":[]}}`, "outline.locations.0.description", "作用"},
		{`{"outline":{"world":"环境","characters":[{"name":"人物"}],"overview":"最后写的开端"}}`, "outline.overview", "最后写的开端"},
		{`{"units":[{"title":"第一章","plan":"先写这一章"},{"title":"第二章","plan":"`, "units.1.title", "第二章"},
		{`{"body":"文字","synopsis":"隐藏","ending":"隐藏"}`, "body", "文字"},
		{`{"replacement":"修改\uD83D`, "replacement", "修改"},
		{`{"replacement":"修改\uD83D\uDE00`, "replacement", "修改😀"},
		{`{"replacement":"换行\n下一行\`, "replacement", "换行\n下一行"},
	} {
		fields, _, active := writingPartialFields(example.raw)
		if active != example.active || fields[active] != example.text {
			t.Fatalf("raw %q: active=%q, fields=%v", example.raw, active, fields)
		}
	}
	complete := `{"outline":{"overview":"开端😀","characters":[{"id":"人物ID","name":"林澈","description":"成长"}],"world":"现代城市","locations":[{"name":"街道","description":"故事发生地"}],"props":[]}}`
	for end := 0; end <= len(complete); end++ {
		fields, _, active := writingPartialFields(complete[:end])
		if active != "" && fields[active] == "" {
			t.Fatalf("byte %d: activity points to an unreadable field", end)
		}
		for _, value := range fields {
			if !utf8.ValidString(value) || strings.ContainsRune(value, utf8.RuneError) {
				t.Fatalf("byte %d: incomplete unicode leaked", end)
			}
		}
	}
	var units []string
	for index := 0; index < 11; index++ {
		units = append(units, fmt.Sprintf(`{"title":"第%d章","plan":"计划%d"}`, index+1, index+1))
	}
	fields, _, active := writingPartialFields(`{"units":[` + strings.Join(units, ",") + `]}`)
	if active != "units.10.plan" || fields[active] != "计划11" {
		t.Fatalf("chapter ten transition followed lexical map order: %s", active)
	}
}

func TestWritingReliabilityPreviewCarriesActiveField(t *testing.T) {
	progress := powerOutputStreamProgress{outputType: "story", previewDirty: true}
	progress.calls.Append([]botprotocol.ToolCall{{Index: 0, Name: submitOutputToolName, Arguments: `{"outline":{"world":"环境","overview":"实际正在写的开端`}})
	output, ok := progress.writingPreview(true)
	if !ok {
		t.Fatal("valid readable preview not published")
	}
	preview := output["meta"].(map[string]any)["writing_preview"].(map[string]any)
	if preview["active_field"] != "outline.overview" || preview["fields"].(map[string]string)["outline.overview"] != "实际正在写的开端" {
		t.Fatalf("activity lost in provider preview: %#v", preview)
	}
	if _, duplicate := progress.writingPreview(true); duplicate {
		t.Fatal("unchanged preview republished")
	}
}
