package energon

import (
	"strings"
	"testing"

	botmodel "github.com/dever-package/bot/model/energon"
)

func storyboardRelayTestShots(modify func(shots []any)) []any {
	shot := func(id string, materials ...any) map[string]any {
		return map[string]any{
			"id": id, "duration": 4, "beat": "动作", "description": "画面", "video_prompt": "表演",
			"camera_instruction": "固定机位", "start_framing": "中景", "end_framing": "中景",
			"material_ids": materials, "transition_type": "none",
			"continuity_state": map[string]any{"entry": "站在柜台前", "exit": "站在柜台前"},
		}
	}
	shots := []any{
		shot("s1", "owner", "shop"),
		shot("s2", "owner", "shop"),
		shot("s3", "owner", "guest", "shop"),
		shot("s4", "owner", "street"),
	}
	shots[1].(map[string]any)["continue_previous"] = true
	shots[2].(map[string]any)["continue_previous"] = true
	modify(shots)
	return shots
}

func TestStoryboardRelayNormalization(t *testing.T) {
	materialTypes := map[string]string{"owner": "character", "guest": "character", "shop": "scene", "street": "scene"}
	lookup := map[string]string{"owner": "owner", "guest": "guest", "shop": "shop", "street": "street"}
	normalize := func(continuity string, modify func([]any)) []map[string]any {
		contract := storyboardGenerationContract{Continuity: continuity, WorkType: botmodel.StoryboardWorkTypeShort, MinShotDuration: 2, MaxShotDuration: 15}
		shots, err := normalizeStoryboardShots(storyboardRelayTestShots(modify), materialTypes, lookup, contract)
		if err != nil {
			t.Fatal(err)
		}
		rows := make([]map[string]any, len(shots))
		for index, shot := range shots {
			rows[index] = shot.(map[string]any)
		}
		return rows
	}

	relay := normalize(botmodel.StoryboardContinuityRelay, func([]any) {})
	// 同一场戏、没有新人物：接上一镜尾帧，不再生成图片。
	if relay[1]["continue_previous"] != true || relay[1]["shot_image_mode"] != botmodel.StoryboardShotImageFirstFrame {
		t.Fatalf("same scene must relay from the tail frame: %+v", relay[1])
	}
	// 接尾帧的接缝不叠加转场，即使脚本写了也去掉。
	faded := normalize(botmodel.StoryboardContinuityRelay, func(shots []any) {
		shots[1].(map[string]any)["transition_type"] = "fade"
		shots[1].(map[string]any)["transition_duration_ms"] = 500
	})
	if faded[1]["continue_previous"] != true || faded[1]["transition_type"] != botmodel.StoryboardTransitionNone || faded[1]["transition_duration_ms"] != 0 {
		t.Fatalf("a tail-frame seam must not carry a transition: %+v", faded[1])
	}
	// 上一镜画面里没有的人物入画：不能凭空续拍，改为以尾帧为底的硬切。
	if relay[2]["continue_previous"] != false || relay[2]["match_previous"] != true {
		t.Fatalf("a new character must become a tail-frame hard cut: %+v", relay[2])
	}
	// 换场：新首帧，并自动加转场。
	if relay[3]["continue_previous"] != false || relay[3]["match_previous"] != false ||
		relay[3]["transition_type"] != botmodel.StoryboardRelaySceneTransition || relay[3]["transition_duration_ms"] != botmodel.StoryboardRelaySceneTransitionDurationMS {
		t.Fatalf("a scene change must get a new frame and a transition: %+v", relay[3])
	}

	// 人物离开画面仍可接力。
	leaving := normalize(botmodel.StoryboardContinuityRelay, func(shots []any) {
		shots[0].(map[string]any)["material_ids"] = []any{"owner", "guest", "shop"}
	})
	if leaving[1]["continue_previous"] != true {
		t.Fatalf("a character leaving the frame keeps the relay: %+v", leaving[1])
	}
	// 作者写明的换场转场不被覆盖。
	authored := normalize(botmodel.StoryboardContinuityRelay, func(shots []any) {
		shots[3].(map[string]any)["transition_type"] = "fadeblack"
		shots[3].(map[string]any)["transition_duration_ms"] = 800
	})
	if authored[3]["transition_type"] != botmodel.StoryboardTransitionFadeBlack || authored[3]["transition_duration_ms"] != 800 {
		t.Fatalf("authored transition must be kept: %+v", authored[3])
	}

	// 自由分镜保留硬切，不自动加转场。
	free := normalize(botmodel.StoryboardContinuityFree, func([]any) {})
	if free[3]["transition_type"] != botmodel.StoryboardTransitionNone {
		t.Fatalf("free mode keeps authored hard cuts: %+v", free[3])
	}
}

func TestStoryboardRelayIsDefaultExceptMV(t *testing.T) {
	for _, scenario := range []struct{ workType, chosen, want string }{
		{botmodel.StoryboardWorkTypeShort, "", botmodel.StoryboardContinuityRelay},
		{botmodel.StoryboardWorkTypeNarrative, "free", botmodel.StoryboardContinuityFree},
		{botmodel.StoryboardWorkTypeMV, "", botmodel.StoryboardContinuityFree},
		{botmodel.StoryboardWorkTypeMV, "relay", botmodel.StoryboardContinuityRelay},
	} {
		input := map[string]any{"storyboard_work_type": scenario.workType, botmodel.StoryboardMinShotDurationKey: botmodel.StoryboardDefaultMinShotDuration}
		if scenario.chosen != "" {
			input[botmodel.StoryboardContinuityInputKey] = scenario.chosen
		}
		contract, err := storyboardGenerationContractForRequest(input, 0)
		if err != nil {
			t.Fatal(err)
		}
		prompt, err := storyboardOutputPrompt(contract)
		if err != nil {
			t.Fatal(err)
		}
		if contract.Continuity != scenario.want || strings.Contains(prompt, "本次镜头衔接方式：接力") != (scenario.want == botmodel.StoryboardContinuityRelay) {
			t.Fatalf("%s/%q: continuity=%s", scenario.workType, scenario.chosen, contract.Continuity)
		}
	}
	if _, err := storyboardGenerationContractForRequest(map[string]any{"storyboard_work_type": botmodel.StoryboardWorkTypeShort, botmodel.StoryboardMinShotDurationKey: botmodel.StoryboardDefaultMinShotDuration, botmodel.StoryboardContinuityInputKey: "loop"}, 0); err == nil {
		t.Fatal("an unknown continuity must be rejected")
	}
}
